<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000011"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000010"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Bait</string><ProtectedString name="Source"><![CDATA[-- Bait goes on the hook before each cast. A fish that bites eats it, whether
-- you land the fish or not. Bait is bought with coins or made from fish you
-- caught, never sold for Robux.
--
-- biteSpeed: multiplies the wait for a bite (lower is faster)
-- luck: multiplies the chance of Rare and better fish
-- legendary: multiplies the chance of Legendary and Mythic fish
-- shiny: multiplies the chance of a Shiny fish
-- price/buyAmount: coins for a pack at the Bait & Tackle shop (no price = can't buy)
-- recipe: fish (by rarity) traded in to make craftAmount bait

local Bait = {}

Bait.List = {
	{
		id = "bread",
		name = "Bread",
		free = true,
		color = Color3.fromRGB(230, 200, 140),
		description = "Free and endless. No bonus.",
	},
	{
		id = "worms",
		name = "Worms",
		price = 150,
		buyAmount = 10,
		biteSpeed = 0.7,
		color = Color3.fromRGB(220, 120, 130),
		description = "Fish bite 30% sooner.",
	},
	{
		id = "shrimp",
		name = "Shrimp",
		price = 400,
		buyAmount = 5,
		luck = 1.35,
		recipe = { { rarity = "Common", count = 3 } },
		craftAmount = 2,
		color = Color3.fromRGB(255, 150, 100),
		description = "Rare and better fish 35% more likely.",
	},
	{
		id = "glow_lure",
		name = "Glow Lure",
		luck = 1.7,
		shiny = 2,
		recipe = { { rarity = "Uncommon", count = 2 }, { rarity = "Rare", count = 1 } },
		craftAmount = 3,
		color = Color3.fromRGB(120, 255, 220),
		description = "Rare+ fish 70% more likely, Shiny fish twice as likely. Craft only.",
	},
	{
		id = "legend_chum",
		name = "Legend Chum",
		legendary = 2.5,
		biteSpeed = 0.85,
		recipe = { { rarity = "Rare", count = 3 }, { rarity = "Epic", count = 1 } },
		craftAmount = 2,
		color = Color3.fromRGB(255, 180, 40),
		description = "Legendary and Mythic fish 2.5x as likely. Craft only.",
	},
}

Bait.ById = {}
for index, bait in ipairs(Bait.List) do
	bait.order = index
	Bait.ById[bait.id] = bait
end

Bait.Default = "bread"

return Bait
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Bounties</string><ProtectedString name="Source"><![CDATA[-- Old Pete's daily bounties: three fish requests per player per day.
-- Turning one in pays three times what the market would, plus bait.

local Fish = require(script.Parent.Fish)
local Zones = require(script.Parent.Zones)

local Bounties = {}

Bounties.RewardMultiplier = 3

-- { rarity, count range, bait reward }
local SLOTS = {
	{ rarity = "Common", count = { 3, 5 }, bait = "worms", baitAmount = 5 },
	{ rarity = "Uncommon", count = { 2, 3 }, bait = "shrimp", baitAmount = 3 },
	{ rarity = "Rare", count = { 1, 1 }, bait = "glow_lure", baitAmount = 2 },
}

function Bounties.Today(now)
	return math.floor(now / 86400)
end

-- Makes the day's bounties from the zones the player has unlocked
function Bounties.Generate(userId, day, unlockedZones)
	local random = Random.new(userId % 1000003 * 977 + day)
	local list = {}
	for _, slot in ipairs(SLOTS) do
		local pool = {}
		for _, zone in ipairs(Zones.List) do
			if unlockedZones[zone.id] then
				for _, fish in ipairs(Fish.ByZone[zone.id] or {}) do
					if fish.rarity == slot.rarity then
						table.insert(pool, fish)
					end
				end
			end
		end
		if #pool > 0 then
			local fish = pool[random:NextInteger(1, #pool)]
			table.insert(list, {
				fishId = fish.id,
				count = random:NextInteger(slot.count[1], slot.count[2]),
				bait = slot.bait,
				baitAmount = slot.baitAmount,
				done = false,
			})
		end
	end
	return list
end

-- Coins paid for a bounty
function Bounties.Reward(bounty, sellMultiplier)
	local fish = Fish.ById[bounty.fishId]
	return math.floor(fish.value * bounty.count * Bounties.RewardMultiplier * sellMultiplier)
end

return Bounties
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- General game settings. Change numbers here to rebalance the game.

local Config = {}

Config.GameName = "Dig Legends"

-- Saving
Config.DataStoreName = "PlayerData_v1"
Config.LeaderboardStoreName = "TotalCaught_v1"
Config.AutosaveSeconds = 120

-- Fish bag
Config.BagSize = 20
Config.BigBagSize = 60 -- with the Big Bag pass

-- Fishing
Config.MaxCastDistance = 80 -- studs from the player to the bobber
Config.BiteWaitMin = 3.5 -- seconds, before rod speed bonus
Config.BiteWaitMax = 8
Config.NibblesMax = 3 -- fake nibbles before the real bite (striking on one scares the fish)
Config.HookGrace = 0.35 -- extra seconds allowed on the server for internet lag
Config.CastCooldown = 1
Config.ShinyChance = 1 / 100
Config.ShinyValueMultiplier = 3

-- Rebirth: cost = RebirthBaseCost * RebirthCostGrowth ^ rebirths
Config.RebirthBaseCost = 1000000
Config.RebirthCostGrowth = 3
Config.RebirthSellBonus = 0.25 -- +25% coins from selling per rebirth
Config.RebirthRequiresZone = "frostbite"

-- Daily login reward: DailyRewardBase * streak day (streak capped at 7)
Config.DailyRewardBase = 100
Config.DailyStreakCap = 7

-- Fish Market
Config.MarketSeconds = 30 * 60 -- how often the "in demand" fish change
Config.StationRange = 25 -- how close you must be to the market / bait shop to use it

-- Set to true to try every game pass for free while testing in Roblox Studio.
-- Has no effect in the live game.
Config.TestPassesInStudio = false

-- How long each weather lasts, in seconds
Config.WeatherSeconds = 15 * 60

function Config.RebirthCost(rebirths)
	return math.floor(Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths)
end

function Config.SellMultiplier(rebirths)
	return 1 + Config.RebirthSellBonus * rebirths
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[-- Weekly legendary fish and rotating weather. Both are worked out from the
-- clock, so every server (and every player's screen) agrees without talking.

local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Config)
local Fish = require(script.Parent.Fish)

local Events = {}

local WEEK = 7 * 24 * 60 * 60
local MONDAY_OFFSET = 4 * 24 * 60 * 60 -- 1 Jan 1970 was a Thursday; weeks start Monday 00:00 UTC

-- Weather is free for everyone and only gives small, temporary boosts.
Events.Weathers = {
	{ id = "Clear", name = "Clear Skies", description = "A calm day on the water." },
	{ id = "Rain", name = "Rain", description = "Fish bite 20% faster.", biteMultiplier = 0.8 },
	{ id = "Fog", name = "Fog", description = "Rare and better fish are 20% more likely.", luckMultiplier = 1.2 },
	{ id = "Storm", name = "Storm", description = "Legendary and Mythic fish are twice as likely.", legendaryMultiplier = 2 },
	{ id = "GoldenHour", name = "Golden Hour", description = "Shiny fish are twice as likely.", shinyMultiplier = 2 },
}

function Events.Now()
	return Workspace:GetServerTimeNow()
end

function Events.GetWeek(now)
	now = now or Events.Now()
	local week = math.floor((now - MONDAY_OFFSET) / WEEK)
	local secondsLeft = WEEK - ((now - MONDAY_OFFSET) % WEEK)
	return week, secondsLeft
end

-- The legendary fish featured this week.
function Events.GetEventFish(now)
	local week, secondsLeft = Events.GetWeek(now)
	local fish = Fish.EventFish[(week % #Fish.EventFish) + 1]
	return fish, secondsLeft
end

function Events.GetWeather(now)
	now = now or Events.Now()
	local slot = math.floor(now / Config.WeatherSeconds)
	local secondsLeft = Config.WeatherSeconds - (now % Config.WeatherSeconds)
	-- Clear weather half the time, a random special weather otherwise
	local roll = Random.new(slot):NextInteger(1, (#Events.Weathers - 1) * 2)
	local weather = Events.Weathers[1]
	if roll < #Events.Weathers then
		weather = Events.Weathers[roll + 1]
	end
	return weather, secondsLeft
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Fight</string><ProtectedString name="Source"><![CDATA[-- The reeling fight, shared by server and player so both agree on the rules.
--
-- Hold to reel: the catch bar fills, but line tension rises.
-- Let go: tension drops, but the fish pulls the catch bar back.
-- Every few seconds the fish thrashes (with a short warning first). Still reeling
-- when it starts jolts the line, and reeling during a thrash barely helps.
-- Catch bar full = caught. Tension full = line snaps. Catch bar empty = it got away.

local Fight = {}

Fight.StartProgress = 0.25
Fight.TensionUp = 0.42 -- per second while reeling (before rod control)
Fight.ThrashTension = 1.1 -- extra per second while reeling during a thrash, times strength
Fight.ThrashJolt = 0.3 -- instant tension if you are still reeling when a thrash starts (weak fish jolt less)
Fight.TensionDown = 0.7 -- per second while not reeling
Fight.PullBack = 0.03 -- catch bar lost per second while not reeling, times strength
Fight.ThrashPullBack = 0.07 -- same, during a thrash
Fight.ThrashReelFactor = 0.3 -- reeling speed during a thrash
Fight.WarningSeconds = 0.45
Fight.MaxSeconds = 120

function Fight.Params(rarity, rod)
	local control = rod and rod.control or 0
	return {
		rarity = rarity.id,
		strength = rarity.strength,
		gain = rarity.reel * (1 + control * 2),
		tensionUp = Fight.TensionUp * (1 - control),
		calm = { 1.3 / math.sqrt(rarity.strength), 3.4 / math.sqrt(rarity.strength) },
		thrash = { 0.6 * math.sqrt(rarity.strength), 1.3 * math.sqrt(rarity.strength) },
	}
end

-- The quickest a perfect player could possibly land this fish
function Fight.MinSeconds(params)
	return (1 - Fight.StartProgress) / params.gain
end

-- Advance the fight by dt. state = { progress, tension, phase, phaseLeft, reeling }
-- phase is "calm", "warning" or "thrash". random is a Random object.
function Fight.Step(state, params, dt, random)
	state.phaseLeft -= dt
	if state.phaseLeft <= 0 then
		if state.phase == "calm" then
			state.phase = "warning"
			state.phaseLeft = Fight.WarningSeconds
		elseif state.phase == "warning" then
			state.phase = "thrash"
			state.phaseLeft = random:NextNumber(params.thrash[1], params.thrash[2])
			if state.reeling then
				state.tension += Fight.ThrashJolt * (params.strength - 0.4)
			end
		else
			state.phase = "calm"
			state.phaseLeft = random:NextNumber(params.calm[1], params.calm[2])
		end
	end

	local thrashing = state.phase == "thrash"
	if state.reeling then
		local gain = params.gain * (thrashing and Fight.ThrashReelFactor or 1)
		state.progress += gain * dt
		state.tension += (params.tensionUp + (thrashing and Fight.ThrashTension * params.strength or 0)) * dt
	else
		local pull = thrashing and Fight.ThrashPullBack or Fight.PullBack
		state.progress -= pull * params.strength * dt
		state.tension -= Fight.TensionDown * dt
	end
	state.tension = math.max(0, state.tension)

	if state.progress >= 1 then
		return "caught"
	elseif state.tension >= 1 then
		return "snapped"
	elseif state.progress <= 0 then
		return "escaped"
	end
	return nil
end

function Fight.NewState(params, random)
	return {
		progress = Fight.StartProgress,
		tension = 0,
		phase = "calm",
		phaseLeft = random:NextNumber(params.calm[1], params.calm[2]),
		reeling = false,
	}
end

return Fight
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Fish</string><ProtectedString name="Source"><![CDATA[-- Every fish in the game. To add a fish, copy a line and give it a new unique id.
-- value = coins for an average-weight fish. weight = {min, max} in kg.

local Fish = {}

-- hookWindow: seconds to strike after the real bite
-- reel: how fast the catch bar fills while reeling (per second)
-- strength: how hard the fish fights (thrash length, line tension, pull-back)
Fish.Rarities = {
	{ id = "Common", weight = 60, color = Color3.fromRGB(200, 200, 200), hookWindow = 1.0, reel = 0.3, strength = 0.8 },
	{ id = "Uncommon", weight = 25, color = Color3.fromRGB(90, 200, 90), hookWindow = 0.9, reel = 0.24, strength = 1.0 },
	{ id = "Rare", weight = 10, color = Color3.fromRGB(70, 140, 255), hookWindow = 0.8, reel = 0.19, strength = 1.25 },
	{ id = "Epic", weight = 4, color = Color3.fromRGB(170, 80, 255), hookWindow = 0.7, reel = 0.15, strength = 1.5 },
	{ id = "Legendary", weight = 0.9, color = Color3.fromRGB(255, 170, 0), hookWindow = 0.6, reel = 0.14, strength = 1.7 },
	{ id = "Mythic", weight = 0.1, color = Color3.fromRGB(255, 60, 120), hookWindow = 0.55, reel = 0.12, strength = 1.95 },
}

Fish.RarityById = {}
for index, rarity in ipairs(Fish.Rarities) do
	rarity.order = index
	Fish.RarityById[rarity.id] = rarity
end

-- event = true: only catchable during its weekly event (see Events.luau)
Fish.List = {
	-- Sunny Shallows
	{ id = "sunny_minnow", name = "Sunny Minnow", zone = "shallows", rarity = "Common", value = 5, weight = { 0.1, 0.4 } },
	{ id = "pebble_perch", name = "Pebble Perch", zone = "shallows", rarity = "Common", value = 7, weight = { 0.3, 1.2 } },
	{ id = "sandy_sardine", name = "Sandy Sardine", zone = "shallows", rarity = "Common", value = 6, weight = { 0.1, 0.3 } },
	{ id = "bluegill_buddy", name = "Bluegill Buddy", zone = "shallows", rarity = "Common", value = 8, weight = { 0.2, 0.8 } },
	{ id = "coral_snapper", name = "Coral Snapper", zone = "shallows", rarity = "Uncommon", value = 20, weight = { 1, 4 } },
	{ id = "striped_bass", name = "Striped Bass", zone = "shallows", rarity = "Uncommon", value = 24, weight = { 2, 6 } },
	{ id = "puffer_pal", name = "Puffer Pal", zone = "shallows", rarity = "Uncommon", value = 28, weight = { 0.5, 2 } },
	{ id = "rainbow_trout", name = "Rainbow Trout", zone = "shallows", rarity = "Rare", value = 60, weight = { 1, 5 } },
	{ id = "lemon_ray", name = "Lemon Ray", zone = "shallows", rarity = "Rare", value = 75, weight = { 3, 12 } },
	{ id = "glimmer_koi", name = "Glimmer Koi", zone = "shallows", rarity = "Epic", value = 200, weight = { 2, 8 } },
	{ id = "seahorse_knight", name = "Seahorse Knight", zone = "shallows", rarity = "Epic", value = 240, weight = { 0.2, 1 } },
	{ id = "sunfin_emperor", name = "Sunfin Emperor", zone = "shallows", rarity = "Legendary", value = 1200, weight = { 20, 60 } },
	{ id = "golden_guppy_king", name = "Golden Guppy King", zone = "shallows", rarity = "Mythic", value = 6000, weight = { 1, 3 } },

	-- Misty Mangroves
	{ id = "mud_skipper", name = "Mud Skipper", zone = "mangroves", rarity = "Common", value = 25, weight = { 0.2, 0.6 } },
	{ id = "swamp_catfish", name = "Swamp Catfish", zone = "mangroves", rarity = "Common", value = 30, weight = { 2, 8 } },
	{ id = "reed_eel", name = "Reed Eel", zone = "mangroves", rarity = "Common", value = 35, weight = { 1, 3 } },
	{ id = "bog_tilapia", name = "Bog Tilapia", zone = "mangroves", rarity = "Common", value = 28, weight = { 0.5, 2 } },
	{ id = "moss_pike", name = "Moss Pike", zone = "mangroves", rarity = "Uncommon", value = 90, weight = { 3, 10 } },
	{ id = "lantern_gar", name = "Lantern Gar", zone = "mangroves", rarity = "Uncommon", value = 110, weight = { 4, 12 } },
	{ id = "root_crab", name = "Root Crab", zone = "mangroves", rarity = "Uncommon", value = 100, weight = { 0.5, 2 } },
	{ id = "mist_piranha", name = "Mist Piranha", zone = "mangroves", rarity = "Rare", value = 280, weight = { 0.5, 3 } },
	{ id = "jade_arowana", name = "Jade Arowana", zone = "mangroves", rarity = "Rare", value = 330, weight = { 2, 7 } },
	{ id = "ghost_barracuda", name = "Ghost Barracuda", zone = "mangroves", rarity = "Epic", value = 900, weight = { 8, 25 } },
	{ id = "bayou_gator_gar", name = "Bayou Gator Gar", zone = "mangroves", rarity = "Epic", value = 1100, weight = { 30, 90 } },
	{ id = "willow_wyrm", name = "Willow Wyrm", zone = "mangroves", rarity = "Legendary", value = 5000, weight = { 50, 150 } },
	{ id = "ancient_turtle", name = "Ancient Mangrove Turtle", zone = "mangroves", rarity = "Mythic", value = 25000, weight = { 100, 300 } },

	-- Frostbite Bay
	{ id = "ice_cod", name = "Ice Cod", zone = "frostbite", rarity = "Common", value = 110, weight = { 1, 5 } },
	{ id = "frost_herring", name = "Frost Herring", zone = "frostbite", rarity = "Common", value = 120, weight = { 0.2, 0.8 } },
	{ id = "snowball_smelt", name = "Snowball Smelt", zone = "frostbite", rarity = "Common", value = 100, weight = { 0.1, 0.4 } },
	{ id = "polar_pollock", name = "Polar Pollock", zone = "frostbite", rarity = "Common", value = 130, weight = { 1, 4 } },
	{ id = "glacier_salmon", name = "Glacier Salmon", zone = "frostbite", rarity = "Uncommon", value = 380, weight = { 3, 10 } },
	{ id = "arctic_char", name = "Arctic Char", zone = "frostbite", rarity = "Uncommon", value = 420, weight = { 2, 8 } },
	{ id = "crystal_crab", name = "Crystal Crab", zone = "frostbite", rarity = "Uncommon", value = 450, weight = { 1, 4 } },
	{ id = "aurora_halibut", name = "Aurora Halibut", zone = "frostbite", rarity = "Rare", value = 1200, weight = { 10, 40 } },
	{ id = "narwhal_pup", name = "Narwhal Pup", zone = "frostbite", rarity = "Rare", value = 1400, weight = { 40, 120 } },
	{ id = "blizzard_marlin", name = "Blizzard Marlin", zone = "frostbite", rarity = "Epic", value = 4000, weight = { 60, 200 } },
	{ id = "frozen_angler", name = "Frozen Angler", zone = "frostbite", rarity = "Epic", value = 4500, weight = { 5, 20 } },
	{ id = "yeti_whale", name = "Yeti Whale", zone = "frostbite", rarity = "Legendary", value = 20000, weight = { 500, 1500 } },
	{ id = "frostbite_kraken", name = "Frostbite Kraken", zone = "frostbite", rarity = "Mythic", value = 100000, weight = { 800, 2500 } },

	-- Weekly event legendaries (one per week, rotating)
	{ id = "moonscale_leviathan", name = "Moonscale Leviathan", zone = "shallows", rarity = "Legendary", value = 3000, weight = { 80, 200 }, event = true },
	{ id = "thunderjaw_shark", name = "Thunderjaw Shark", zone = "mangroves", rarity = "Legendary", value = 12000, weight = { 150, 400 }, event = true },
	{ id = "prism_manta", name = "Prism Manta", zone = "frostbite", rarity = "Legendary", value = 45000, weight = { 200, 600 }, event = true },
	{ id = "starfall_sturgeon", name = "Starfall Sturgeon", zone = "mangroves", rarity = "Legendary", value = 15000, weight = { 100, 300 }, event = true },
}

Fish.ById = {}
Fish.ByZone = {} -- regular (non-event) fish per zone
Fish.EventFish = {}
for _, fish in ipairs(Fish.List) do
	assert(Fish.ById[fish.id] == nil, "Duplicate fish id: " .. fish.id)
	Fish.ById[fish.id] = fish
	if fish.event then
		table.insert(Fish.EventFish, fish)
	else
		Fish.ByZone[fish.zone] = Fish.ByZone[fish.zone] or {}
		table.insert(Fish.ByZone[fish.zone], fish)
	end
end

return Fish
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">FishModel</string><ProtectedString name="Source"><![CDATA[-- Builds a simple 3D fish out of parts. Used when a player holds up a catch
-- and for the fish that jump out of the water.

local Fish = require(script.Parent.Fish)

local FishModel = {}

-- Each fish gets its own color from its id, tinted by rarity
local function colorFor(fish)
	local hash = 0
	for i = 1, #fish.id do
		hash = (hash * 31 + string.byte(fish.id, i)) % 360
	end
	local base = Color3.fromHSV(hash / 360, 0.55, 0.95)
	local rarity = Fish.RarityById[fish.rarity]
	return base:Lerp(rarity.color, 0.35)
end
FishModel.ColorFor = colorFor

-- Length in studs for a fish of this weight (kg)
function FishModel.LengthFor(weight)
	return math.clamp(1.2 + math.log(weight + 1) * 0.55, 1.2, 6)
end

local function piece(model, name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Returns a Model whose PrimaryPart ("Body") faces along -Z (its LookVector)
function FishModel.Build(fishId, weight, shiny)
	local fish = Fish.ById[fishId]
	if not fish then
		return nil
	end
	local length = FishModel.LengthFor(weight or 1)
	local color = colorFor(fish)
	local material = shiny and Enum.Material.Neon or Enum.Material.SmoothPlastic

	local model = Instance.new("Model")
	model.Name = "Fish_" .. fish.id

	local body = piece(model, "Body", Vector3.new(length * 0.35, length * 0.45, length), color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	model.PrimaryPart = body

	local tail = piece(model, "Tail", Vector3.new(length * 0.05, length * 0.45, length * 0.32), color:Lerp(Color3.new(0, 0, 0), 0.15), material)
	tail.CFrame = body.CFrame * CFrame.new(0, 0, length * 0.58) * CFrame.Angles(math.rad(45), 0, 0)
	weld(body, tail)

	local fin = piece(model, "Fin", Vector3.new(length * 0.04, length * 0.22, length * 0.3), color:Lerp(Color3.new(1, 1, 1), 0.2), material)
	fin.CFrame = body.CFrame * CFrame.new(0, length * 0.24, 0.05 * length) * CFrame.Angles(math.rad(-20), 0, 0)
	weld(body, fin)

	for _, side in ipairs({ -1, 1 }) do
		local eye = piece(model, "Eye", Vector3.one * length * 0.08, Color3.new(0.05, 0.05, 0.05), Enum.Material.SmoothPlastic)
		eye.Shape = Enum.PartType.Ball
		eye.CFrame = body.CFrame * CFrame.new(side * length * 0.15, length * 0.07, -length * 0.36)
		weld(body, eye)
	end

	if shiny then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 240, 150)
		sparkles.Parent = body
	end
	return model
end

return FishModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Small helpers for showing numbers and times.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Number(n)
	n = math.floor(n or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local index = 1
	local value = n
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index += 1
	end
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. SUFFIXES[index]
end

-- 3725 -> "1h 2m", 95 -> "1m 35s"
function Format.Duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if days > 0 then
		return string.format("%dd %dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

function Format.Weight(kg)
	if kg >= 100 then
		return string.format("%d kg", math.floor(kg))
	end
	return string.format("%.1f kg", kg)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Level</string><ProtectedString name="Source"><![CDATA[-- Angler level. Every catch gives XP (more for rarer fish and new species).
-- Your level shows above your head and pays a coin reward each time it goes up.

local Fish = require(script.Parent.Fish)

local Level = {}

Level.XpByRarity = {
	Common = 5,
	Uncommon = 10,
	Rare = 25,
	Epic = 60,
	Legendary = 150,
	Mythic = 400,
}
Level.NewSpeciesBonus = 25
Level.CoinsPerLevel = 150 -- reward for reaching level N is N * this

-- Total XP needed to reach a level (level 1 needs 0)
function Level.XpFor(level)
	return math.floor(40 * (level - 1) ^ 1.6)
end

function Level.FromXp(xp)
	local level = 1
	while Level.XpFor(level + 1) <= xp do
		level += 1
	end
	return level
end

-- How far through the current level, from 0 to 1
function Level.Progress(xp)
	local level = Level.FromXp(xp)
	local from, to = Level.XpFor(level), Level.XpFor(level + 1)
	return (xp - from) / (to - from), level
end

function Level.XpForCatch(fishId, isNew)
	local fish = Fish.ById[fishId]
	local xp = Level.XpByRarity[fish.rarity] or 5
	if isNew then
		xp += Level.NewSpeciesBonus
	end
	return xp
end

return Level
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Market</string><ProtectedString name="Source"><![CDATA[-- Fish Market prices. Every 30 minutes one fish per zone is "in demand" and
-- sells for double, so holding on to the right fish can pay off.

local Config = require(script.Parent.Config)
local Fish = require(script.Parent.Fish)
local Zones = require(script.Parent.Zones)
local Events = require(script.Parent.Events)

local Market = {}

Market.HotMultiplier = 2

-- Returns { [fishId] = true } for the fish in demand right now, and seconds left
function Market.HotFish(now)
	now = now or Events.Now()
	local slot = math.floor(now / Config.MarketSeconds)
	local secondsLeft = Config.MarketSeconds - (now % Config.MarketSeconds)
	local random = Random.new(slot * 31 + 7)
	local hot = {}
	for _, zone in ipairs(Zones.List) do
		local pool = {}
		for _, fish in ipairs(Fish.ByZone[zone.id] or {}) do
			if fish.rarity ~= "Common" then
				table.insert(pool, fish)
			end
		end
		if #pool > 0 then
			hot[pool[random:NextInteger(1, #pool)].id] = true
		end
	end
	return hot, secondsLeft
end

-- Coins for one fish from the bag, right now
function Market.Price(entry, rebirths, hot)
	hot = hot or Market.HotFish()
	local price = entry.value * Config.SellMultiplier(rebirths)
	if hot[entry.id] then
		price *= Market.HotMultiplier
	end
	return math.floor(price)
end

return Market
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- All the messages between server and players. The server creates them;
-- players wait for them to appear.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"DataUpdate", -- server -> player: the player's full save data
	"Notify", -- server -> player: a toast message
	"OpenPanel", -- server -> player: open a menu (e.g. the rod shop)
	"CancelCast", -- player -> server: stop fishing
	"Nibble", -- server -> player: a fish is nibbling (don't strike yet!)
	"Bite", -- server -> player: the real bite, strike now
	"Hook", -- player -> server: the player struck
	"Fight", -- server -> player: the fish is hooked, start the reeling fight
	"Reel", -- player -> server: how the fight ended
	"CatchResult", -- server -> player: what was caught, or why it got away
}

local FUNCTIONS = {
	"Action", -- player -> server: buy rod, unlock zone, rebirth, teleport, equip...
	"Cast", -- player -> server: cast at a position, returns the cast id if the bobber landed
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Rods</string><ProtectedString name="Source"><![CDATA[-- Rods are bought with in-game coins only (never Robux).
-- luck: multiplies the chance of Rare and better fish
-- speed: multiplies the wait for a bite (lower is faster)
-- control: reel faster with less line tension during the fight

local Rods = {}

Rods.List = {
	{ id = "twig", name = "Twig Rod", price = 0, luck = 1.0, speed = 1.0, control = 0.0, color = Color3.fromRGB(140, 100, 60) },
	{ id = "bamboo", name = "Bamboo Rod", price = 400, luck = 1.1, speed = 0.95, control = 0.02, color = Color3.fromRGB(190, 180, 90) },
	{ id = "fiberglass", name = "Fiberglass Rod", price = 2000, luck = 1.2, speed = 0.9, control = 0.04, color = Color3.fromRGB(230, 230, 230) },
	{ id = "carbon", name = "Carbon Rod", price = 8000, luck = 1.35, speed = 0.85, control = 0.06, color = Color3.fromRGB(40, 40, 45) },
	{ id = "mangrove", name = "Mangrove Rod", price = 30000, luck = 1.5, speed = 0.8, control = 0.08, color = Color3.fromRGB(70, 120, 60) },
	{ id = "glacier", name = "Glacier Rod", price = 120000, luck = 1.75, speed = 0.72, control = 0.1, color = Color3.fromRGB(150, 220, 255) },
	{ id = "aurora", name = "Aurora Rod", price = 450000, luck = 2.0, speed = 0.65, control = 0.12, color = Color3.fromRGB(120, 255, 200) },
	{ id = "leviathan", name = "Leviathan Rod", price = 1500000, luck = 2.5, speed = 0.55, control = 0.15, color = Color3.fromRGB(60, 40, 140), requiresRebirths = 1 },
}

Rods.ById = {}
for index, rod in ipairs(Rods.List) do
	rod.order = index
	Rods.ById[rod.id] = rod
end

Rods.Default = "twig"

return Rods
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Everything sold for Robux. Nothing here changes what you dig up or how
-- many coins you earn: only looks and time-savers.
--
-- HOW TO FILL IN THE IDS (see docs/SETUP_GUIDE.md, step 5):
--   Game passes: Creator Dashboard > your game > Monetization > Passes
--   Cosmetics:   Creator Dashboard > your game > Monetization > Developer Products
-- An id of 0 means "not set up yet": the item shows as "Coming soon" in the shop.

local Shop = {}

Shop.Passes = {
	{ id = "VIP", gamePassId = 0, name = "VIP", suggestedPrice = 250, description = "Golden VIP name tag, a crown, and access to the VIP lounge." },
	{ id = "AutoSell", gamePassId = 0, name = "Auto Sell", suggestedPrice = 150, description = "Your backpack sells itself when it fills up, wherever you are." },
	{ id = "BigBag", gamePassId = 0, name = "Big Backpack", suggestedPrice = 100, description = "Carry 60 finds instead of 20." },
	{ id = "Teleporter", gamePassId = 0, name = "Zone Teleporter", suggestedPrice = 200, description = "Teleport to any zone you have unlocked." },
}

-- kind: "rodSkin" changes how your shovel looks, "trail" adds a trail behind you,
-- "title" shows a title above your head.
Shop.Cosmetics = {
	{ id = "skin_golden", kind = "rodSkin", name = "Golden Shovel Skin", productId = 0, suggestedPrice = 99, color = Color3.fromRGB(255, 200, 40), material = Enum.Material.Foil },
	{ id = "skin_neon", kind = "rodSkin", name = "Neon Pink Shovel Skin", productId = 0, suggestedPrice = 75, color = Color3.fromRGB(255, 60, 200), material = Enum.Material.Neon },
	{ id = "skin_galaxy", kind = "rodSkin", name = "Galaxy Shovel Skin", productId = 0, suggestedPrice = 149, color = Color3.fromRGB(110, 60, 255), material = Enum.Material.ForceField },
	{ id = "skin_candy", kind = "rodSkin", name = "Candy Shovel Skin", productId = 0, suggestedPrice = 49, color = Color3.fromRGB(255, 120, 150), material = Enum.Material.SmoothPlastic },

	{ id = "trail_sparkle", kind = "trail", name = "Sparkle Trail", productId = 0, suggestedPrice = 49, colors = { Color3.fromRGB(0, 170, 255), Color3.fromRGB(0, 255, 200) } },
	{ id = "trail_fire", kind = "trail", name = "Fire Trail", productId = 0, suggestedPrice = 75, colors = { Color3.fromRGB(255, 220, 0), Color3.fromRGB(255, 40, 0) } },
	{ id = "trail_rainbow", kind = "trail", name = "Rainbow Trail", productId = 0, suggestedPrice = 129, colors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 120, 255), Color3.fromRGB(200, 0, 255) } },

	{ id = "title_lucky", kind = "title", name = "Title: Lucky Digger", text = "Lucky Digger", productId = 0, suggestedPrice = 25, color = Color3.fromRGB(120, 200, 255) },
	{ id = "title_whisperer", kind = "title", name = "Title: Rock Whisperer", text = "Rock Whisperer", productId = 0, suggestedPrice = 49, color = Color3.fromRGB(160, 255, 160) },
	{ id = "title_diglegend", kind = "title", name = "Title: Dig Legend", text = "Dig Legend", productId = 0, suggestedPrice = 99, color = Color3.fromRGB(255, 190, 60) },
}

-- Free titles earned by playing. The server checks the "rule".
Shop.EarnedTitles = {
	{ id = "earned_shallows", kind = "title", name = "Shallows Master", text = "Shallows Master", rule = "zoneBook", zone = "shallows", color = Color3.fromRGB(255, 220, 120) },
	{ id = "earned_mangroves", kind = "title", name = "Mangrove Master", text = "Mangrove Master", rule = "zoneBook", zone = "mangroves", color = Color3.fromRGB(110, 200, 110) },
	{ id = "earned_frostbite", kind = "title", name = "Frostbite Master", text = "Frostbite Master", rule = "zoneBook", zone = "frostbite", color = Color3.fromRGB(170, 220, 255) },
	{ id = "earned_legend", kind = "title", name = "Legend Hunter", text = "Legend Hunter", rule = "eventFish", color = Color3.fromRGB(255, 150, 0) },
	{ id = "earned_reborn", kind = "title", name = "Reborn", text = "Reborn", rule = "rebirth", color = Color3.fromRGB(255, 90, 160) },
}

Shop.PassById = {}
for _, pass in ipairs(Shop.Passes) do
	Shop.PassById[pass.id] = pass
end

Shop.CosmeticById = {}
Shop.CosmeticByProductId = {}
for _, item in ipairs(Shop.Cosmetics) do
	Shop.CosmeticById[item.id] = item
	if item.productId ~= 0 then
		Shop.CosmeticByProductId[item.productId] = item
	end
end
for _, item in ipairs(Shop.EarnedTitles) do
	item.earned = true
	Shop.CosmeticById[item.id] = item
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- Old Pete's first-day guide. Each step points at a place in the world (a part
-- with the matching "GuideTarget" attribute) and finishes on a game event.

local Tutorial = {}

Tutorial.Steps = {
	{ event = "EquipRod", text = "Welcome, sailor! Take out your rod: press 1, or tap the rod at the bottom of the screen.", target = nil },
	{ event = "Cast", text = "Walk to the end of the dock and click the water to cast. Bubbles mean fish!", target = "Dock" },
	{ event = "Catch", text = "Wait for the big \"!\" and strike. Then hold to reel, and ease off when the line gets tight!", target = "Dock" },
	{ event = "Sell", text = "Nice catch! Bring it to Marina at the Fish Market and sell it.", target = "Sell" },
	{ event = "Bounties", text = "Come see me at the bounty board. I pay extra for the fish I need!", target = "Bounties" },
}

Tutorial.Done = #Tutorial.Steps + 1
Tutorial.RewardCoins = 250
Tutorial.RewardBait = { id = "worms", amount = 10 }

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Zones</string><ProtectedString name="Source"><![CDATA[-- Fishing zones. Zones are unlocked with in-game coins.

local Zones = {}

Zones.List = {
	{ id = "shallows", name = "Sunny Shallows", price = 0, color = Color3.fromRGB(255, 220, 120) },
	{ id = "mangroves", name = "Misty Mangroves", price = 5000, color = Color3.fromRGB(90, 160, 90) },
	{ id = "frostbite", name = "Frostbite Bay", price = 150000, color = Color3.fromRGB(170, 220, 255) },
}

Zones.ById = {}
for index, zone in ipairs(Zones.List) do
	zone.order = index
	Zones.ById[zone.id] = zone
end

Zones.Default = "shallows"

return Zones
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000001C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000001B"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Dig Legends server. Starts every service in order.

local MapBuilder = require(script.MapBuilder)
local DataService = require(script.DataService)
local ShopService = require(script.ShopService)
local TutorialService = require(script.TutorialService)
local NpcService = require(script.NpcService)
local EconomyService = require(script.EconomyService)
local CosmeticService = require(script.CosmeticService)
local FishingService = require(script.FishingService)
local WorldService = require(script.WorldService)

MapBuilder.Build()

-- Services that react to players loading must start before DataService
ShopService.Start()
TutorialService.Start()
EconomyService.Start()
CosmeticService.Start()
FishingService.Start()
WorldService.Start()
NpcService.Start()
DataService.Start()

print("[Dig Legends] Server ready")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">CosmeticService</string><ProtectedString name="Source"><![CDATA[-- Shows each player's name tag (name, angler level, title, VIP) and cosmetics:
-- trails, rod skins and VIP extras.
-- Also hands out free titles players earn by playing.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Fish = require(Shared.Fish)
local Shop = require(Shared.Shop)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local CosmeticService = {}

local VIP_GOLD = Color3.fromRGB(255, 200, 40)
local applied = {} -- [player] = signature of what is shown, to skip needless rebuilds

local function equippedItem(data, kind)
	local id = data.cosmetics.equipped[kind]
	return id and data.cosmetics.owned[id] and Shop.CosmeticById[id] or nil
end

function CosmeticService.StyleRod(player, handle)
	local data = DataService.Get(player)
	local skin = data and equippedItem(data, "rodSkin")
	if skin then
		handle.Color = skin.color
		handle.Material = skin.material
	end
end

function CosmeticService.DecorateBobber(player, bobber)
	if ShopService.HasPass(player, "VIP") then
		bobber.Color = VIP_GOLD
		bobber.Material = Enum.Material.Neon
	end
end

local function clearOld(character)
	for _, name in ipairs({ "ReelTitle", "ReelTrail", "ReelCrown", "ReelTrailTop", "ReelTrailBottom" }) do
		for _, item in ipairs(character:GetDescendants()) do
			if item.Name == name then
				item:Destroy()
			end
		end
	end
end

local function applyToCharacter(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local head = character:WaitForChild("Head", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not head or not root then
		return
	end
	clearOld(character)

	local vip = ShopService.HasPass(player, "VIP")
	local title = equippedItem(data, "title")

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "ReelTitle"
	gui.Size = UDim2.fromOffset(240, 72)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 90
	gui.Adornee = head
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	local order = 0
	local function line(text, color, height)
		order += 1
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, height or 22)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextStrokeTransparency = 0.4
		label.LayoutOrder = order
		label.Parent = gui
	end
	if title then
		line(title.text, title.color, 18)
	end
	line(player.DisplayName, vip and VIP_GOLD or Color3.new(1, 1, 1), 24)
	line(string.format("%sLv %d Angler", vip and "VIP  " or "", Level.FromXp(data.xp)), Color3.fromRGB(150, 220, 255), 18)
	gui.Parent = head

	if vip then
		local crown = Instance.new("Part")
		crown.Name = "ReelCrown"
		crown.Size = Vector3.new(1.1, 0.5, 1.1)
		crown.Color = VIP_GOLD
		crown.Material = Enum.Material.Neon
		crown.CanCollide = false
		crown.CanQuery = false
		crown.Massless = true
		local weld = Instance.new("Weld")
		weld.Part0 = head
		weld.Part1 = crown
		weld.C0 = CFrame.new(0, head.Size.Y / 2 + 0.3, 0)
		weld.Parent = crown
		crown.Parent = character
	end

	local trailItem = equippedItem(data, "trail")
	if trailItem then
		local top = Instance.new("Attachment")
		top.Name = "ReelTrailTop"
		top.Position = Vector3.new(0, 0.8, 0.5)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "ReelTrailBottom"
		bottom.Position = Vector3.new(0, -0.8, 0.5)
		bottom.Parent = root
		local keypoints = {}
		for index, color in ipairs(trailItem.colors) do
			table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #trailItem.colors - 1), color))
		end
		local trail = Instance.new("Trail")
		trail.Name = "ReelTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = ColorSequence.new(keypoints)
		trail.Lifetime = 0.6
		trail.LightEmission = 0.6
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
end

local function signature(data, runtime)
	local equipped = data.cosmetics.equipped
	return table.concat({
		tostring(equipped.title),
		tostring(equipped.trail),
		tostring(runtime.passes and runtime.passes.VIP),
		tostring(Level.FromXp(data.xp)),
	}, "|")
end

local function earnedTitleUnlocked(rule, data)
	if rule.rule == "zoneBook" then
		for _, fish in ipairs(Fish.ByZone[rule.zone] or {}) do
			if not data.book[fish.id] then
				return false
			end
		end
		return true
	elseif rule.rule == "eventFish" then
		for _, fish in ipairs(Fish.EventFish) do
			if data.book[fish.id] then
				return true
			end
		end
	elseif rule.rule == "rebirth" then
		return data.rebirths >= 1
	end
	return false
end

local function checkEarnedTitles(player, data)
	local newTitles = {}
	for _, title in ipairs(Shop.EarnedTitles) do
		if not data.cosmetics.owned[title.id] and earnedTitleUnlocked(title, data) then
			table.insert(newTitles, title)
		end
	end
	if #newTitles == 0 then
		return
	end
	DataService.Update(player, function(saved)
		for _, title in ipairs(newTitles) do
			saved.cosmetics.owned[title.id] = true
		end
	end)
	for _, title in ipairs(newTitles) do
		Remotes.Notify:FireClient(player, "New title unlocked: " .. title.text .. "! Equip it in the Shop.", "rare")
	end
end

function CosmeticService.Start()
	DataService.OnChanged(function(player, data, runtime)
		checkEarnedTitles(player, data)
		local current = signature(data, runtime)
		if applied[player] ~= current then
			applied[player] = current
			applyToCharacter(player)
		end
	end)

	local function watch(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			applyToCharacter(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		applied[player] = nil
	end)
end

return CosmeticService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Loads, saves and hands out each player's save data.
-- Other scripts change data with DataService.Update(player, function(data) ... end)
-- so the player's screen and leaderboard always refresh afterwards.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Rods = require(Shared.Rods)
local Zones = require(Shared.Zones)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)

local DataService = {}

local LOCK_EXPIRES = 15 * 60 -- a lock older than this is from a crashed server

local function defaultData()
	return {
		coins = 0,
		totalEarned = 0,
		totalCaught = 0,
		rebirths = 0,
		xp = 0,
		tutorial = 1, -- step of Old Pete's guide (Shared/Tutorial)
		bag = {}, -- { {uid, id, weight, value, shiny, favorite} }
		nextUid = 1,
		bait = {
			owned = {}, -- [baitId] = how many
			equipped = "bread",
		},
		bounties = { day = 0, list = {} },
		rodsOwned = { [Rods.Default] = true },
		equippedRod = Rods.Default,
		zones = { [Zones.Default] = true },
		book = {}, -- [fishId] = { count, best, shiny }
		cosmetics = {
			owned = {}, -- [cosmeticId] = true
			equipped = {}, -- [kind] = cosmeticId
		},
		purchases = {}, -- [receiptPurchaseId] = true
		lastDailyDay = 0,
		dailyStreak = 0,
	}
end

-- Fill in any fields missing from older saves
local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local store = nil
local savingEnabled = true
local profiles = {} -- [player] = { data = {}, runtime = {} }
local listeners = {} -- functions called after any data change

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		savingEnabled = false
		warn("[DataService] DataStores unavailable, progress will not save: " .. tostring(result))
	end
end

local function keyFor(player)
	return "player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return defaultData(), false
	end

	local key = keyFor(player)
	for attempt = 1, 6 do
		local lockedElsewhere = false
		local stealLock = attempt >= 4 -- after ~15 seconds, assume the old server is gone
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(saved)
				saved = saved or { data = defaultData() }
				local lock = saved.lock
				if lock and lock.jobId ~= game.JobId and os.time() - lock.time < LOCK_EXPIRES and not stealLock then
					lockedElsewhere = true
					return nil
				end
				saved.lock = { jobId = game.JobId, time = os.time() }
				return saved
			end)
		end)

		if ok and not lockedElsewhere and result then
			local data = reconcile(result.data or defaultData(), defaultData())
			-- Saves from before fish had ids
			for _, fish in ipairs(data.bag) do
				if not fish.uid then
					fish.uid = data.nextUid
					data.nextUid += 1
				end
			end
			return data, true
		end

		if not ok then
			local message = tostring(result)
			warn(string.format("[DataService] Load attempt %d failed for %s: %s", attempt, player.Name, message))
			if RunService:IsStudio() then
				-- Usually an unpublished place, or "Enable Studio Access to API Services" is off
				return defaultData(), false
			end
		end
		task.wait(5)
	end
	return nil, false
end

local function saveData(player, release)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return true
	end
	local data = profile.data
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function(saved)
			saved = saved or {}
			if saved.lock and saved.lock.jobId ~= game.JobId then
				-- Another server took over this player; don't overwrite newer data
				return nil
			end
			saved.data = data
			saved.lock = (not release) and { jobId = game.JobId, time = os.time() } or nil
			return saved
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end

	-- Global "most fish caught" board
	pcall(function()
		DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName):SetAsync(tostring(player.UserId), data.totalCaught)
	end)
	return ok
end

local function setupLeaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ "Level", "Coins", "Caught", "Rebirths" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

local function refresh(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local data = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Level.Value = Level.FromXp(data.xp)
		stats.Coins.Value = data.coins
		stats.Caught.Value = data.totalCaught
		stats.Rebirths.Value = data.rebirths
	end
	for _, listener in ipairs(listeners) do
		task.spawn(listener, player, data, profile.runtime)
	end
	Remotes.DataUpdate:FireClient(player, data, profile.runtime)
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Runtime info that is not saved (game passes owned, bag size, ...)
function DataService.GetRuntime(player)
	local profile = profiles[player]
	return profile and profile.runtime
end

function DataService.Update(player, change)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local results = table.pack(change(profile.data, profile.runtime))
	refresh(player)
	return table.unpack(results, 1, results.n)
end

function DataService.Refresh(player)
	refresh(player)
end

-- Called with (player, data, runtime) after every change
function DataService.OnChanged(listener)
	table.insert(listeners, listener)
end

function DataService.SaveNow(player)
	return saveData(player, false)
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

-- Waits until the player's data has loaded (or they left)
function DataService.WaitFor(player)
	while player.Parent and not profiles[player] do
		task.wait(0.2)
	end
	return profiles[player] ~= nil
end

local loadedCallbacks = {}
-- callback(player, data, runtime) runs once per player, before the data is shared.
-- It may yield, but must not call DataService.Get/Update for that player.
function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function onPlayerAdded(player)
	setupLeaderstats(player)
	local data, canSave = loadData(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("We couldn't load your save. Please rejoin in a minute.")
		return
	end
	-- Loaded callbacks fill in runtime info (like game passes) before anything else sees the data
	local runtime = { passes = {}, bagSize = Config.BagSize }
	for _, callback in ipairs(loadedCallbacks) do
		callback(player, data, runtime)
	end
	if not player.Parent then
		return
	end
	profiles[player] = { data = data, runtime = runtime, canSave = canSave and savingEnabled }
	refresh(player)
	if not profiles[player].canSave then
		Remotes.Notify:FireClient(player, "Saving is off (in Studio, turn on API Services to test saving).", "warning")
	end
end

local function onPlayerRemoving(player)
	if profiles[player] then
		saveData(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(saveData, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveData(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Coins: the Fish Market, bait, bounties, rods, zones, rebirths and daily
-- rewards, plus the menu buttons players press (all go through the "Action" remote).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Fish = require(Shared.Fish)
local Rods = require(Shared.Rods)
local Zones = require(Shared.Zones)
local Shop = require(Shared.Shop)
local Bait = require(Shared.Bait)
local Market = require(Shared.Market)
local Bounties = require(Shared.Bounties)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local TutorialService = require(script.Parent.TutorialService)

local EconomyService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind)
end

-- True if the player stands near a station (market, bait shop). Maps without
-- that station don't require it.
local function nearStation(player, station)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local found = false
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == station then
			found = true
			if root and (item.Position - root.Position).Magnitude <= Config.StationRange then
				return true
			end
		end
	end
	return not found
end

local function findInBag(data, uid)
	for index, fish in ipairs(data.bag) do
		if fish.uid == uid then
			return index, fish
		end
	end
	return nil
end

-- Sells every fish that isn't marked as a favorite.
-- auto = true for the Auto Sell pass (works anywhere).
function EconomyService.SellAll(player, auto)
	local data = DataService.Get(player)
	if not data then
		return false, "Still loading"
	end
	if not auto and not nearStation(player, "Sell") then
		return false, "Sell fish at the Fish Market"
	end
	local hot = Market.HotFish()
	local count, earned = DataService.Update(player, function(saved)
		local keep, total, sold = {}, 0, 0
		for _, fish in ipairs(saved.bag) do
			if fish.favorite then
				table.insert(keep, fish)
			else
				total += Market.Price(fish, saved.rebirths, hot)
				sold += 1
			end
		end
		saved.coins += total
		saved.totalEarned += total
		saved.bag = keep
		return sold, total
	end)
	if count == 0 then
		return false, "Nothing to sell (favorites are never sold)"
	end
	notify(player, string.format("Sold %d fish for %s coins", count, Format.Number(earned)), "coins")
	if not auto then
		TutorialService.Event(player, "Sell")
	end
	return true
end

function EconomyService.SellFish(player, uidText)
	local data = DataService.Get(player)
	local uid = tonumber(uidText)
	if not data or not uid then
		return false, "Unknown fish"
	end
	if not nearStation(player, "Sell") then
		return false, "Sell fish at the Fish Market"
	end
	local index, fish = findInBag(data, uid)
	if not index then
		return false, "That fish is gone"
	end
	if fish.favorite then
		return false, "Unfavorite it first"
	end
	local price = Market.Price(fish, data.rebirths)
	DataService.Update(player, function(saved)
		table.remove(saved.bag, index)
		saved.coins += price
		saved.totalEarned += price
	end)
	notify(player, string.format("Sold %s for %s coins", Fish.ById[fish.id].name, Format.Number(price)), "coins")
	TutorialService.Event(player, "Sell")
	return true
end

function EconomyService.ToggleFavorite(player, uidText)
	local data = DataService.Get(player)
	local index = data and findInBag(data, tonumber(uidText))
	if not index then
		return false, "That fish is gone"
	end
	DataService.Update(player, function(saved)
		saved.bag[index].favorite = not saved.bag[index].favorite or nil
	end)
	return true
end

function EconomyService.EquipBait(player, baitId)
	local bait = Bait.ById[baitId]
	local data = DataService.Get(player)
	if not bait or not data then
		return false, "Unknown bait"
	end
	if not bait.free and (data.bait.owned[bait.id] or 0) <= 0 then
		return false, "You don't have any " .. bait.name
	end
	DataService.Update(player, function(saved)
		saved.bait.equipped = bait.id
	end)
	return true
end

function EconomyService.BuyBait(player, baitId)
	local bait = Bait.ById[baitId]
	local data = DataService.Get(player)
	if not bait or not data or not bait.price then
		return false, "You can't buy that"
	end
	if not nearStation(player, "Bait") then
		return false, "Buy bait at the Bait & Tackle shop"
	end
	if data.coins < bait.price then
		return false, "Not enough coins"
	end
	DataService.Update(player, function(saved)
		saved.coins -= bait.price
		saved.bait.owned[bait.id] = (saved.bait.owned[bait.id] or 0) + bait.buyAmount
	end)
	notify(player, string.format("+%d %s", bait.buyAmount, bait.name), "success")
	return true
end

-- Which bag fish a recipe would use: the cheapest non-favorite fish of each rarity
local function pickIngredients(data, recipe)
	local used = {}
	for _, need in ipairs(recipe) do
		local candidates = {}
		for _, fish in ipairs(data.bag) do
			if not fish.favorite and not used[fish.uid] and Fish.ById[fish.id].rarity == need.rarity then
				table.insert(candidates, fish)
			end
		end
		if #candidates < need.count then
			return nil
		end
		table.sort(candidates, function(a, b)
			return a.value < b.value
		end)
		for i = 1, need.count do
			used[candidates[i].uid] = true
		end
	end
	return used
end
EconomyService.PickIngredients = pickIngredients

function EconomyService.CraftBait(player, baitId)
	local bait = Bait.ById[baitId]
	local data = DataService.Get(player)
	if not bait or not data or not bait.recipe then
		return false, "You can't make that"
	end
	if not nearStation(player, "Bait") then
		return false, "Make bait at the Bait & Tackle shop"
	end
	local used = pickIngredients(data, bait.recipe)
	if not used then
		return false, "You don't have the fish for that (favorites are never used)"
	end
	DataService.Update(player, function(saved)
		local keep = {}
		for _, fish in ipairs(saved.bag) do
			if not used[fish.uid] then
				table.insert(keep, fish)
			end
		end
		saved.bag = keep
		saved.bait.owned[bait.id] = (saved.bait.owned[bait.id] or 0) + bait.craftAmount
	end)
	notify(player, string.format("Made %d %s", bait.craftAmount, bait.name), "success")
	return true
end

-- Gives the player today's bounties if they don't have them yet
local function refreshBounties(player, data)
	local today = Bounties.Today(os.time())
	if data.bounties.day ~= today then
		data.bounties = { day = today, list = Bounties.Generate(player.UserId, today, data.zones) }
		return true
	end
	return false
end

function EconomyService.ClaimBounty(player, indexText)
	local data = DataService.Get(player)
	local index = tonumber(indexText)
	local bounty = data and index and data.bounties.list[index]
	if not bounty or bounty.done then
		return false, "That bounty is gone"
	end
	local chosen, found = {}, 0
	for _, fish in ipairs(data.bag) do
		if fish.id == bounty.fishId and not fish.favorite and found < bounty.count then
			chosen[fish.uid] = true
			found += 1
		end
	end
	if found < bounty.count then
		return false, string.format("You need %d %s (favorites don't count)", bounty.count, Fish.ById[bounty.fishId].name)
	end
	local reward = Bounties.Reward(bounty, Config.SellMultiplier(data.rebirths))
	DataService.Update(player, function(saved)
		local keep = {}
		for _, fish in ipairs(saved.bag) do
			if not chosen[fish.uid] then
				table.insert(keep, fish)
			end
		end
		saved.bag = keep
		saved.coins += reward
		saved.totalEarned += reward
		saved.bait.owned[bounty.bait] = (saved.bait.owned[bounty.bait] or 0) + bounty.baitAmount
		saved.bounties.list[index].done = true
	end)
	notify(player, string.format("Bounty done! +%s coins, +%d %s", Format.Number(reward), bounty.baitAmount, Bait.ById[bounty.bait].name), "coins")
	return true
end

function EconomyService.BuyRod(player, rodId)
	local rod = Rods.ById[rodId]
	local data = DataService.Get(player)
	if not rod or not data then
		return false, "Unknown rod"
	end
	if data.rodsOwned[rod.id] then
		return EconomyService.EquipRod(player, rodId)
	end
	if rod.requiresRebirths and data.rebirths < rod.requiresRebirths then
		return false, string.format("Needs %d rebirth(s)", rod.requiresRebirths)
	end
	if data.coins < rod.price then
		return false, "Not enough coins"
	end
	DataService.Update(player, function(saved)
		saved.coins -= rod.price
		saved.rodsOwned[rod.id] = true
		saved.equippedRod = rod.id
	end)
	notify(player, "You bought the " .. rod.name .. "!", "success")
	return true
end

function EconomyService.EquipRod(player, rodId)
	local data = DataService.Get(player)
	if not data or not data.rodsOwned[rodId] then
		return false, "You don't own that rod"
	end
	DataService.Update(player, function(saved)
		saved.equippedRod = rodId
	end)
	return true
end

function EconomyService.UnlockZone(player, zoneId)
	local zone = Zones.ById[zoneId]
	local data = DataService.Get(player)
	if not zone or not data then
		return false, "Unknown zone"
	end
	if data.zones[zone.id] then
		return true
	end
	if data.coins < zone.price then
		return false, string.format("You need %s coins to unlock %s", Format.Number(zone.price), zone.name)
	end
	DataService.Update(player, function(saved)
		saved.coins -= zone.price
		saved.zones[zone.id] = true
	end)
	notify(player, zone.name .. " unlocked!", "success")
	return true
end

function EconomyService.Teleport(player, zoneId)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return false, "Not ready"
	end
	if zoneId ~= "hub" then
		if not ShopService.HasPass(player, "Teleporter") then
			return false, "The Zone Teleporter pass lets you teleport to zones"
		end
		if not data.zones[zoneId] then
			return false, "Unlock that zone first"
		end
	end
	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("ZoneSpawn") == zoneId then
			character:PivotTo(item.CFrame + Vector3.new(0, 4, 0))
			return true
		end
	end
	return false, "No teleport spot for that zone"
end

function EconomyService.Rebirth(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Not ready"
	end
	local cost = Config.RebirthCost(data.rebirths)
	local requiredZone = Zones.ById[Config.RebirthRequiresZone]
	if requiredZone and not data.zones[requiredZone.id] then
		return false, "Unlock " .. requiredZone.name .. " first"
	end
	if data.coins < cost then
		return false, string.format("You need %s coins to rebirth", Format.Number(cost))
	end
	DataService.Update(player, function(saved)
		-- Keep: fish book, favorite fish, bait, cosmetics, titles, stats. Reset: coins, rods, zones, other fish.
		saved.rebirths += 1
		saved.coins = 0
		local favorites = {}
		for _, fish in ipairs(saved.bag) do
			if fish.favorite then
				table.insert(favorites, fish)
			end
		end
		saved.bag = favorites
		saved.rodsOwned = { [Rods.Default] = true }
		saved.equippedRod = Rods.Default
		saved.zones = { [Zones.Default] = true }
	end)
	EconomyService.Teleport(player, "hub")
	notify(player, string.format("Reborn! You now earn +%d%% coins from fish.", math.floor((Config.SellMultiplier(data.rebirths) - 1) * 100 + 0.5)), "success")
	return true
end

function EconomyService.EquipCosmetic(player, cosmeticId)
	local item = Shop.CosmeticById[cosmeticId]
	local data = DataService.Get(player)
	if not item or not data or not data.cosmetics.owned[cosmeticId] then
		return false, "You don't own that"
	end
	DataService.Update(player, function(saved)
		if saved.cosmetics.equipped[item.kind] == cosmeticId then
			saved.cosmetics.equipped[item.kind] = nil -- pressing again takes it off
		else
			saved.cosmetics.equipped[item.kind] = cosmeticId
		end
	end)
	return true
end

local function giveDailyReward(player, data)
	local today = math.floor(os.time() / 86400)
	if data.lastDailyDay == today then
		return
	end
	if data.lastDailyDay == today - 1 then
		data.dailyStreak += 1
	else
		data.dailyStreak = 1
	end
	data.lastDailyDay = today
	local day = math.min(data.dailyStreak, Config.DailyStreakCap)
	local reward = math.floor(Config.DailyRewardBase * day * Config.SellMultiplier(data.rebirths))
	data.coins += reward
	data.totalEarned += reward
	task.spawn(function()
		if DataService.WaitFor(player) then
			notify(player, string.format("Daily reward (day %d streak): +%s coins! Come back tomorrow for more.", data.dailyStreak, Format.Number(reward)), "coins")
		end
	end)
end

local actions = {
	SellAll = function(player)
		return EconomyService.SellAll(player, false)
	end,
	SellFish = EconomyService.SellFish,
	ToggleFavorite = EconomyService.ToggleFavorite,
	EquipBait = EconomyService.EquipBait,
	BuyBait = EconomyService.BuyBait,
	CraftBait = EconomyService.CraftBait,
	ClaimBounty = EconomyService.ClaimBounty,
	BuyRod = EconomyService.BuyRod,
	EquipRod = EconomyService.EquipRod,
	UnlockZone = EconomyService.UnlockZone,
	Teleport = EconomyService.Teleport,
	Rebirth = EconomyService.Rebirth,
	EquipCosmetic = EconomyService.EquipCosmetic,
}

function EconomyService.Start()
	DataService.OnLoaded(function(player, data)
		giveDailyReward(player, data)
		refreshBounties(player, data)
	end)

	-- New bounties at midnight UTC for players who are online
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local data = DataService.Get(player)
				if data and data.bounties.day ~= Bounties.Today(os.time()) then
					DataService.Update(player, function(saved)
						refreshBounties(player, saved)
					end)
				end
			end
		end
	end)

	Remotes.Action.OnServerInvoke = function(player, actionName, argument)
		local action = actions[actionName]
		if type(actionName) ~= "string" or not action then
			return false, "Unknown action"
		end
		if argument ~= nil and type(argument) ~= "string" then
			return false, "Bad request"
		end
		local ok, success, message = pcall(action, player, argument)
		if not ok then
			warn("[EconomyService] " .. actionName .. " failed: " .. tostring(success))
			return false, "Something went wrong"
		end
		return success, message
	end
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">FishingService</string><ProtectedString name="Source"><![CDATA[-- Casting, nibbles, bites, hooking and catches. The server decides which fish
-- bites and checks the timing, so players can't pick their own fish. The
-- reeling fight runs on the player's screen using the shared Fight rules.
--
-- A cast goes: waiting (with fake nibbles) -> bite (strike now!) -> fight -> result
--   strike during waiting  = "early": the fish is scared off (bait kept)
--   no strike in time      = "stolen": the fish ate the bait
--   fight lost             = "snapped" or "escaped"

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Fish = require(Shared.Fish)
local Rods = require(Shared.Rods)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Bait = require(Shared.Bait)
local Fight = require(Shared.Fight)
local FishModel = require(Shared.FishModel)
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local EconomyService = require(script.Parent.EconomyService)
local CosmeticService = require(script.Parent.CosmeticService)
local TutorialService = require(script.Parent.TutorialService)

local FishingService = {}

local ROD_NAME = "Fishing Rod"
local WANDER_LIMIT = 8 -- studs a player may drift from where they cast
local HOTSPOT_RADIUS = 12
local HOTSPOT_BITE = 0.65 -- bites come this much sooner at a bubbling hotspot

local random = Random.new()
local casts = {} -- [player] = current cast
local lastCast = {} -- [player] = os.clock()
local nextCastId = 0

local function fishingZoneParts()
	local result = {}
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("FishingZone") then
			table.insert(result, item)
		end
	end
	return result
end

local zoneParts = {}
local hotspots = {}

local function nearHotspot(position)
	for _, spot in ipairs(hotspots) do
		local flat = Vector3.new(spot.Position.X - position.X, 0, spot.Position.Z - position.Z)
		if flat.Magnitude <= HOTSPOT_RADIUS then
			return true
		end
	end
	return false
end

local function zoneAt(position)
	for _, zonePart in ipairs(zoneParts) do
		local relative = zonePart.CFrame:PointToObjectSpace(position)
		local half = zonePart.Size / 2
		if math.abs(relative.X) <= half.X and math.abs(relative.Z) <= half.Z and math.abs(relative.Y) <= half.Y + 3 then
			return zonePart:GetAttribute("FishingZone")
		end
	end
	return nil
end

-- True if there is land (an island, a bridge...) at this spot instead of water
local function isOverLand(position, character)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = table.clone(zoneParts)
	table.insert(ignore, character)
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local hit = Workspace:Raycast(position + Vector3.new(0, 60, 0), Vector3.new(0, -120, 0), params)
	return hit ~= nil and hit.Instance ~= Workspace.Terrain and hit.Position.Y > position.Y + 0.5
end

local function rodTip(player)
	local character = player.Character
	local tool = character and character:FindFirstChild(ROD_NAME)
	local handle = tool and tool:FindFirstChild("Handle")
	return handle and handle:FindFirstChild("Tip")
end

local function clearCast(player)
	local cast = casts[player]
	casts[player] = nil
	if cast and cast.bobber then
		cast.bobber:Destroy()
	end
end

local function makeBobber(player, position)
	local bobber = Instance.new("Part")
	bobber.Name = player.Name .. "Bobber"
	bobber.Shape = Enum.PartType.Ball
	bobber.Size = Vector3.new(0.8, 0.8, 0.8)
	bobber.Color = Color3.fromRGB(255, 60, 60)
	bobber.Material = Enum.Material.SmoothPlastic
	bobber.Anchored = true
	bobber.CanCollide = false
	bobber.CanQuery = false
	bobber.Position = position
	local attachment = Instance.new("Attachment")
	attachment.Parent = bobber

	-- The fishing line is a Beam: it only draws a line, so it can't pull the player
	local tip = rodTip(player)
	if tip then
		local line = Instance.new("Beam")
		line.Attachment0 = tip
		line.Attachment1 = attachment
		line.Width0 = 0.06
		line.Width1 = 0.06
		line.FaceCamera = true
		line.CurveSize0 = -2
		line.Segments = 12
		line.Color = ColorSequence.new(Color3.new(1, 1, 1))
		line.Transparency = NumberSequence.new(0.2)
		line.Parent = bobber
	end
	CosmeticService.DecorateBobber(player, bobber)
	bobber.Parent = Workspace
	return bobber
end

-- The bait on the hook for this cast (falls back to bread when you run out)
local function currentBait(data)
	local bait = Bait.ById[data.bait.equipped]
	if not bait or (not bait.free and (data.bait.owned[bait.id] or 0) <= 0) then
		return Bait.ById[Bait.Default]
	end
	return bait
end

-- Pick which fish bites, using rod luck, bait, weather and the weekly event
local function rollFish(data, zoneId, bait)
	local rod = Rods.ById[data.equippedRod] or Rods.ById[Rods.Default]
	local weather = Events.GetWeather()
	local eventFish = Events.GetEventFish()

	local byRarity = {}
	for _, fish in ipairs(Fish.ByZone[zoneId] or {}) do
		byRarity[fish.rarity] = byRarity[fish.rarity] or {}
		table.insert(byRarity[fish.rarity], fish)
	end

	local choices = {}
	local total = 0
	for _, rarity in ipairs(Fish.Rarities) do
		if byRarity[rarity.id] then
			local weight = rarity.weight
			if rarity.order >= 3 then
				weight *= rod.luck * (weather.luckMultiplier or 1) * (bait.luck or 1)
			end
			if rarity.order >= 5 then
				weight *= (weather.legendaryMultiplier or 1) * (bait.legendary or 1)
			end
			total += weight
			table.insert(choices, { rarity = rarity, weight = weight })
		end
	end

	local pick = random:NextNumber(0, total)
	local chosen = choices[1].rarity
	for _, choice in ipairs(choices) do
		pick -= choice.weight
		if pick <= 0 then
			chosen = choice.rarity
			break
		end
	end

	local fish
	if chosen.id == "Legendary" and eventFish.zone == zoneId and random:NextNumber() < 0.5 then
		fish = eventFish
	else
		local pool = byRarity[chosen.id]
		fish = pool[random:NextInteger(1, #pool)]
	end

	-- Heavier fish are rarer and worth more
	local roll = random:NextNumber() ^ 1.6
	local weight = fish.weight[1] + (fish.weight[2] - fish.weight[1]) * roll
	local shinyChance = Config.ShinyChance * (weather.shinyMultiplier or 1) * (bait.shiny or 1)
	local shiny = random:NextNumber() < shinyChance
	local value = fish.value * (0.75 + 0.5 * roll)
	if shiny then
		value *= Config.ShinyValueMultiplier
	end

	return {
		id = fish.id,
		weight = math.floor(weight * 10 + 0.5) / 10,
		value = math.max(1, math.floor(value)),
		shiny = shiny,
	}
end

local function announce(player, fish, caught)
	local rarity = Fish.RarityById[fish.rarity]
	if rarity.order < 5 then
		return
	end
	local text = string.format("%s caught a %s%s %s!", player.DisplayName, caught.shiny and "Shiny " or "", fish.rarity, fish.name)
	for _, other in ipairs(Players:GetPlayers()) do
		Remotes.Notify:FireClient(other, text, "rare")
	end
end

-- Ends the cast without a catch and tells the player why
local function lose(player, cast, reason)
	if casts[player] == cast then
		clearCast(player)
	end
	Remotes.CatchResult:FireClient(player, cast.id, nil, reason)
end

local function dipBobber(cast, depth, seconds)
	local bobber = cast.bobber
	if not bobber or not bobber.Parent then
		return
	end
	local home = cast.surface
	local down = TweenService:Create(bobber, TweenInfo.new(seconds / 2), { Position = home - Vector3.new(0, depth, 0) })
	down:Play()
	task.delay(seconds / 2, function()
		if bobber.Parent and cast.phase == "waiting" then
			TweenService:Create(bobber, TweenInfo.new(seconds / 2), { Position = home }):Play()
		end
	end)
end

local function onBite(player, cast)
	if casts[player] ~= cast or not player.Parent then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end

	-- The fish takes the bait now, whatever happens next
	local bait = cast.bait
	if not bait.free then
		DataService.Update(player, function(saved)
			local left = math.max(0, (saved.bait.owned[bait.id] or 0) - 1)
			saved.bait.owned[bait.id] = left
			if left == 0 and saved.bait.equipped == bait.id then
				saved.bait.equipped = Bait.Default
				Remotes.Notify:FireClient(player, "That was your last " .. bait.name .. ". Back to Bread.", "info")
			end
		end)
	end

	cast.catch = rollFish(data, cast.zone, bait)
	cast.rarity = Fish.RarityById[Fish.ById[cast.catch.id].rarity]
	cast.phase = "bite"
	cast.biteAt = os.clock()
	if cast.bobber then
		cast.bobber.Position = cast.surface - Vector3.new(0, 1.2, 0)
		cast.bobber.Color = Color3.fromRGB(255, 220, 0)
	end
	Remotes.Bite:FireClient(player, cast.id, { window = cast.rarity.hookWindow })

	task.delay(cast.rarity.hookWindow + Config.HookGrace, function()
		if casts[player] == cast and cast.phase == "bite" then
			lose(player, cast, "stolen")
		end
	end)
end

local function onCast(player, target)
	if typeof(target) ~= "Vector3" then
		return nil
	end
	local data = DataService.Get(player)
	local runtime = DataService.GetRuntime(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not root or not humanoid or humanoid.Health <= 0 or not character:FindFirstChild(ROD_NAME) then
		return nil
	end
	if casts[player] then
		return nil
	end
	if lastCast[player] and os.clock() - lastCast[player] < Config.CastCooldown then
		return nil
	end

	if #data.bag >= runtime.bagSize then
		if ShopService.HasPass(player, "AutoSell") then
			EconomyService.SellAll(player, true)
		end
		data = DataService.Get(player)
		if #data.bag >= runtime.bagSize then
			Remotes.Notify:FireClient(player, "Your bag is full! Sell fish at the Fish Market.", "warning")
			return nil
		end
	end

	local flat = Vector3.new(target.X - root.Position.X, 0, target.Z - root.Position.Z)
	if flat.Magnitude > Config.MaxCastDistance then
		Remotes.Notify:FireClient(player, "That's too far. Get closer to the water.", "warning")
		return nil
	end

	local zoneId = zoneAt(target)
	if not zoneId or isOverLand(target, character) then
		Remotes.Notify:FireClient(player, "Cast into the water to fish.", "warning")
		return nil
	end
	if not data.zones[zoneId] then
		local zone = Zones.ById[zoneId]
		Remotes.Notify:FireClient(player, "Unlock " .. (zone and zone.name or zoneId) .. " to fish here.", "warning")
		return nil
	end

	lastCast[player] = os.clock()
	nextCastId += 1
	local surface = Vector3.new(target.X, 0.3, target.Z)
	local bait = currentBait(data)
	local cast = {
		id = nextCastId,
		origin = root.Position,
		zone = zoneId,
		phase = "waiting",
		surface = surface,
		bait = bait,
		bobber = makeBobber(player, surface),
	}
	casts[player] = cast

	local rod = Rods.ById[data.equippedRod] or Rods.ById[Rods.Default]
	local weather = Events.GetWeather()
	local wait = random:NextNumber(Config.BiteWaitMin, Config.BiteWaitMax) * rod.speed * (weather.biteMultiplier or 1) * (bait.biteSpeed or 1)
	if nearHotspot(target) then
		wait *= HOTSPOT_BITE
	end
	TutorialService.Event(player, "Cast")

	-- Fake nibbles to tempt an early strike
	local nibbles = random:NextInteger(0, Config.NibblesMax)
	for _ = 1, nibbles do
		local at = random:NextNumber(0.8, math.max(0.9, wait - 0.7))
		task.delay(at, function()
			if casts[player] == cast and cast.phase == "waiting" then
				dipBobber(cast, 0.35, 0.4)
				Remotes.Nibble:FireClient(player, cast.id)
			end
		end)
	end
	task.delay(wait, onBite, player, cast)
	return cast.id
end

local function onHook(player, castId)
	local cast = casts[player]
	if not cast or cast.id ~= castId then
		return
	end
	if cast.phase == "waiting" then
		lose(player, cast, "early")
		return
	end
	if cast.phase ~= "bite" then
		return
	end
	if os.clock() - cast.biteAt > cast.rarity.hookWindow + Config.HookGrace then
		lose(player, cast, "stolen")
		return
	end

	local data = DataService.Get(player)
	local rod = data and Rods.ById[data.equippedRod] or Rods.ById[Rods.Default]
	cast.phase = "fight"
	cast.fightParams = Fight.Params(cast.rarity, rod)
	cast.hookAt = os.clock()
	Remotes.Fight:FireClient(player, cast.id, cast.fightParams)

	task.delay(Fight.MaxSeconds + 5, function()
		if casts[player] == cast then
			lose(player, cast, "escaped")
		end
	end)
end

local function onReel(player, castId, outcome)
	local cast = casts[player]
	if not cast or cast.id ~= castId or cast.phase ~= "fight" then
		return
	end
	if outcome ~= "caught" then
		lose(player, cast, outcome == "snapped" and "snapped" or "escaped")
		return
	end
	-- Nobody can land a fish faster than a perfect, non-stop reel
	if os.clock() - cast.hookAt < Fight.MinSeconds(cast.fightParams) * 0.9 then
		lose(player, cast, "escaped")
		return
	end
	clearCast(player)

	local fish = Fish.ById[cast.catch.id]
	local caught = cast.catch
	local levelBefore, levelAfter = 1, 1
	local isNew, isRecord = DataService.Update(player, function(data)
		caught.uid = data.nextUid
		data.nextUid += 1
		table.insert(data.bag, caught)
		data.totalCaught += 1
		local entry = data.book[caught.id]
		local firstTime = entry == nil
		if firstTime then
			entry = { count = 0, best = 0, shiny = 0 }
			data.book[caught.id] = entry
		end
		local record = not firstTime and caught.weight > entry.best
		entry.count += 1
		entry.best = math.max(entry.best, caught.weight)
		if caught.shiny then
			entry.shiny += 1
		end

		levelBefore = Level.FromXp(data.xp)
		data.xp += Level.XpForCatch(caught.id, firstTime)
		levelAfter = Level.FromXp(data.xp)
		for level = levelBefore + 1, levelAfter do
			data.coins += level * Level.CoinsPerLevel
		end
		return firstTime, record
	end)

	Remotes.CatchResult:FireClient(player, castId, {
		id = caught.id,
		weight = caught.weight,
		value = caught.value,
		shiny = caught.shiny,
		isNew = isNew,
		isRecord = isRecord,
		xp = Level.XpForCatch(caught.id, isNew),
	})
	if levelAfter > levelBefore then
		Remotes.Notify:FireClient(player, string.format("LEVEL UP! You're now an Lv %d angler. +%s coins", levelAfter, Format.Number(levelAfter * Level.CoinsPerLevel)), "rare")
	end
	FishingService.ShowOff(player, caught)
	TutorialService.Event(player, "Catch")
	announce(player, fish, caught)

	local data = DataService.Get(player)
	local runtime = DataService.GetRuntime(player)
	if data and runtime and #data.bag >= runtime.bagSize and ShopService.HasPass(player, "AutoSell") then
		EconomyService.SellAll(player, true)
	end
end

-- The player holds the fish up over their head for everyone to see
function FishingService.ShowOff(player, caught)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local model = head and FishModel.Build(caught.id, caught.weight, caught.shiny)
	if not model then
		return
	end
	local length = FishModel.LengthFor(caught.weight)
	local body = model.PrimaryPart
	model:PivotTo(head.CFrame * CFrame.new(0, 1.2 + length * 0.25, 0) * CFrame.Angles(0, math.rad(90), 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = body
	weld.Parent = body
	model.Parent = character
	task.delay(2.5, function()
		model:Destroy()
	end)
end

-- Builds the rod tool from the player's equipped rod and rod skin
local function buildRod(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local rod = Rods.ById[data.equippedRod] or Rods.ById[Rods.Default]

	local tool = Instance.new("Tool")
	tool.Name = ROD_NAME
	tool.ToolTip = rod.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true

	local length = 7
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.25, length, 0.25)
	handle.CanCollide = false
	handle.Massless = true
	handle.Color = rod.color
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool

	local tip = Instance.new("Attachment")
	tip.Name = "Tip"
	tip.Position = Vector3.new(0, length / 2, 0)
	tip.Parent = handle

	-- Hold the rod near its bottom end, tilted forward.
	-- If the rod ever points the wrong way, change ROD_TILT (e.g. to -50).
	local ROD_TILT = 50
	tool.Grip = CFrame.new(0, -length / 2 + 0.6, 0) * CFrame.Angles(math.rad(ROD_TILT), 0, 0)

	CosmeticService.StyleRod(player, handle)
	return tool
end

local function giveRod(player)
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack then
		return
	end
	local character = player.Character
	local wasEquipped = character and character:FindFirstChild(ROD_NAME) ~= nil
	for _, container in ipairs({ backpack, character }) do
		local old = container and container:FindFirstChild(ROD_NAME)
		if old then
			old:Destroy()
		end
	end
	local tool = buildRod(player)
	if not tool then
		return
	end
	if wasEquipped and character then
		tool.Parent = character
	else
		tool.Parent = backpack
	end
end

function FishingService.GiveRod(player)
	clearCast(player)
	giveRod(player)
end

function FishingService.Start()
	zoneParts = fishingZoneParts()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Hotspot") then
			table.insert(hotspots, item)
		end
	end
	Workspace.DescendantAdded:Connect(function(item)
		if item:IsA("BasePart") and item:GetAttribute("FishingZone") then
			table.insert(zoneParts, item)
		elseif item:IsA("BasePart") and item:GetAttribute("Hotspot") then
			table.insert(hotspots, item)
		end
	end)

	-- Walking away from your line reels it in
	task.spawn(function()
		while true do
			task.wait(0.3)
			for player, cast in pairs(casts) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root or (root.Position - cast.origin).Magnitude > WANDER_LIMIT then
					lose(player, cast, "walked")
				end
			end
		end
	end)

	Remotes.Cast.OnServerInvoke = function(player, target)
		return onCast(player, target)
	end
	Remotes.Hook.OnServerEvent:Connect(onHook)
	Remotes.Reel.OnServerEvent:Connect(onReel)
	Remotes.CancelCast.OnServerEvent:Connect(function(player)
		clearCast(player)
	end)

	DataService.OnLoaded(function(player)
		player.CharacterAdded:Connect(function()
			clearCast(player)
			task.defer(giveRod, player)
		end)
		task.spawn(function()
			if DataService.WaitFor(player) and player.Character then
				giveRod(player)
			end
		end)
	end)

	-- Rebuild the rod when the player equips a new rod or rod skin
	local rodLooks = {}
	DataService.OnChanged(function(player, data)
		local look = data.equippedRod .. "|" .. tostring(data.cosmetics.equipped.rodSkin)
		if rodLooks[player] ~= nil and rodLooks[player] ~= look then
			FishingService.GiveRod(player)
		end
		rodLooks[player] = look
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearCast(player)
		lastCast[player] = nil
		rodLooks[player] = nil
	end)
end

return FishingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds a simple starter world (hub island + 3 fishing islands) when the place
-- has no folder called "Map" in Workspace. That means the game is playable the
-- moment you press Play. To use your own scenery later, see docs/SETUP_GUIDE.md:
-- the game only cares about parts with these attributes:
--   FishingZone = "shallows"   invisible flat part on the water surface
--   ZoneGate    = "mangroves"  wall that blocks a locked zone
--   ZoneSpawn   = "frostbite"  where the teleporter drops players
--   Station     = "Sell" / "Rods" / "Bait" / "Bounties" / "Leaderboard" / "EventBoard"
--   VipDoor     = true         door only VIP players can walk through
--   Hotspot     = true         bubbling spot: bites come sooner when you cast near it
--   Npc         = "OldPete"    where a shopkeeper stands (see NpcService)
--   GuideTarget = "Dock"       where Old Pete's guide arrow points

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Zones = require(Shared.Zones)
local Format = require(Shared.Format)

local MapBuilder = {}

local GROUND_Y = 3

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function sign(parentPart, text, face, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parentPart
	return label
end

local function prompt(parentPart, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.Parent = parentPart
	return p
end

local function island(folder, name, center, size, topColor, topMaterial)
	part({
		Name = name .. "Beach",
		Size = Vector3.new(size.X + 16, 6, size.Z + 16),
		Position = Vector3.new(center.X, GROUND_Y - 4, center.Z),
		Material = Enum.Material.Sand,
		Color = Color3.fromRGB(235, 215, 160),
		Parent = folder,
	})
	part({
		Name = name .. "Ground",
		Size = Vector3.new(size.X, 1, size.Z),
		Position = Vector3.new(center.X, GROUND_Y - 0.5, center.Z),
		Material = topMaterial or Enum.Material.Grass,
		Color = topColor,
		Parent = folder,
	})
end

local function tree(folder, position, leafColor, random)
	local height = random:NextNumber(10, 16)
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 2, 2),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 80, 50),
		Parent = folder,
	})
	part({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * random:NextNumber(8, 12),
		Position = position + Vector3.new(0, height + 2, 0),
		Material = Enum.Material.Grass,
		Color = leafColor,
		CanCollide = false,
		Parent = folder,
	})
end

local function stall(folder, name, position, color, title)
	local model = Instance.new("Model")
	model.Name = name
	local counter = part({
		Name = "Counter",
		Size = Vector3.new(14, 4, 4),
		Position = position + Vector3.new(0, 2, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(160, 110, 70),
		Parent = model,
	})
	for _, x in ipairs({ -6.5, 6.5 }) do
		part({
			Name = "Post",
			Size = Vector3.new(1, 10, 1),
			Position = position + Vector3.new(x, 5, -3),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(110, 80, 50),
			Parent = model,
		})
	end
	part({
		Name = "Roof",
		Size = Vector3.new(16, 1, 8),
		Position = position + Vector3.new(0, 10.5, -1.5),
		Material = Enum.Material.Fabric,
		Color = color,
		Parent = model,
	})
	local board = part({
		Name = "Sign",
		Size = Vector3.new(12, 3, 0.5),
		Position = position + Vector3.new(0, 12.5, 2),
		Color = Color3.fromRGB(60, 40, 30),
		Parent = model,
	})
	sign(board, title, Enum.NormalId.Front)
	sign(board, title, Enum.NormalId.Back)
	model.Parent = folder
	return counter
end

local function board(folder, name, cframe, size, station)
	local p = part({
		Name = name,
		Size = size,
		CFrame = cframe,
		Color = Color3.fromRGB(30, 40, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p:SetAttribute("Station", station)
	return p
end

local function lamp(folder, position)
	part({ Name = "LampPost", Size = Vector3.new(0.6, 9, 0.6), Position = position + Vector3.new(0, 4.5, 0), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal, Parent = folder })
	local bulb = part({ Name = "LampBulb", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.4, Position = position + Vector3.new(0, 9.4, 0), Color = Color3.fromRGB(255, 220, 150), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 210, 150)
	light.Parent = bulb
end

local function crate(folder, position, random)
	local size = random:NextNumber(2.5, 4)
	part({ Name = "Crate", Size = Vector3.one * size, CFrame = CFrame.new(position + Vector3.new(0, size / 2, 0)) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(170, 125, 75), Parent = folder })
end

local function barrel(folder, position)
	part({ Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.5, 2.6, 2.6), CFrame = CFrame.new(position + Vector3.new(0, 1.75, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Wood, Color = Color3.fromRGB(120, 80, 45), Parent = folder })
end

-- Bubbles on the water where fish gather
local function hotspot(folder, position)
	local spot = part({ Name = "Hotspot", Size = Vector3.new(8, 0.2, 8), Position = Vector3.new(position.X, 0.2, position.Z), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = folder })
	spot:SetAttribute("Hotspot", true)
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Color = ColorSequence.new(Color3.fromRGB(220, 250, 255))
	bubbles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1.2) })
	bubbles.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	bubbles.Lifetime = NumberRange.new(0.6, 1.2)
	bubbles.Speed = NumberRange.new(2, 4)
	bubbles.SpreadAngle = Vector2.new(25, 25)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Rate = 14
	bubbles.Parent = spot
	local ring = Instance.new("ParticleEmitter")
	ring.Texture = "rbxasset://textures/particles/smoke_main.dds"
	ring.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	ring.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 5) })
	ring.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	ring.Lifetime = NumberRange.new(1.5)
	ring.Speed = NumberRange.new(0)
	ring.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
	ring.EmissionDirection = Enum.NormalId.Top
	ring.Rate = 1.5
	ring.Parent = spot
	return spot
end

-- A wooden dock sticking out over the water, with a sign, a lantern and a
-- bubbling hotspot off the end. direction is a flat unit vector.
local function dock(folder, start, direction, length, guideTarget)
	local finish = start + direction * length
	local center = (start + finish) / 2
	local look = CFrame.lookAt(Vector3.new(center.X, GROUND_Y - 0.5, center.Z), Vector3.new(finish.X, GROUND_Y - 0.5, finish.Z))
	part({ Name = "Dock", Size = Vector3.new(8, 1, length), CFrame = look, Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(160, 115, 70), Parent = folder })
	for i = 0, math.floor(length / 8) do
		for _, side in ipairs({ -3.6, 3.6 }) do
			local at = look * CFrame.new(side, -3, -length / 2 + i * 8)
			part({ Name = "DockPost", Size = Vector3.new(0.8, 7, 0.8), CFrame = at, Material = Enum.Material.Wood, Color = Color3.fromRGB(100, 70, 45), Parent = folder })
		end
	end
	local signPost = part({ Name = "DockSign", Size = Vector3.new(7, 2.4, 0.4), CFrame = look * CFrame.new(0, 5, length / 2 - 0.5) * CFrame.new(0, 0, 0), Color = Color3.fromRGB(60, 40, 30), Parent = folder })
	sign(signPost, "FISHING DOCK", Enum.NormalId.Back, Color3.fromRGB(255, 230, 160))
	sign(signPost, "FISHING DOCK", Enum.NormalId.Front, Color3.fromRGB(255, 230, 160))
	for _, side in ipairs({ -3.6, 3.6 }) do
		part({ Name = "SignPole", Size = Vector3.new(0.4, 6.5, 0.4), CFrame = look * CFrame.new(side, 3, length / 2 - 0.5), Color = Color3.fromRGB(100, 70, 45), Parent = folder })
	end
	lamp(folder, Vector3.new(finish.X, GROUND_Y, finish.Z) - direction * 1.5 + look.RightVector * 3.4)

	local endMarker = part({ Name = "DockEnd", Size = Vector3.new(4, 1, 4), Position = Vector3.new(finish.X, GROUND_Y + 0.5, finish.Z) - direction * 3, Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	if guideTarget then
		endMarker:SetAttribute("GuideTarget", guideTarget)
	end
	hotspot(folder, finish + direction * 10)
end

local function boat(folder, position, angle, color)
	local base = CFrame.new(position.X, 0.6, position.Z) * CFrame.Angles(0, angle, 0)
	part({ Name = "Hull", Size = Vector3.new(6, 2, 12), CFrame = base, Material = Enum.Material.WoodPlanks, Color = color, Parent = folder })
	local bow = Instance.new("WedgePart")
	bow.Anchored = true
	bow.Size = Vector3.new(6, 2, 4)
	bow.CFrame = base * CFrame.new(0, 0, -8) * CFrame.Angles(0, math.pi, 0)
	bow.Material = Enum.Material.WoodPlanks
	bow.Color = color
	bow.Parent = folder
	part({ Name = "Bench", Size = Vector3.new(5.6, 0.5, 1.5), CFrame = base * CFrame.new(0, 1, 2), Material = Enum.Material.Wood, Color = Color3.fromRGB(140, 100, 60), Parent = folder })
	part({ Name = "Mast", Size = Vector3.new(0.5, 10, 0.5), CFrame = base * CFrame.new(0, 5.5, -2), Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 80, 50), Parent = folder })
	part({ Name = "Sail", Size = Vector3.new(0.2, 6, 5), CFrame = base * CFrame.new(0, 6.5, 0.5), Material = Enum.Material.Fabric, Color = Color3.fromRGB(245, 240, 225), CanCollide = false, Parent = folder })
end

local function lighthouse(folder, position)
	for i = 0, 4 do
		part({
			Name = "LighthouseBand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(8, 10 - i * 0.8, 10 - i * 0.8),
			CFrame = CFrame.new(position + Vector3.new(0, 4 + i * 8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = i % 2 == 0 and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(200, 50, 50),
			Parent = folder,
		})
	end
	local lamp = part({ Name = "LighthouseLamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 5, Position = position + Vector3.new(0, 42.5, 0), Color = Color3.fromRGB(255, 240, 170), Material = Enum.Material.Neon, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 2
	light.Parent = lamp
	part({ Name = "LighthouseRoof", Size = Vector3.new(7, 1, 7), Position = position + Vector3.new(0, 45.5, 0), Color = Color3.fromRGB(60, 60, 70), Parent = folder })
end

-- Where a shopkeeper stands. By default they face +Z (the front of the stalls).
local function npcSpot(folder, npc, position, turn)
	local spot = part({ Name = npc .. "Spot", Size = Vector3.new(2, 1, 2), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, turn or math.pi, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	spot:SetAttribute("Npc", npc)
end

function MapBuilder.Build()
	if Workspace:FindFirstChild("Map") then
		return -- the creator made their own map
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map
	local fishing = Instance.new("Folder")
	fishing.Name = "FishingZones"
	fishing.Parent = map

	local random = Random.new(42)

	-- Ocean
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(350, -22, 0), Vector3.new(1300, 8, 700), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(350, -9, 0), Vector3.new(1300, 18, 700), Enum.Material.Water)
	terrain.WaterColor = Color3.fromRGB(40, 150, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.15

	-- Hub island
	island(scenery, "Hub", Vector3.new(0, 0, 0), Vector3.new(140, 0, 140), Color3.fromRGB(110, 190, 90))
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "HubSpawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(10, 1, 10)
	spawnLocation.Position = Vector3.new(0, GROUND_Y + 0.5, 30)
	spawnLocation.Material = Enum.Material.Wood
	spawnLocation.Color = Color3.fromRGB(190, 150, 100)
	spawnLocation.Duration = 0
	spawnLocation.Parent = map

	local hubSpawn = part({ Name = "HubTeleport", Size = Vector3.new(4, 1, 4), Position = Vector3.new(0, GROUND_Y + 0.5, 20), Transparency = 1, CanCollide = false, Parent = map })
	hubSpawn:SetAttribute("ZoneSpawn", "hub")

	local sellCounter = stall(scenery, "FishMarket", Vector3.new(-35, GROUND_Y, -25), Color3.fromRGB(60, 140, 220), "FISH MARKET")
	sellCounter:SetAttribute("Station", "Sell")
	prompt(sellCounter, "Sell fish", "Fish Market")

	local rodCounter = stall(scenery, "RodShop", Vector3.new(35, GROUND_Y, -25), Color3.fromRGB(220, 120, 50), "ROD SHOP")
	rodCounter:SetAttribute("Station", "Rods")
	prompt(rodCounter, "Browse rods", "Rod Shop")

	local baitCounter = stall(scenery, "BaitShop", Vector3.new(35, GROUND_Y, 8), Color3.fromRGB(120, 190, 80), "BAIT & TACKLE")
	baitCounter:SetAttribute("Station", "Bait")
	prompt(baitCounter, "Buy & make bait", "Bait & Tackle")

	local bountyBoard = board(map, "BountyBoard", CFrame.new(-30, GROUND_Y + 6, 48), Vector3.new(14, 10, 1), "Bounties")
	bountyBoard.Color = Color3.fromRGB(120, 85, 55)
	bountyBoard.Material = Enum.Material.WoodPlanks
	sign(bountyBoard, "OLD PETE'S\nBOUNTIES", Enum.NormalId.Front, Color3.fromRGB(255, 230, 160))
	sign(bountyBoard, "OLD PETE'S\nBOUNTIES", Enum.NormalId.Back, Color3.fromRGB(255, 230, 160))
	prompt(bountyBoard, "Check bounties", "Bounty Board")

	board(map, "GlobalBoard", CFrame.new(0, GROUND_Y + 10, -60), Vector3.new(28, 18, 1), "Leaderboard")
	board(map, "EventBoard", CFrame.new(-55, GROUND_Y + 7, 25) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(20, 12, 1), "EventBoard")

	-- The water all around the hub is part of Sunny Shallows, so new players can fish right away
	local hubWater = part({ Name = "HubWater", Size = Vector3.new(260, 1, 600), Position = Vector3.new(0, 0.5, 0), Transparency = 1, CanCollide = false, CanTouch = false, Parent = fishing })
	hubWater:SetAttribute("FishingZone", "shallows")

	dock(scenery, Vector3.new(-30, 0, 78), Vector3.new(0, 0, 1), 30, "Dock")
	dock(scenery, Vector3.new(-78, 0, -5), Vector3.new(-1, 0, 0), 32)
	dock(scenery, Vector3.new(25, 0, -78), Vector3.new(0, 0, -1), 32)
	for _, at in ipairs({ Vector3.new(-100, 0, 60), Vector3.new(95, 0, 70), Vector3.new(-95, 0, -80) }) do
		hotspot(scenery, at)
	end
	boat(scenery, Vector3.new(-42, 0, 98), math.rad(8), Color3.fromRGB(70, 120, 200))
	boat(scenery, Vector3.new(-100, 0, 8), math.rad(95), Color3.fromRGB(200, 80, 70))
	lighthouse(scenery, Vector3.new(-62, GROUND_Y, -62))

	npcSpot(scenery, "Marina", Vector3.new(-35, GROUND_Y, -27.6))
	npcSpot(scenery, "Rodney", Vector3.new(35, GROUND_Y, -27.6))
	npcSpot(scenery, "TackleTom", Vector3.new(35, GROUND_Y, 5.4))
	npcSpot(scenery, "OldPete", Vector3.new(-20, GROUND_Y, 46), math.rad(-50))

	-- Paths, lamps and clutter so the hub feels lived in
	for _, path in ipairs({
		{ Vector3.new(0, 0, -15), Vector3.new(8, 0.2, 90) },
		{ Vector3.new(0, 0, -10), Vector3.new(110, 0.2, 8) },
		{ Vector3.new(-15, 0, 63), Vector3.new(38, 0.2, 7) },
	}) do
		part({ Name = "Path", Size = path[2], Position = path[1] + Vector3.new(0, GROUND_Y + 0.05, 0), Material = Enum.Material.Pebble, Color = Color3.fromRGB(200, 185, 150), CanCollide = false, Parent = scenery })
	end
	for _, at in ipairs({ Vector3.new(6, 0, 10), Vector3.new(-6, 0, -30), Vector3.new(-20, 0, -14), Vector3.new(20, 0, -14), Vector3.new(50, 0, -5), Vector3.new(-50, 0, -5), Vector3.new(-30, 0, 66) }) do
		lamp(scenery, at + Vector3.new(0, GROUND_Y, 0))
	end
	for _, at in ipairs({ Vector3.new(-46, 0, -22), Vector3.new(-44, 0, -18), Vector3.new(44, 0, 12), Vector3.new(-36, 0, 70) }) do
		crate(scenery, at + Vector3.new(0, GROUND_Y, 0), random)
	end
	for _, at in ipairs({ Vector3.new(-25, 0, -22), Vector3.new(26, 0, 12), Vector3.new(-24, 0, 70), Vector3.new(46, 0, -22) }) do
		barrel(scenery, at + Vector3.new(0, GROUND_Y, 0))
	end

	-- VIP dock (cosmetic perk: a nice private spot by the hub)
	part({ Name = "VipDock", Size = Vector3.new(20, 1, 44), Position = Vector3.new(0, GROUND_Y - 0.5, 98), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(200, 160, 60), Parent = scenery })
	local vipDoor = part({ Name = "VipDoor", Size = Vector3.new(20, 12, 1), Position = Vector3.new(0, GROUND_Y + 6, 76.5), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Transparency = 0.5, Parent = map })
	vipDoor:SetAttribute("VipDoor", true)
	sign(vipDoor, "VIP DOCK", Enum.NormalId.Front, Color3.fromRGB(255, 240, 180))
	sign(vipDoor, "VIP DOCK", Enum.NormalId.Back, Color3.fromRGB(255, 240, 180))
	local vipWater = part({ Name = "VipWater", Size = Vector3.new(80, 1, 70), Position = Vector3.new(0, 0.5, 112), Transparency = 1, CanCollide = false, CanTouch = false, Parent = fishing })
	vipWater:SetAttribute("FishingZone", "shallows")

	for _ = 1, 14 do
		local x = random:NextNumber(-64, 64)
		local z = random:NextNumber(-64, 64)
		local clear = math.abs(z) > 8 and math.abs(x) > 12 and not (x < -45 and z < -45) and not (x < -18 and x > -42 and z > 50)
		if (math.abs(x) > 52 or math.abs(z) > 52) and clear then
			tree(scenery, Vector3.new(x, GROUND_Y, z), Color3.fromRGB(60, 160, 60), random)
		end
	end

	-- Fishing islands, one per zone, in a row going east
	local looks = {
		shallows = { ground = Color3.fromRGB(240, 220, 150), material = Enum.Material.Sand, leaves = Color3.fromRGB(90, 190, 70) },
		mangroves = { ground = Color3.fromRGB(70, 110, 60), material = Enum.Material.Grass, leaves = Color3.fromRGB(40, 90, 40) },
		frostbite = { ground = Color3.fromRGB(240, 250, 255), material = Enum.Material.Snow, leaves = Color3.fromRGB(220, 240, 255) },
	}
	local previousEdge = 78
	for index, zone in ipairs(Zones.List) do
		local centerX = 230 * index
		local look = looks[zone.id] or looks.shallows
		island(scenery, zone.name, Vector3.new(centerX, 0, 0), Vector3.new(90, 0, 90), look.ground, look.material)

		for _ = 1, 6 do
			local x = centerX + random:NextNumber(-38, 38)
			local z = random:NextNumber(-38, 38)
			if math.abs(z) > 12 then
				tree(scenery, Vector3.new(x, GROUND_Y, z), look.leaves, random)
			end
		end

		dock(scenery, Vector3.new(centerX + 15, 0, -53), Vector3.new(0, 0, -1), 26)
		hotspot(scenery, Vector3.new(centerX - 70, 0, 35))
		hotspot(scenery, Vector3.new(centerX + 65, 0, 50))
		hotspot(scenery, Vector3.new(centerX - 20, 0, 80))

		local zoneSign = part({ Name = "ZoneSign", Size = Vector3.new(24, 6, 1), Position = Vector3.new(centerX, GROUND_Y + 14, -40), Color = Color3.fromRGB(30, 40, 60), Parent = scenery })
		sign(zoneSign, zone.name, Enum.NormalId.Front, zone.color)
		sign(zoneSign, zone.name, Enum.NormalId.Back, zone.color)

		-- Bridge from the previous island
		local islandEdge = centerX - 53
		local bridgeLength = islandEdge - previousEdge
		part({
			Name = "Bridge",
			Size = Vector3.new(bridgeLength, 1, 10),
			Position = Vector3.new(previousEdge + bridgeLength / 2, GROUND_Y - 0.5, 0),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 110, 70),
			Parent = scenery,
		})
		previousEdge = centerX + 53

		if zone.price > 0 then
			local gate = part({
				Name = zone.name .. "Gate",
				Size = Vector3.new(2, 14, 12),
				Position = Vector3.new(islandEdge - bridgeLength + 6, GROUND_Y + 7, 0),
				Color = zone.color,
				Material = Enum.Material.ForceField,
				Parent = map,
			})
			gate:SetAttribute("ZoneGate", zone.id)
			local text = zone.name .. "\n" .. Format.Number(zone.price) .. " coins"
			sign(gate, text, Enum.NormalId.Left)
			sign(gate, text, Enum.NormalId.Right)
			prompt(gate, "Unlock", zone.name, 14)
		end

		local zoneSpawn = part({ Name = zone.name .. "Spawn", Size = Vector3.new(4, 1, 4), Position = Vector3.new(centerX, GROUND_Y + 0.5, 0), Transparency = 1, CanCollide = false, Parent = map })
		zoneSpawn:SetAttribute("ZoneSpawn", zone.id)

		-- The water around this island counts as this zone
		local water = part({
			Name = zone.name .. "Water",
			Size = Vector3.new(225, 1, 600),
			Position = Vector3.new(centerX, 0.5, 0),
			Transparency = 1,
			CanCollide = false,
			CanTouch = false,
			Parent = fishing,
		})
		water:SetAttribute("FishingZone", zone.id)
	end

	-- Mist over the mangroves
	local fog = Instance.new("Part")
	fog.Name = "MangroveMist"
	fog.Anchored = true
	fog.CanCollide = false
	fog.CanQuery = false
	fog.Transparency = 1
	fog.Size = Vector3.new(120, 1, 120)
	fog.Position = Vector3.new(460, GROUND_Y + 2, 0)
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(220, 235, 220))
	mist.Transparency = NumberSequence.new(0.85)
	mist.Size = NumberSequence.new(14)
	mist.Lifetime = NumberRange.new(8, 12)
	mist.Rate = 6
	mist.Speed = NumberRange.new(1, 2)
	mist.Parent = fog
	fog.Parent = scenery

	map.Parent = Workspace
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">NpcService</string><ProtectedString name="Source"><![CDATA[-- Shopkeepers and Old Pete. They stand on parts with an "Npc" attribute
-- (MapBuilder places them at each stall) and face the way that part faces.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local NpcService = {}

local SKIN = Color3.fromRGB(234, 184, 146)

local LOOKS = {
	OldPete = { name = "Old Pete", role = "Bounties", shirt = Color3.fromRGB(40, 60, 110), pants = Color3.fromRGB(90, 70, 50), hat = Color3.fromRGB(240, 200, 60), beard = true },
	Marina = { name = "Marina", role = "Fish Market", shirt = Color3.fromRGB(40, 160, 170), pants = Color3.fromRGB(50, 50, 70), hat = Color3.fromRGB(210, 60, 60) },
	TackleTom = { name = "Tackle Tom", role = "Bait & Tackle", shirt = Color3.fromRGB(90, 150, 70), pants = Color3.fromRGB(70, 60, 50), hat = Color3.fromRGB(60, 90, 50) },
	Rodney = { name = "Rodney", role = "Rod Shop", shirt = Color3.fromRGB(220, 120, 50), pants = Color3.fromRGB(60, 60, 60), hat = Color3.fromRGB(30, 30, 30) },
}

local function accessory(model, head, name, size, offset, color, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.CanCollide = false
	p.Massless = true
	p.Shape = shape or Enum.PartType.Block
	p.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
end

local function makeNpc(spot)
	local look = LOOKS[spot:GetAttribute("Npc")]
	if not look then
		return
	end
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = SKIN
	description.LeftArmColor = SKIN
	description.RightArmColor = SKIN
	description.TorsoColor = look.shirt
	description.LeftLegColor = look.pants
	description.RightLegColor = look.pants

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[NpcService] Couldn't create " .. look.name .. ": " .. tostring(model))
		return
	end
	model.Name = look.name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = look.name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local root = model:FindFirstChild("HumanoidRootPart")
	root.Anchored = true

	local height = humanoid.HipHeight + root.Size.Y / 2
	model:PivotTo(CFrame.new(spot.Position + Vector3.new(0, spot.Size.Y / 2 + height, 0)) * spot.CFrame.Rotation)

	local head = model:FindFirstChild("Head")
	if head then
		local brim = CFrame.new(0, head.Size.Y / 2 + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90))
		accessory(model, head, "HatBrim", Vector3.new(0.15, 2, 2), brim, look.hat, Enum.PartType.Cylinder)
		accessory(model, head, "HatTop", Vector3.new(1.1, 0.5, 1.1), CFrame.new(0, head.Size.Y / 2 + 0.35, 0), look.hat)
		if look.beard then
			accessory(model, head, "Beard", Vector3.new(0.9, 0.5, 0.3), CFrame.new(0, -head.Size.Y / 2 + 0.05, -head.Size.Z / 2), Color3.fromRGB(235, 235, 235))
		end

		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.fromOffset(200, 50)
		tag.StudsOffset = Vector3.new(0, 2.8, 0)
		tag.MaxDistance = 80
		local name = Instance.new("TextLabel")
		name.Size = UDim2.fromScale(1, 0.6)
		name.BackgroundTransparency = 1
		name.Text = look.name
		name.TextScaled = true
		name.Font = Enum.Font.FredokaOne
		name.TextColor3 = Color3.new(1, 1, 1)
		name.TextStrokeTransparency = 0.3
		name.Parent = tag
		local role = name:Clone()
		role.Position = UDim2.fromScale(0, 0.6)
		role.Size = UDim2.fromScale(1, 0.4)
		role.Text = look.role
		role.TextColor3 = Color3.fromRGB(255, 220, 120)
		role.Parent = tag
		tag.Parent = head
	end

	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	model:SetAttribute("NpcId", spot:GetAttribute("Npc"))
	model.Parent = Workspace
end

function NpcService.Start()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Npc") then
			task.spawn(makeNpc, item)
		end
	end
end

return NpcService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: game passes (VIP, Auto Sell, Big Bag, Teleporter) and
-- cosmetic developer products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

local function applyPassEffects(runtime)
	runtime.bagSize = runtime.passes.BigBag and Config.BigBagSize or Config.BagSize
end

function ShopService.HasPass(player, passId)
	local runtime = DataService.GetRuntime(player)
	return runtime ~= nil and runtime.passes ~= nil and runtime.passes[passId] == true
end

local function checkPasses(player, runtime)
	runtime.passes = {}
	local testing = RunService:IsStudio() and Config.TestPassesInStudio
	for _, pass in ipairs(Shop.Passes) do
		if testing then
			runtime.passes[pass.id] = true
		elseif pass.gamePassId ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.gamePassId)
			end)
			runtime.passes[pass.id] = ok and owns or false
		end
	end
	applyPassEffects(runtime)
end

local function onPassPurchased(player, gamePassId, purchased)
	if not purchased then
		return
	end
	for _, pass in ipairs(Shop.Passes) do
		if pass.gamePassId == gamePassId and pass.gamePassId ~= 0 then
			DataService.Update(player, function(_, runtime)
				runtime.passes[pass.id] = true
				applyPassEffects(runtime)
			end)
			Remotes.Notify:FireClient(player, "Thanks for buying " .. pass.name .. "!", "success")
		end
	end
end

-- Roblox calls this for every developer product purchase. It must only return
-- PurchaseGranted once the item is given AND saved, otherwise Roblox retries later.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local item = Shop.CosmeticByProductId[receipt.ProductId]
	if not item then
		warn("[ShopService] Unknown product id " .. tostring(receipt.ProductId) .. " - add it to Shop.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.Get(player)
	if data.purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	DataService.Update(player, function(saved)
		saved.purchases[receipt.PurchaseId] = true
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)

	if not DataService.SaveNow(player) then
		-- Keep the item, Roblox will call again and the purchase id stops a double grant
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "You got " .. item.name .. "! It's equipped.", "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	DataService.OnLoaded(function(player, _, runtime)
		checkPasses(player, runtime)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[-- Moves players through Old Pete's first-day guide (see Shared/Tutorial).
-- Other services call TutorialService.Event(player, "Cast") etc.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)
local Bait = require(Shared.Bait)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local TutorialService = {}

function TutorialService.Event(player, event)
	local data = DataService.Get(player)
	if not data or data.tutorial >= Tutorial.Done then
		return
	end
	local step = Tutorial.Steps[data.tutorial]
	if not step or step.event ~= event then
		return
	end
	local finished = data.tutorial + 1 >= Tutorial.Done
	DataService.Update(player, function(saved)
		saved.tutorial += 1
		if finished then
			saved.coins += Tutorial.RewardCoins
			local reward = Tutorial.RewardBait
			saved.bait.owned[reward.id] = (saved.bait.owned[reward.id] or 0) + reward.amount
		end
	end)
	if finished then
		Remotes.Notify:FireClient(player, string.format("Old Pete: You're a natural! Here's %s coins and %d %s. Good luck out there!", Format.Number(Tutorial.RewardCoins), Tutorial.RewardBait.amount, Bait.ById[Tutorial.RewardBait.id].name), "success")
	end
end

function TutorialService.Start()
	-- The "take out your rod" step: watch for the rod appearing in the character
	DataService.OnLoaded(function(player)
		local function watch(character)
			character.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					TutorialService.Event(player, "EquipRod")
				end
			end)
		end
		if player.Character then
			watch(player.Character)
		end
		player.CharacterAdded:Connect(watch)
	end)
end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- Connects the world to the game: shop and market prompts, zone gates,
-- the global leaderboard board and the weekly event board.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local TutorialService = require(script.Parent.TutorialService)

local WorldService = {}

local LEADERBOARD_REFRESH = 120

local function hookPrompt(prompt)
	local holder = prompt.Parent
	if not holder then
		return
	end
	local station = holder:GetAttribute("Station")
	local gateZone = holder:GetAttribute("ZoneGate")
	local panels = { Sell = "Market", Rods = "Rods", Bait = "Bait", Bounties = "Bounties" }
	if station and panels[station] then
		prompt.Triggered:Connect(function(player)
			Remotes.OpenPanel:FireClient(player, panels[station])
			if station == "Bounties" then
				TutorialService.Event(player, "Bounties")
			end
		end)
	elseif gateZone then
		prompt.Triggered:Connect(function(player)
			local ok, message = EconomyService.UnlockZone(player, gateZone)
			if not ok and message then
				Remotes.Notify:FireClient(player, message, "warning")
			end
		end)
	end
end

local function makeBoardFace(boardPart, titleText, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = gui
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.Text = titleText
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = Color3.fromRGB(255, 220, 120)
	title.Parent = gui
	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.Position = UDim2.new(0, 0, 0.18, 0)
	body.Size = UDim2.new(1, 0, 0.8, 0)
	body.BackgroundTransparency = 1
	body.Text = "Loading..."
	body.TextScaled = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Font = Enum.Font.GothamMedium
	body.TextColor3 = Color3.new(1, 1, 1)
	body.Parent = gui
	gui.Parent = boardPart
	return body
end

-- Boards show the same text on both sides. Returns a function that sets the text.
local function makeBoardGui(boardPart, titleText)
	local front = makeBoardFace(boardPart, titleText, Enum.NormalId.Front)
	local back = makeBoardFace(boardPart, titleText, Enum.NormalId.Back)
	return function(text)
		front.Text = text
		back.Text = text
	end
end

local function findStation(name)
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == name then
			return item
		end
	end
	return nil
end

local nameCache = {}
local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function runLeaderboard(boardPart)
	local setText = makeBoardGui(boardPart, "Most Fish Caught")
	local store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	while true do
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok then
			local lines = {}
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				table.insert(lines, string.format("%d. %s  -  %s", rank, nameFor(tonumber(entry.key)), Format.Number(entry.value)))
			end
			setText(#lines > 0 and table.concat(lines, "\n") or "No catches yet. Be the first!")
		else
			setText("Leaderboard unavailable right now.")
		end
		task.wait(LEADERBOARD_REFRESH)
	end
end

local function runEventBoard(boardPart)
	local setText = makeBoardGui(boardPart, "This Week's Legend")
	while true do
		local fish, weekLeft = Events.GetEventFish()
		local weather, weatherLeft = Events.GetWeather()
		local zone = Zones.ById[fish.zone]
		setText(string.format(
			"%s\nonly in %s\nends in %s\n\nWeather: %s\n%s\n(changes in %s)",
			fish.name,
			zone and zone.name or fish.zone,
			Format.Duration(weekLeft),
			weather.name,
			weather.description,
			Format.Duration(weatherLeft)
		))
		task.wait(1)
	end
end

function WorldService.Start()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("ProximityPrompt") then
			hookPrompt(item)
		end
	end
	Workspace.DescendantAdded:Connect(function(item)
		if item:IsA("ProximityPrompt") then
			task.defer(hookPrompt, item)
		end
	end)

	local leaderboard = findStation("Leaderboard")
	if leaderboard then
		task.spawn(runLeaderboard, leaderboard)
	end
	local eventBoard = findStation("EventBoard")
	if eventBoard then
		task.spawn(runEventBoard, eventBoard)
	end
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000028"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000027"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000026"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Dig Legends player script. Builds the screen and starts fishing controls.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = require(script.UI)
local Notifications = require(script.Notifications)
local CameraController = require(script.CameraController)
local Panels = require(script.Panels)
local Hud = require(script.Hud)
local Fishing = require(script.Fishing)
local World = require(script.World)
local Guide = require(script.Guide)

local player = Players.LocalPlayer

local screenGui = UI.new("ScreenGui", {
	Name = "DigLegendsUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Shrink the whole UI on small screens (phones)
local scale = UI.new("UIScale", { Parent = screenGui })
local function rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 700), 0.55, 1.2)
	end
end
while not Workspace.CurrentCamera do
	task.wait()
end
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- The reel minigame gets its own unscaled screen so its tap area covers everything
local fishingGui = UI.new("ScreenGui", {
	Name = "ReelFishingUI",
	ResetOnSpawn = false,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player.PlayerGui,
})

Notifications.Init(screenGui)
CameraController.Init(fishingGui)
Panels.Init(screenGui)
Hud.Init(screenGui)
Fishing.Init(fishingGui)
World.Init()
Guide.Init(screenGui)

]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- Over-the-shoulder camera for mouse players: moving the mouse turns the camera
-- and your character, like most action games. The mouse is free again whenever
-- a menu is open, or when you press Alt (press again to lock it).
-- Phones and tablets keep Roblox's normal touch camera.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.UI)

local CameraController = {}

local SENSITIVITY = 0.0035 -- radians per pixel of mouse movement
local GAMEPAD_SPEED = 3 -- radians per second at full stick
local SHOULDER = Vector3.new(1.6, 0.9, 0) -- camera sits over the right shoulder
local MIN_PITCH, MAX_PITCH = math.rad(-75), math.rad(60)
local MIN_ZOOM, MAX_ZOOM = 5, 28

local player = Players.LocalPlayer
local enabled = false
local cursorFree = false
local yaw, pitch, zoom = 0, math.rad(-15), 12
local stick = Vector2.zero
local shakeUntil, shakeAmount = 0, 0
local crosshair

function CameraController.IsActive()
	return enabled
end

function CameraController.IsLocked()
	return enabled and not cursorFree and not UI.IsWindowOpen()
end

-- Shake the camera (used when a fish thrashes)
function CameraController.Shake(amount, seconds)
	shakeAmount = math.max(shakeAmount, amount)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

-- Colors the aiming dot (nil = plain white)
function CameraController.SetCrosshairColor(color)
	if crosshair then
		crosshair.BackgroundColor3 = color or Color3.new(1, 1, 1)
	end
end

-- The ray the player is aiming along: screen center when locked, else the mouse
function CameraController.AimRay()
	local camera = Workspace.CurrentCamera
	if CameraController.IsLocked() then
		local size = camera.ViewportSize
		return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
	end
	local mouse = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function update(dt)
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or not root or not humanoid then
		return
	end

	local locked = CameraController.IsLocked()
	UserInputService.MouseBehavior = locked and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not locked
	crosshair.Visible = locked

	if stick.Magnitude > 0.15 then
		yaw -= stick.X * GAMEPAD_SPEED * dt
		pitch = math.clamp(pitch + stick.Y * GAMEPAD_SPEED * dt, MIN_PITCH, MAX_PITCH)
	end

	-- Character faces where the camera looks
	if humanoid.Health > 0 and not humanoid.Sit then
		humanoid.AutoRotate = false
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end

	camera.CameraType = Enum.CameraType.Scriptable
	local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local focus = root.Position + Vector3.new(0, 1.5, 0)
	local offset = rotation:VectorToWorldSpace(SHOULDER + Vector3.new(0, 0, zoom))

	-- Don't let the camera go through walls
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local position = focus + offset
	local hit = Workspace:Raycast(focus, offset, params)
	if hit then
		position = hit.Position - offset.Unit * 0.5
	end

	local shake = CFrame.new()
	if os.clock() < shakeUntil then
		local s = shakeAmount
		shake = CFrame.Angles(math.rad((math.random() - 0.5) * s), math.rad((math.random() - 0.5) * s), 0)
	else
		shakeAmount = 0
	end
	camera.CFrame = CFrame.new(position) * rotation * shake
	camera.Focus = CFrame.new(focus)
end

function CameraController.Init(screenGui)
	-- Touch-only devices keep the normal camera
	if not UserInputService.MouseEnabled then
		return
	end
	enabled = true

	crosshair = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(4), UI.stroke(Color3.new(0, 0, 0), 1) })

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement and CameraController.IsLocked() then
			yaw -= input.Delta.X * SENSITIVITY
			pitch = math.clamp(pitch - input.Delta.Y * SENSITIVITY, MIN_PITCH, MAX_PITCH)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not UI.IsWindowOpen() then
			zoom = math.clamp(zoom - input.Position.Z * 2, MIN_ZOOM, MAX_ZOOM)
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
			cursorFree = not cursorFree
		end
	end)

	local function onCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then
			local look = root.CFrame.LookVector
			yaw = math.atan2(-look.X, -look.Z)
		end
	end
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	RunService:BindToRenderStep("ReelShoulderCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Fishing</string><ProtectedString name="Source"><![CDATA[-- Fishing on the player's screen.
--   1. Equip the rod and click the water to cast. The dot in the middle of the
--      screen tells you if you can fish where you're aiming. Walking reels in.
--   2. Watch the bobber. Little nibbles are fish testing the bait: don't strike!
--   3. When it plunges and "!" appears, click fast to strike, or the fish
--      steals your bait.
--   4. The fight: hold to reel. Watch the tension so the line doesn't snap, and
--      let go when the fish thrashes. Don't let go for too long or it swims off.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Fish = require(Shared.Fish)
local Fight = require(Shared.Fight)
local Format = require(Shared.Format)
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.State)
local CameraController = require(script.Parent.CameraController)
local T = UI.Theme

local Fishing = {}

local ROD_NAME = "Fishing Rod"
local WAIT_TIMEOUT = 30 -- give up if the server never answers

local MESSAGES = {
	early = "Too soon! You struck at a nibble and scared the fish away.",
	stolen = "Too slow! The fish stole your bait.",
	snapped = "SNAP! The line broke. Let go when the tension bar goes red.",
	escaped = "It got away! Don't let go for too long.",
	walked = "You walked away, so you reeled your line in.",
}

local player = Players.LocalPlayer
local screenGui
local statusLabel
local alertLabel
local aimLabel

local phase = "idle" -- idle, casting, waiting, bite, fight, done
local castId = nil
local token = 0

local sounds = {}
local function sound(name, id, volume)
	local s = Instance.new("Sound")
	s.Name = "Reel" .. name
	s.SoundId = id
	s.Volume = volume or 0.6
	s.Parent = SoundService
	sounds[name] = s
end
local function play(name, pitch)
	local s = sounds[name]
	if s then
		s.PlaybackSpeed = pitch or 1
		SoundService:PlayLocalSound(s)
	end
end

local function setStatus(text)
	statusLabel.Text = text or ""
	statusLabel.Visible = text ~= nil
end

local function flashAlert(text, color, seconds)
	alertLabel.Text = text
	alertLabel.TextColor3 = color
	alertLabel.Visible = true
	alertLabel.Size = UDim2.fromOffset(160, 160)
	TweenService:Create(alertLabel, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(220, 220) }):Play()
	local mine = os.clock()
	alertLabel:SetAttribute("Shown", mine)
	task.delay(seconds, function()
		if alertLabel:GetAttribute("Shown") == mine then
			alertLabel.Visible = false
		end
	end)
end

-- While the line is out the player stands still. Trying to walk reels it in.
local rooted = nil
local function setRooted(on)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if on and humanoid and not rooted then
		rooted = { humanoid = humanoid, speed = humanoid.WalkSpeed }
		humanoid.WalkSpeed = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	elseif not on and rooted then
		if rooted.humanoid.Parent then
			rooted.humanoid.WalkSpeed = rooted.speed > 0 and rooted.speed or 16
			rooted.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
		rooted = nil
	end
end

local function reset()
	setRooted(false)
	phase = "idle"
	castId = nil
	token += 1
	setStatus(nil)
	alertLabel.Visible = false
end

local function fishingLine()
	local bobber = Workspace:FindFirstChild(player.Name .. "Bobber")
	return bobber and bobber:FindFirstChildOfClass("Beam")
end

local function isWater(result)
	if not result then
		return false
	end
	if result.Instance == Workspace.Terrain then
		return result.Material == Enum.Material.Water
	end
	return result.Instance:GetAttribute("FishingZone") ~= nil
end

-- Where the bobber should land: where the player aims if that is water,
-- otherwise a spot in front of them.
local function castTarget(root)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = false

	local ray
	if CameraController.IsActive() then
		ray = CameraController.AimRay()
	else
		ray = player:GetMouse().UnitRay
	end
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if isWater(hit) then
		return hit.Position
	end

	local look = root.CFrame.LookVector
	local ahead = root.Position + Vector3.new(look.X, 0, look.Z).Unit * 25
	return Vector3.new(ahead.X, 0.5, ahead.Z)
end

local function cast()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	phase = "casting"
	local ok, id = pcall(function()
		return Remotes.Cast:InvokeServer(castTarget(root))
	end)
	if not ok or not id then
		reset()
		return
	end
	phase = "waiting"
	castId = id
	setRooted(true)
	play("splash", 1.2)
	setStatus("Wait for the bite (!)... don't strike at nibbles")
	token += 1
	local mine = token
	task.delay(WAIT_TIMEOUT, function()
		if token == mine and (phase == "waiting" or phase == "bite") then
			reset()
		end
	end)
end

-- Click / tap with the rod out
local function onActivated()
	if phase == "idle" then
		cast()
	elseif phase == "waiting" or phase == "bite" then
		Remotes.Hook:FireServer(castId)
		if phase == "bite" then
			setStatus("Hooked...")
		end
	end
end

local hookedTools = setmetatable({}, { __mode = "k" })
local function hookTool(tool)
	if not hookedTools[tool] then
		hookedTools[tool] = true
		tool.Activated:Connect(onActivated)
	end
end

local function watchCharacter(character)
	reset()
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == ROD_NAME then
			hookTool(child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") and child.Name == ROD_NAME and (phase == "waiting" or phase == "bite") then
			Remotes.CancelCast:FireServer()
			reset()
		end
	end)
end

------------------------------------------------------------------ The fight

local function bar(parent, y, label)
	UI.label(label, { Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(90, 22), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, ZIndex = 22, Parent = parent })
	local back = UI.new("Frame", {
		Position = UDim2.fromOffset(110, y),
		Size = UDim2.new(1, -130, 0, 22),
		BackgroundColor3 = T.Card,
		ZIndex = 22,
		Parent = parent,
	}, { UI.corner(6) })
	local fill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Good, ZIndex = 23, Parent = back }, { UI.corner(6) })
	return back, fill
end

local function startFight(id, params)
	phase = "fight"
	setStatus(nil)
	alertLabel.Visible = false
	local rarity = Fish.RarityById[params.rarity]
	local random = Random.new()
	local state = Fight.NewState(params, random)
	local holding = false
	local connections = {}
	local finished = false


	local box = UI.new("Frame", {
		Name = "Fight",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(460, 150),
		BackgroundColor3 = T.Background,
		ZIndex = 21,
		Parent = screenGui,
	}, { UI.corner(14) })
	local outline = UI.stroke(rarity.color, 3)
	outline.Parent = box
	UI.label(string.format("??? (%s)", rarity.id), { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 26), TextColor3 = rarity.color, ZIndex = 22, Parent = box })
	local _, catchFill = bar(box, 44, "Catch")
	local tensionBack, tensionFill = bar(box, 74, "Tension")
	UI.new("Frame", { Position = UDim2.fromScale(0.8, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = T.Bad, ZIndex = 24, Parent = tensionBack })
	local mood = UI.label("Hold to reel!", { Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 22), ZIndex = 22, Parent = box })
	UI.label("Hold click / tap / Space to reel", { Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 14), Font = T.BodyFont, TextColor3 = T.Muted, ZIndex = 22, Parent = box })

	local function finish(outcome)
		if finished then
			return
		end
		finished = true
		phase = "done"
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		box:Destroy()
		if outcome == "snapped" then
			CameraController.Shake(4, 0.3)
		end
		Remotes.Reel:FireServer(id, outcome)
		setStatus(outcome == "caught" and "Landing it..." or nil)
		task.delay(5, function()
			if phase == "done" and castId == id then
				reset()
			end
		end)
	end

	local function isReelInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.Space
			or input.KeyCode == Enum.KeyCode.ButtonR2
			or input.KeyCode == Enum.KeyCode.ButtonA
	end
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if isReelInput(input) and not (processed and input.UserInputType == Enum.UserInputType.Touch) then
			holding = true
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if isReelInput(input) then
			holding = false
		end
	end))

	local lastPhase = state.phase
	local clickTimer = 0
	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		state.reeling = holding
		local outcome = Fight.Step(state, params, math.min(dt, 0.1), random)

		catchFill.Size = UDim2.fromScale(math.clamp(state.progress, 0, 1), 1)
		tensionFill.Size = UDim2.fromScale(math.clamp(state.tension, 0, 1), 1)
		local danger = state.tension >= 0.8
		tensionFill.BackgroundColor3 = danger and T.Bad or (state.tension > 0.55 and T.Gold or T.Good)
		local line = fishingLine()
		if line then
			line.Color = ColorSequence.new(Color3.new(1, 1, 1):Lerp(T.Bad, state.tension))
		end

		if state.phase ~= lastPhase then
			lastPhase = state.phase
			if state.phase == "thrash" then
				play("splash", 0.8)
			end
		end
		if state.phase == "warning" then
			mood.Text = "It's about to thrash... LET GO!"
			mood.TextColor3 = T.Gold
			outline.Color = T.Gold
		elseif state.phase == "thrash" then
			mood.Text = "THRASHING! Don't reel!"
			mood.TextColor3 = T.Bad
			outline.Color = T.Bad
			CameraController.Shake(1.5 * params.strength, 0.1)
		elseif danger then
			mood.Text = "Line's too tight! Ease off!"
			mood.TextColor3 = T.Bad
			outline.Color = rarity.color
		else
			mood.Text = holding and "Reeling..." or "Hold to reel!"
			mood.TextColor3 = T.Text
			outline.Color = rarity.color
		end

		if holding then
			clickTimer -= dt
			if clickTimer <= 0 then
				clickTimer = 0.18
				play("tick", 1 + state.tension * 0.6)
			end
		end

		if outcome then
			finish(outcome)
		end
	end))
end

------------------------------------------------------------------ Aiming

local hotspots = {}
local function nearHotspot(position)
	for _, spot in ipairs(hotspots) do
		if spot.Parent and Vector3.new(spot.Position.X - position.X, 0, spot.Position.Z - position.Z).Magnitude <= 12 then
			return true
		end
	end
	return false
end

-- What happens if the player casts where they are aiming right now
local function aimInfo(root)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = false
	local ray = CameraController.IsActive() and CameraController.AimRay() or player:GetMouse().UnitRay
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if not hit then
		return "Aim at the water", T.Muted
	end
	local zoneId = hit.Instance:GetAttribute("FishingZone")
	if not zoneId then
		if hit.Instance == Workspace.Terrain and hit.Material == Enum.Material.Water then
			return "No fish out here. Try near an island", T.Muted
		end
		return "Aim at the water", T.Muted
	end
	local flat = Vector3.new(hit.Position.X - root.Position.X, 0, hit.Position.Z - root.Position.Z)
	if flat.Magnitude > Config.MaxCastDistance then
		return "Too far. Get closer to the water", T.Gold
	end
	local data = State.data
	if data and not data.zones[zoneId] then
		local zone = Zones.ById[zoneId]
		return "Locked: unlock " .. (zone and zone.name or zoneId) .. " first", T.Bad
	end
	if nearHotspot(hit.Position) then
		return "Hotspot! Click to cast (faster bites)", Color3.fromRGB(90, 230, 255)
	end
	return "Click to cast", T.Good
end

local function updateAim()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local holding = character and character:FindFirstChild(ROD_NAME)
	if phase ~= "idle" or not holding or not root then
		aimLabel.Visible = false
		CameraController.SetCrosshairColor(nil)
		return
	end
	local text, color = aimInfo(root)
	if not UserInputService.MouseEnabled then
		text = text:gsub("Click", "Tap")
	end
	aimLabel.Text = text
	aimLabel.TextColor3 = color
	aimLabel.Visible = true
	CameraController.SetCrosshairColor(color)
end

------------------------------------------------------------------ Results

local function confetti(colors)
	for _ = 1, 40 do
		local size = math.random(8, 14)
		local piece = UI.new("Frame", {
			Position = UDim2.new(math.random(), 0, 0, -20),
			Size = UDim2.fromOffset(size, size * 0.6),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = screenGui,
		})
		local fall = TweenService:Create(piece, TweenInfo.new(math.random(15, 28) / 10, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		})
		fall:Play()
		fall.Completed:Connect(function()
			piece:Destroy()
		end)
	end
end


local function showCatch(result)
	local fish = Fish.ById[result.id]
	local rarity = Fish.RarityById[fish.rarity]
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(380, 130),
		BackgroundColor3 = T.Background,
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(rarity.color, 4), UI.padding(10), UI.list(4) })
	local top = "Caught!"
	if result.isNew then
		top = "NEW FISH! Added to your Fish Book"
	elseif result.isRecord then
		top = "NEW PERSONAL RECORD!"
	end
	UI.label(top, { Size = UDim2.new(1, 0, 0, 22), TextColor3 = (result.isNew or result.isRecord) and T.Gold or T.Muted, Parent = card })
	UI.label((result.shiny and "Shiny " or "") .. fish.name, { Size = UDim2.new(1, 0, 0, 36), TextColor3 = rarity.color, Parent = card })
	if result.isNew or result.isRecord or rarity.order >= 4 then
		confetti({ rarity.color, T.Gold, Color3.new(1, 1, 1), T.Accent })
		play("ping", 1.3)
	end
	UI.label(string.format("%s  -  %s  -  %s coins  -  +%d XP", fish.rarity, Format.Weight(result.weight), Format.Number(result.value), result.xp or 0), {
		Size = UDim2.new(1, 0, 0, 22),
		Font = T.BodyFont,
		Parent = card,
	})
	task.delay(2.5, function()
		local tween = TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		card:Destroy()
	end)
end

function Fishing.Init(gui)
	screenGui = gui
	sound("splash", "rbxasset://sounds/impact_water.mp3", 0.7)
	sound("ping", "rbxasset://sounds/electronicpingshort.wav", 0.6)
	sound("tick", "rbxasset://sounds/button.wav", 0.25)

	statusLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -120),
		Size = UDim2.fromOffset(520, 30),
		Visible = false,
		TextStrokeTransparency = 0.4,
		Parent = gui,
	})
	aimLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.fromOffset(420, 22),
		Visible = false,
		TextStrokeTransparency = 0.3,
		Parent = gui,
	})
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Hotspot") then
			table.insert(hotspots, item)
		end
	end
	local aimClock = 0
	RunService.Heartbeat:Connect(function(dt)
		-- Trying to walk while the line is out reels it in
		if rooted and (phase == "waiting" or phase == "bite") and rooted.humanoid.MoveDirection.Magnitude > 0.1 then
			Remotes.CancelCast:FireServer()
			reset()
			Notifications.Show(MESSAGES.walked, "info")
		end
		aimClock += dt
		if aimClock >= 0.1 then
			aimClock = 0
			updateAim()
		end
	end)

	alertLabel = UI.label("!", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromOffset(220, 220),
		Visible = false,
		TextStrokeTransparency = 0,
		ZIndex = 30,
		Parent = gui,
	})

	if player.Character then
		watchCharacter(player.Character)
		local tool = player.Character:FindFirstChild(ROD_NAME)
		if tool then
			hookTool(tool)
		end
	end
	player.CharacterAdded:Connect(watchCharacter)

	Remotes.Nibble.OnClientEvent:Connect(function(id)
		if id == castId and phase == "waiting" then
			play("splash", 1.8)
			flashAlert("nibble...", T.Muted, 0.4)
		end
	end)

	Remotes.Bite.OnClientEvent:Connect(function(id, info)
		if id ~= castId or phase ~= "waiting" then
			return
		end
		phase = "bite"
		play("ping")
		play("splash", 0.9)
		CameraController.Shake(2, 0.2)
		flashAlert("!", T.Gold, info.window)
		setStatus("STRIKE! Click now!")
	end)

	Remotes.Fight.OnClientEvent:Connect(function(id, params)
		if id == castId then
			startFight(id, params)
		end
	end)

	Remotes.CatchResult.OnClientEvent:Connect(function(id, result, reason)
		if id ~= castId then
			return
		end
		reset()
		if result then
			showCatch(result)
		else
			Notifications.Show(MESSAGES[reason] or MESSAGES.escaped, "warning")
		end
	end)
end

return Fishing
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- Old Pete's first-day guide on screen: the current goal at the top, a golden
-- line from you to where you need to go, and Pete talking above his head.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local T = UI.Theme

local Guide = {}

local PETE_TIPS = {
	"Bring me the fish on my board and I'll pay you three times the market price!",
	"Bubbles on the water mean fish. Cast near them for quicker bites.",
	"Don't strike at nibbles! Wait for the big splash.",
	"Fish that are in demand at the market sell for double. Check Marina's stall!",
	"Tackle Tom turns your spare fish into better bait.",
	"A legendary fish visits every week. Check the event board!",
}

local player = Players.LocalPlayer
local card, cardText
local beam, beamFrom, beamTo, marker, follower
local peteBubble, peteText

local function findTarget(name)
	if not name then
		return nil
	end
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and (item:GetAttribute("GuideTarget") == name or item:GetAttribute("Station") == name) then
			return item
		end
	end
	return nil
end

local function findPete()
	for _, item in ipairs(Workspace:GetChildren()) do
		if item:IsA("Model") and item:GetAttribute("NpcId") == "OldPete" then
			return item
		end
	end
	return nil
end

local function currentStep()
	local data = State.data
	if not data or not data.tutorial or data.tutorial >= Tutorial.Done then
		return nil, nil
	end
	return Tutorial.Steps[data.tutorial], data.tutorial
end

local function update()
	local step, index = currentStep()
	card.Visible = step ~= nil
	if not step then
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	cardText.Text = string.format("Old Pete (%d/%d): %s", index, #Tutorial.Steps, step.text)

	local target = findTarget(step.target)
	if target then
		beamTo.Parent = target
		beam.Enabled = true
		marker.Adornee = target
		marker.Enabled = true
	else
		beam.Enabled = false
		marker.Enabled = false
	end
end

local function setupPete()
	peteBubble = UI.new("BillboardGui", {
		Name = "PeteSays",
		Size = UDim2.fromOffset(260, 90),
		StudsOffset = Vector3.new(0, 5.5, 0),
		MaxDistance = 70,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bubble = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = peteBubble }, { UI.corner(12), UI.padding(8) })
	peteText = UI.label("", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(30, 30, 40), Font = T.BodyFont, TextWrapped = true, Parent = bubble })

	task.spawn(function()
		local tip = 1
		while true do
			local pete = findPete()
			peteBubble.Adornee = pete and pete:FindFirstChild("Head")
			local step = currentStep()
			if step then
				peteText.Text = step.text
			else
				peteText.Text = PETE_TIPS[tip]
				tip = tip % #PETE_TIPS + 1
			end
			task.wait(step and 1 or 8)
		end
	end)
end

function Guide.Init(screenGui)
	card = UI.new("Frame", {
		Name = "GuideCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromOffset(560, 56),
		BackgroundColor3 = Color3.fromRGB(255, 244, 214),
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 3), UI.padding(8) })
	cardText = UI.label("", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(60, 40, 20), Font = T.BodyFont, TextWrapped = true, Parent = card })

	-- An invisible part that follows the player carries the start of the line
	follower = Instance.new("Part")
	follower.Name = "GuideFollower"
	follower.Anchored = true
	follower.CanCollide = false
	follower.CanQuery = false
	follower.CanTouch = false
	follower.Transparency = 1
	follower.Size = Vector3.one * 0.2
	follower.Parent = Workspace
	beamFrom = Instance.new("Attachment")
	beamFrom.Name = "GuideFrom"
	beamFrom.Parent = follower
	beamTo = Instance.new("Attachment")
	beamTo.Name = "GuideTo"
	beamTo.Position = Vector3.new(0, 3, 0)
	beam = Instance.new("Beam")
	beam.Attachment0 = beamFrom
	beam.Attachment1 = beamTo
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(T.Gold)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) })
	beam.LightEmission = 1
	beam.Enabled = false
	beam.Parent = beamFrom

	marker = UI.new("BillboardGui", {
		Name = "GuideMarker",
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local arrow = UI.label("V", { Size = UDim2.fromScale(1, 1), TextColor3 = T.Gold, TextStrokeTransparency = 0, Parent = marker })

	RunService.RenderStepped:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			follower.Position = root.Position - Vector3.new(0, 1.5, 0)
		end
		if marker.Enabled then
			marker.StudsOffset = Vector3.new(0, 6 + math.sin(os.clock() * 4) * 0.6, 0)
			arrow.TextTransparency = 0
		end
	end)

	State.Changed:Connect(update)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		update()
	end)
	update()
	setupPete()
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Always-on screen info: coins, bag, the weekly event, and the menu buttons.

local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Bait = require(Shared.Bait)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)
local CameraController = require(script.Parent.CameraController)
local T = UI.Theme

local Hud = {}

function Hud.Init(screenGui)
	-- Stats, top left
	local stats = UI.new("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(230, 160),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(10), UI.list(4) })
	local levelLine = UI.label("Lv 1 Angler", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Color3.fromRGB(150, 220, 255), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, Parent = stats })
	local xpBack = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Card, LayoutOrder = 0, Parent = stats }, { UI.corner(3) })
	local xpFill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(150, 220, 255), Parent = xpBack }, { UI.corner(3) })
	levelLine.LayoutOrder = -2
	xpBack.LayoutOrder = -1
	local coins = UI.label("0 coins", { Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = stats })
	local bag = UI.label("Bag 0/20", { Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = stats })
	local baitLine = UI.label("Bait: Bread", { Size = UDim2.new(1, 0, 0, 18), Font = T.BodyFont, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3, Parent = stats })
	local bonus = UI.label("", { Size = UDim2.new(1, 0, 0, 18), Font = T.BodyFont, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 4, Parent = stats })

	local function update(data, runtime)
		local progress, level = Level.Progress(data.xp or 0)
		levelLine.Text = string.format("Lv %d Angler", level)
		xpFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		coins.Text = Format.Number(data.coins) .. " coins"
		local size = runtime.bagSize or Config.BagSize
		bag.Text = string.format("Bag %d/%d", #data.bag, size)
		bag.TextColor3 = #data.bag >= size and T.Bad or T.Text
		local bait = Bait.ById[data.bait.equipped] or Bait.ById[Bait.Default]
		baitLine.Text = bait.free and "Bait: Bread" or string.format("Bait: %s x%d", bait.name, data.bait.owned[bait.id] or 0)
		baitLine.TextColor3 = bait.color
		if data.rebirths > 0 then
			bonus.Text = string.format("Rebirth %d: +%d%% coins", data.rebirths, math.floor((Config.SellMultiplier(data.rebirths) - 1) * 100 + 0.5))
		else
			bonus.Text = "Sell fish at the Fish Market"
		end
	end
	State.Changed:Connect(update)
	if State.data then
		update(State.data, State.runtime)
	end

	-- Event and weather banner, top center
	local banner = UI.new("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(520, 52),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(6), UI.list(2) })
	local eventLine = UI.label("", { Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.Gold, Parent = banner })
	local weatherLine = UI.label("", { Size = UDim2.new(1, 0, 0, 16), Font = T.BodyFont, TextColor3 = T.Muted, Parent = banner })
	task.spawn(function()
		while true do
			local fish, weekLeft = Events.GetEventFish()
			local zone = Zones.ById[fish.zone]
			eventLine.Text = string.format("Weekly legend: %s in %s (%s left)", fish.name, zone and zone.name or "", Format.Duration(weekLeft))
			local weather, weatherLeft = Events.GetWeather()
			weatherLine.Text = string.format("%s: %s (%s)", weather.name, weather.description, Format.Duration(weatherLeft))
			task.wait(1)
		end
	end)

	-- Menu buttons, left side, with keyboard shortcuts
	local menu = UI.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 30),
		Size = UDim2.fromOffset(130, 420),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(6) })
	local buttons = {
		{ "Bag", "Bag", Color3.fromRGB(90, 140, 220), Enum.KeyCode.Q },
		{ "Fish Book", "Book", Color3.fromRGB(80, 160, 255), Enum.KeyCode.B },
		{ "Bounties", "Bounties", Color3.fromRGB(200, 150, 70), Enum.KeyCode.N },
		{ "Rods", "Rods", Color3.fromRGB(230, 140, 60), Enum.KeyCode.R },
		{ "Shop", "Shop", Color3.fromRGB(70, 200, 110), Enum.KeyCode.P },
		{ "Travel", "Teleport", Color3.fromRGB(170, 100, 255), Enum.KeyCode.T },
		{ "Rebirth", "Rebirth", Color3.fromRGB(255, 90, 160), nil },
	}
	local shortcuts = {}
	for index, info in ipairs(buttons) do
		local keyName = info[4] and (" (" .. info[4].Name .. ")") or ""
		UI.button(info[1] .. keyName, info[3], function()
			Panels[info[2]].toggle()
		end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = index, Parent = menu })
		if info[4] then
			shortcuts[info[4]] = info[2]
		end
	end
	if CameraController.IsActive() then
		UI.label("Alt: free the mouse", { Size = UDim2.fromOffset(130, 18), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 99, Parent = menu })
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local panel = shortcuts[input.KeyCode]
		if panel then
			Panels[panel].toggle()
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Small messages that pop up on the right side of the screen.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local T = UI.Theme

local Notifications = {}

local COLORS = {
	success = T.Good,
	warning = T.Bad,
	coins = T.Gold,
	rare = Color3.fromRGB(255, 120, 200),
	info = T.Accent,
}

local container

function Notifications.Init(screenGui)
	container = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.fromOffset(320, 400),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(6) })

	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Show(text, kind)
	end)
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	local toast = UI.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Text = text,
		TextColor3 = COLORS[kind or "info"] or T.Text,
		Font = T.Font,
		TextScaled = true,
		TextWrapped = true,
		Parent = container,
	}, { UI.corner(10), UI.padding(6) })

	task.delay(4, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)

	-- Keep at most 6 on screen
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 6 then
		toasts[1]:Destroy()
	end
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- The menus: Bag, Fish Market, Bait & Tackle, Bounties, Fish Book, Rods,
-- Shop, Travel and Rebirth.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Fish = require(Shared.Fish)
local Rods = require(Shared.Rods)
local Zones = require(Shared.Zones)
local Shop = require(Shared.Shop)
local Events = require(Shared.Events)
local Bait = require(Shared.Bait)
local Market = require(Shared.Market)
local Bounties = require(Shared.Bounties)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Notifications = require(script.Parent.Notifications)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}

local function act(actionName, argument)
	local ok, message = State.Action(actionName, argument)
	if not ok and message then
		Notifications.Show(message, "warning")
	end
	return ok
end

-- Robux prices come from Roblox, so they always match the Creator Dashboard
local priceCache = {}
local function robuxPrice(id, infoType, onReady)
	local key = tostring(infoType) .. id
	if priceCache[key] then
		onReady(priceCache[key])
		return
	end
	task.spawn(function()
		-- Asks Roblox every time instead of hard-coding prices, so each player sees
		-- their own regional price
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(id, infoType)
		end)
		if not ok then
			ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, infoType)
			end)
		end
		if ok and info and info.PriceInRobux then
			priceCache[key] = info.PriceInRobux
			onReady(info.PriceInRobux)
		end
	end)
end

local function row(parent, height, order)
	return UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = T.Card,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(10) })
end

local function heading(parent, text, order)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, LayoutOrder = order, Parent = parent })
end

------------------------------------------------------------------ Bag and Fish Market
local function sortedBag(data)
	local list = table.clone(data.bag)
	table.sort(list, function(a, b)
		return a.value > b.value
	end)
	return list
end

local function hotNames(hot)
	local names = {}
	for id in pairs(hot) do
		table.insert(names, Fish.ById[id].name)
	end
	table.sort(names)
	return table.concat(names, ", ")
end

-- One row per fish. selling = true shows Sell buttons (Fish Market only).
local function fishRows(body, data, selling, startOrder)
	local hot = Market.HotFish()
	local bag = sortedBag(data)
	if #bag == 0 then
		UI.label("Your bag is empty. Go catch some fish!", { Size = UDim2.new(1, -8, 0, 26), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = startOrder, Parent = body })
		return
	end
	for index, entry in ipairs(bag) do
		local fish = Fish.ById[entry.id]
		local rarity = Fish.RarityById[fish.rarity]
		local card = row(body, 50, startOrder + index)
		local name = (entry.shiny and "Shiny " or "") .. fish.name
		UI.label(name, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.5, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color, Parent = card })
		local price = Market.Price(entry, data.rebirths, hot)
		local detail = string.format("%s  -  %s  -  %s coins%s", fish.rarity, Format.Weight(entry.weight), Format.Number(price), hot[entry.id] and "  (IN DEMAND x2)" or "")
		UI.label(detail, { Position = UDim2.fromOffset(12, 28), Size = UDim2.new(0.6, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = hot[entry.id] and T.Gold or T.Muted, Parent = card })

		local uid = tostring(entry.uid)
		UI.button(entry.favorite and "Favorite" or "Keep?", entry.favorite and T.Gold or T.Card, function()
			act("ToggleFavorite", uid)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, selling and -112 or -12, 0.5, 0), Size = UDim2.fromOffset(96, 34), Parent = card })
		if selling then
			UI.button("Sell", entry.favorite and T.Card or T.Good, function()
				act("SellFish", uid)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(90, 34), Parent = card })
		end
	end
end

local function renderBag(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local size = State.runtime.bagSize or Config.BagSize
	heading(body, string.format("Fish (%d/%d)", #data.bag, size), 1)
	UI.label("Favorites are never sold, used for bait or turned in. Sell at the Fish Market.", { Size = UDim2.new(1, -8, 0, 20), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 2, Parent = body })
	fishRows(body, data, false, 10)

	heading(body, "Bait (goes on your hook)", 1000)
	for index, bait in ipairs(Bait.List) do
		local count = bait.free and math.huge or (data.bait.owned[bait.id] or 0)
		if count > 0 then
			local card = row(body, 50, 1000 + index)
			UI.label(bait.name .. (bait.free and "" or ("  x" .. count)), { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.6, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = bait.color, Parent = card })
			UI.label(bait.description, { Position = UDim2.fromOffset(12, 28), Size = UDim2.new(0.7, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
			local equipped = data.bait.equipped == bait.id
			UI.button(equipped and "On hook" or "Use", equipped and T.Card or T.Accent, function()
				act("EquipBait", bait.id)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(110, 34), Parent = card })
		end
	end
end

local function renderMarket(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local hot, left = Market.HotFish()
	UI.label(string.format("In demand (sells for x2) for %s: %s", Format.Duration(left), hotNames(hot)), {
		Size = UDim2.new(1, -8, 0, 40),
		TextWrapped = true,
		TextColor3 = T.Gold,
		LayoutOrder = 1,
		Parent = body,
	})

	local total, count = 0, 0
	for _, entry in ipairs(data.bag) do
		if not entry.favorite then
			total += Market.Price(entry, data.rebirths, hot)
			count += 1
		end
	end
	UI.button(string.format("Sell all %d for %s coins (keeps favorites)", count, Format.Number(total)), count > 0 and T.Good or T.Card, function()
		act("SellAll")
	end, { Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 2, Parent = body })
	UI.label("Tip: keep fish that are about to be in demand, or trade them for bait and bounties.", { Size = UDim2.new(1, -8, 0, 18), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 3, Parent = body })
	fishRows(body, data, true, 10)
end

------------------------------------------------------------------ Bait & Tackle
local function fishCountByRarity(data)
	local counts = {}
	for _, entry in ipairs(data.bag) do
		if not entry.favorite then
			local rarity = Fish.ById[entry.id].rarity
			counts[rarity] = (counts[rarity] or 0) + 1
		end
	end
	return counts
end

local function renderBait(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local counts = fishCountByRarity(data)
	UI.label("Better bait = better fish. A fish that bites eats the bait, even if it gets away.", { Size = UDim2.new(1, -8, 0, 20), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 0, Parent = body })
	for index, bait in ipairs(Bait.List) do
		if not bait.free then
			local owned = data.bait.owned[bait.id] or 0
			local card = row(body, 96, index)
			UI.label(string.format("%s  (you have %d)", bait.name, owned), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.45, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = bait.color, Parent = card })
			UI.label(bait.description, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(0.45, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
			if bait.recipe then
				local parts, canCraft = {}, true
				for _, need in ipairs(bait.recipe) do
					local have = counts[need.rarity] or 0
					canCraft = canCraft and have >= need.count
					table.insert(parts, string.format("%d %s (have %d)", need.count, need.rarity, have))
				end
				UI.label(string.format("Make %d from: %s", bait.craftAmount, table.concat(parts, " + ")), { Position = UDim2.fromOffset(12, 54), Size = UDim2.new(0.62, 0, 0, 34), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Text, Parent = card })
				UI.button("Make", canCraft and T.Good or T.Card, function()
					act("CraftBait", bait.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 52), Size = UDim2.fromOffset(150, 34), Parent = card })
			end
			if bait.price then
				UI.button(string.format("Buy %d: %s", bait.buyAmount, Format.Number(bait.price)), data.coins >= bait.price and T.Accent or T.Card, function()
					act("BuyBait", bait.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(150, 34), Parent = card })
			end
			if owned > 0 then
				local equipped = data.bait.equipped == bait.id
				UI.button(equipped and "On hook" or "Use", equipped and T.Card or T.Accent, function()
					act("EquipBait", bait.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -170, 0, 10), Size = UDim2.fromOffset(90, 34), Parent = card })
			end
		end
	end
end

------------------------------------------------------------------ Bounties
local function renderBounties(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local now = os.time()
	local resetIn = 86400 - (now % 86400)
	UI.label(string.format("Old Pete pays %dx the market price, plus bait. New bounties in %s.", Bounties.RewardMultiplier, Format.Duration(resetIn)), {
		Size = UDim2.new(1, -8, 0, 22),
		Font = T.BodyFont,
		TextColor3 = T.Muted,
		LayoutOrder = 0,
		Parent = body,
	})
	for index, bounty in ipairs(data.bounties.list) do
		local fish = Fish.ById[bounty.fishId]
		local rarity = Fish.RarityById[fish.rarity]
		local have = 0
		for _, entry in ipairs(data.bag) do
			if entry.id == bounty.fishId and not entry.favorite then
				have += 1
			end
		end
		local card = row(body, 70, index)
		UI.label(string.format("Bring %d %s", bounty.count, fish.name), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.62, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color, Parent = card })
		local reward = Bounties.Reward(bounty, Config.SellMultiplier(data.rebirths))
		local zone = Zones.ById[fish.zone]
		UI.label(string.format("Have %d/%d  -  found in %s  -  reward %s coins + %d %s", math.min(have, bounty.count), bounty.count, zone and zone.name or "", Format.Number(reward), bounty.baitAmount, Bait.ById[bounty.bait].name), {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.new(0.68, 0, 0, 28),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			Parent = card,
		})
		local props = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 40), Parent = card }
		if bounty.done then
			UI.button("Done!", T.Card, nil, props)
		else
			UI.button("Turn in", have >= bounty.count and T.Good or T.Card, function()
				act("ClaimBounty", tostring(index))
			end, props)
		end
	end
end

------------------------------------------------------------------ Fish Book
local bookTab = Zones.List[1].id

local function renderBook(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(10).Parent = body

	local tabs = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1, LayoutOrder = 1, Parent = body }, { UI.list(8, Enum.FillDirection.Horizontal) })
	local tabList = {}
	for _, zone in ipairs(Zones.List) do
		table.insert(tabList, { id = zone.id, name = zone.name, fish = Fish.ByZone[zone.id] or {} })
	end
	table.insert(tabList, { id = "event", name = "Legends", fish = Fish.EventFish })

	local found, total = 0, #Fish.List
	for id in pairs(data.book) do
		if Fish.ById[id] then
			found += 1
		end
	end

	local current
	for index, tab in ipairs(tabList) do
		if tab.id == bookTab then
			current = tab
		end
		UI.button(tab.name, tab.id == bookTab and T.Accent or T.Card, function()
			bookTab = tab.id
			Panels.Book.refresh()
		end, { Size = UDim2.fromOffset(136, 36), LayoutOrder = index, Parent = tabs })
	end
	current = current or tabList[1]

	local zoneFound = 0
	for _, fish in ipairs(current.fish) do
		if data.book[fish.id] then
			zoneFound += 1
		end
	end
	UI.label(string.format("%s: %d/%d found   (whole book: %d/%d)", current.name, zoneFound, #current.fish, found, total), {
		Size = UDim2.new(1, -8, 0, 24),
		Font = T.BodyFont,
		TextColor3 = T.Muted,
		LayoutOrder = 2,
		Parent = body,
	})

	local grid = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = body }, {
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(134, 112), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	for index, fish in ipairs(current.fish) do
		local entry = data.book[fish.id]
		local rarity = Fish.RarityById[fish.rarity]
		local card = UI.new("Frame", { BackgroundColor3 = T.Card, LayoutOrder = index, Parent = grid }, { UI.corner(10), UI.stroke(rarity.color, 2), UI.padding(6), UI.list(2) })
		UI.label(entry and fish.name or "???", { Size = UDim2.new(1, 0, 0, 34), TextWrapped = true, Parent = card })
		UI.label(fish.rarity, { Size = UDim2.new(1, 0, 0, 18), TextColor3 = rarity.color, Parent = card })
		local detail = "Not caught yet"
		if entry then
			detail = string.format("x%d  best %s", entry.count, Format.Weight(entry.best))
			if entry.shiny > 0 then
				detail ..= string.format("\n%d shiny", entry.shiny)
			end
		end
		UI.label(detail, { Size = UDim2.new(1, 0, 0, 34), Font = T.BodyFont, TextColor3 = T.Muted, TextWrapped = true, Parent = card })
	end

	if current.id == "event" then
		local eventFish, left = Events.GetEventFish()
		local zone = Zones.ById[eventFish.zone]
		UI.label(string.format("This week: %s in %s (ends in %s)", eventFish.name, zone and zone.name or "", Format.Duration(left)), {
			Size = UDim2.new(1, -8, 0, 24),
			Font = T.BodyFont,
			TextColor3 = T.Gold,
			LayoutOrder = 4,
			Parent = body,
		})
	end
end

------------------------------------------------------------------ Rods
local function renderRods(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	for index, rod in ipairs(Rods.List) do
		local card = row(body, 64, index)
		UI.label(rod.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rod.color:Lerp(Color3.new(1, 1, 1), 0.4), Parent = card })
		local stats = string.format("Luck x%.2f   Bites %d%% faster   Fight control +%d%%", rod.luck, math.floor((1 - rod.speed) * 100 + 0.5), math.floor(rod.control * 100 + 0.5))
		UI.label(stats, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.68, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })

		local text, color, onClick
		if data.equippedRod == rod.id then
			text, color = "Equipped", T.Card
		elseif data.rodsOwned[rod.id] then
			text, color = "Equip", T.Accent
			onClick = function()
				act("EquipRod", rod.id)
			end
		elseif rod.requiresRebirths and data.rebirths < rod.requiresRebirths then
			text, color = string.format("%d rebirth", rod.requiresRebirths), T.Card
		else
			text = Format.Number(rod.price) .. " coins"
			color = data.coins >= rod.price and T.Good or T.Bad
			onClick = function()
				act("BuyRod", rod.id)
			end
		end
		UI.button(text, color, onClick, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 40), Parent = card })
	end
end

------------------------------------------------------------------ Shop
local function renderShop(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	heading(body, "Game passes (yours forever)", nextOrder())
	for _, pass in ipairs(Shop.Passes) do
		local card = row(body, 64, nextOrder())
		UI.label(pass.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.label(pass.description, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.68, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
		local button = UI.button("...", T.Good, nil, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 40), Parent = card })
		if State.HasPass(pass.id) then
			button.Text = "Owned"
			button.BackgroundColor3 = T.Card
		elseif pass.gamePassId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(pass.gamePassId, Enum.InfoType.GamePass, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptGamePassPurchase(player, pass.gamePassId)
			end)
		end
	end

	local function cosmeticRow(item)
		local card = row(body, 52, nextOrder())
		local label = UI.label(item.name, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.65, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), Parent = label })
		local owned = data.cosmetics.owned[item.id]
		local equipped = data.cosmetics.equipped[item.kind] == item.id
		local button = UI.button("...", T.Good, nil, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 36), Parent = card })
		if owned then
			button.Text = equipped and "Unequip" or "Equip"
			button.BackgroundColor3 = equipped and T.Card or T.Accent
			button.Activated:Connect(function()
				act("EquipCosmetic", item.id)
			end)
		elseif item.earned then
			button.Text = "Not earned"
			button.BackgroundColor3 = T.Card
		elseif item.productId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(item.productId, Enum.InfoType.Product, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptProductPurchase(player, item.productId)
			end)
		end
	end

	heading(body, "Rod skins (looks only)", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "rodSkin" then
			cosmeticRow(item)
		end
	end
	heading(body, "Trails (looks only)", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "trail" then
			cosmeticRow(item)
		end
	end
	heading(body, "Titles", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "title" then
			cosmeticRow(item)
		end
	end
	heading(body, "Earned titles (free, unlocked by playing)", nextOrder())
	for _, item in ipairs(Shop.EarnedTitles) do
		cosmeticRow(item)
	end
end

------------------------------------------------------------------ Teleport
local function renderTeleport(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local hasPass = State.HasPass("Teleporter")
	if not hasPass then
		UI.label("Walk across the bridges to reach zones, or get the Zone Teleporter pass in the Shop.", {
			Size = UDim2.new(1, -8, 0, 40),
			TextWrapped = true,
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			LayoutOrder = 0,
			Parent = body,
		})
	end

	local hubRow = row(body, 56, 1)
	UI.label("Harbor (hub)", { Position = UDim2.fromOffset(12, 14), Size = UDim2.new(0.6, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Parent = hubRow })
	UI.button("Go", T.Accent, function()
		if act("Teleport", "hub") then
			Panels.Teleport.close()
		end
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 38), Parent = hubRow })

	for index, zone in ipairs(Zones.List) do
		local card = row(body, 56, index + 1)
		UI.label(zone.name, { Position = UDim2.fromOffset(12, 14), Size = UDim2.new(0.6, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = zone.color, Parent = card })
		local props = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 38), Parent = card }
		if not data.zones[zone.id] then
			UI.button("Unlock " .. Format.Number(zone.price), data.coins >= zone.price and T.Good or T.Bad, function()
				act("UnlockZone", zone.id)
			end, props)
		elseif hasPass then
			UI.button("Go", T.Accent, function()
				if act("Teleport", zone.id) then
					Panels.Teleport.close()
				end
			end, props)
		else
			UI.button("Unlocked", T.Card, nil, props)
		end
	end
end

------------------------------------------------------------------ Rebirth
local function renderRebirth(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(10).Parent = body
	local cost = Config.RebirthCost(data.rebirths)
	local nowBonus = math.floor((Config.SellMultiplier(data.rebirths) - 1) * 100 + 0.5)
	local nextBonus = math.floor((Config.SellMultiplier(data.rebirths + 1) - 1) * 100 + 0.5)
	local requiredZone = Zones.ById[Config.RebirthRequiresZone]

	local lines = {
		string.format("Rebirths: %d   (now +%d%% coins from fish)", data.rebirths, nowBonus),
		string.format("Next rebirth: +%d%% coins from fish, forever", nextBonus),
		string.format("Cost: %s coins", Format.Number(cost)),
		"You keep: your Fish Book, favorite fish, bait, titles, skins, trails and passes.",
		"You reset: coins, rods, unlocked zones and the rest of your bag.",
	}
	if requiredZone then
		table.insert(lines, "Requires: " .. requiredZone.name .. " unlocked.")
	end
	for index, text in ipairs(lines) do
		UI.label(text, { Size = UDim2.new(1, -8, 0, 26), TextWrapped = true, Font = index <= 3 and T.Font or T.BodyFont, TextColor3 = index <= 3 and T.Text or T.Muted, LayoutOrder = index, Parent = body })
	end
	local ready = data.coins >= cost and (not requiredZone or data.zones[requiredZone.id])
	UI.button("Rebirth", ready and T.Good or T.Card, function()
		if act("Rebirth") then
			Panels.Rebirth.close()
		end
	end, { Size = UDim2.fromOffset(200, 50), LayoutOrder = 99, Parent = body })
end

function Panels.Init(screenGui)
	Panels.Bag = UI.window(screenGui, "Bag", renderBag)
	Panels.Market = UI.window(screenGui, "Fish Market", renderMarket)
	Panels.Bait = UI.window(screenGui, "Bait & Tackle", renderBait)
	Panels.Bounties = UI.window(screenGui, "Old Pete's Bounties", renderBounties)
	Panels.Book = UI.window(screenGui, "Fish Book", renderBook)
	Panels.Rods = UI.window(screenGui, "Rods", renderRods)
	Panels.Shop = UI.window(screenGui, "Shop", renderShop)
	Panels.Teleport = UI.window(screenGui, "Travel", renderTeleport)
	Panels.Rebirth = UI.window(screenGui, "Rebirth", renderRebirth)

	State.Changed:Connect(function()
		for _, name in ipairs({ "Bag", "Market", "Bait", "Bounties", "Book", "Rods", "Shop", "Teleport", "Rebirth" }) do
			Panels[name].refresh()
		end
	end)
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- The player's latest save data, as sent by the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {
	data = nil,
	runtime = { passes = {}, bagSize = 20 },
}

local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

Remotes.DataUpdate.OnClientEvent:Connect(function(data, runtime)
	State.data = data
	State.runtime = runtime or State.runtime
	changed:Fire(data, State.runtime)
end)

function State.HasPass(passId)
	return State.runtime.passes ~= nil and State.runtime.passes[passId] == true
end

-- Calls a server action and shows its error message if it fails
function State.Action(actionName, argument)
	local ok, success, message = pcall(function()
		return Remotes.Action:InvokeServer(actionName, argument)
	end)
	if not ok then
		return false, "Connection problem, try again"
	end
	return success, message
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Helpers for building the on-screen menus in code, so nothing has to be
-- drawn by hand in Studio. Colors and fonts live in UI.Theme.

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(20, 32, 52),
	Panel = Color3.fromRGB(30, 46, 74),
	Card = Color3.fromRGB(42, 62, 96),
	Accent = Color3.fromRGB(60, 170, 255),
	Gold = Color3.fromRGB(255, 200, 40),
	Good = Color3.fromRGB(70, 200, 110),
	Bad = Color3.fromRGB(230, 80, 80),
	Muted = Color3.fromRGB(150, 170, 200),
	Text = Color3.fromRGB(255, 255, 255),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamMedium,
}

local T = UI.Theme

-- UI.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function UI.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness)
	return UI.new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.padding(pixels)
	local p = UDim.new(0, pixels)
	return UI.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function UI.list(spacing, direction)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, spacing or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(text, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in pairs(props or {}) do
		label[key] = value
	end
	return label
end

function UI.button(text, color, onClick, props)
	local button = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.Accent,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(120, 40),
	}, { UI.corner(8), UI.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
	for key, value in pairs(props or {}) do
		button[key] = value
	end
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		child:Destroy()
	end
end

-- A centered window with a title, a close button and a scrolling body.
-- Only one window is open at a time.
local openWindow = nil
local windowChanged = Instance.new("BindableEvent")
UI.WindowChanged = windowChanged.Event -- fires with true/false when a window opens/closes

function UI.IsWindowOpen()
	return openWindow ~= nil
end

function UI.window(screenGui, title, render)
	local frame = UI.new("Frame", {
		Name = title .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 440),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(T.Background, 4) })

	UI.label(title, { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -90, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })

	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.new(1, -32, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	})

	local window = { frame = frame, body = body }

	function window.refresh()
		if frame.Visible then
			UI.clear(body)
			render(body)
		end
	end

	function window.open()
		if openWindow and openWindow ~= window then
			openWindow.close()
		end
		openWindow = window
		frame.Visible = true
		window.refresh()
		windowChanged:Fire(true)
	end

	function window.close()
		frame.Visible = false
		if openWindow == window then
			openWindow = nil
			windowChanged:Fire(false)
		end
	end

	function window.toggle()
		if frame.Visible then
			window.close()
		else
			window.open()
		end
	end

	UI.button("X", T.Bad, window.close, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(40, 40),
		Parent = frame,
	})

	return window
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Things in the world that only this player sees: weather, opened zone gates,
-- the VIP door, and ambient life (fish jumping out of the water, seagulls).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Events = require(Shared.Events)
local Fish = require(Shared.Fish)
local FishModel = require(Shared.FishModel)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)

local World = {}

local LOOKS = {
	Clear = { ClockTime = 14, Brightness = 2.5, Density = 0.25, Color = Color3.fromRGB(200, 220, 255), Rain = 0 },
	Rain = { ClockTime = 13, Brightness = 1.2, Density = 0.4, Color = Color3.fromRGB(150, 160, 175), Rain = 300 },
	Fog = { ClockTime = 9, Brightness = 1.5, Density = 0.62, Color = Color3.fromRGB(200, 205, 210), Rain = 0 },
	Storm = { ClockTime = 19, Brightness = 0.8, Density = 0.5, Color = Color3.fromRGB(90, 95, 120), Rain = 700 },
	GoldenHour = { ClockTime = 17.6, Brightness = 2.2, Density = 0.3, Color = Color3.fromRGB(255, 190, 120), Rain = 0 },
}

local atmosphere
local rainEmitter

local function setupWeatherEffects()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting

	local rainPart = Instance.new("Part")
	rainPart.Name = "RainCloud"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.CanTouch = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(120, 1, 120)
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	rainEmitter.Color = ColorSequence.new(Color3.fromRGB(180, 200, 255))
	rainEmitter.Size = NumberSequence.new(0.15)
	rainEmitter.Lifetime = NumberRange.new(1.2)
	rainEmitter.Speed = NumberRange.new(50)
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Rate = 0
	rainEmitter.Parent = rainPart
	rainPart.Parent = Workspace

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if camera then
			rainPart.Position = camera.CFrame.Position + Vector3.new(0, 40, 0)
		end
	end)
end

local currentWeather = nil
local function applyWeather()
	local weather = Events.GetWeather()
	if weather.id == currentWeather then
		return
	end
	currentWeather = weather.id
	local look = LOOKS[weather.id] or LOOKS.Clear
	local info = TweenInfo.new(5)
	TweenService:Create(Lighting, info, { ClockTime = look.ClockTime, Brightness = look.Brightness }):Play()
	TweenService:Create(atmosphere, info, { Density = look.Density, Color = look.Color }):Play()
	rainEmitter.Rate = look.Rain
end

local function updateGates()
	local data = State.data
	if not data then
		return
	end
	local vip = State.HasPass("VIP")
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") then
			local zoneId = item:GetAttribute("ZoneGate")
			if zoneId then
				local open = data.zones[zoneId] == true
				item.CanCollide = not open
				item.Transparency = open and 0.9 or 0
				local prompt = item:FindFirstChildOfClass("ProximityPrompt")
				if prompt then
					prompt.Enabled = not open
				end
				for _, gui in ipairs(item:GetChildren()) do
					if gui:IsA("SurfaceGui") then
						gui.Enabled = not open
					end
				end
			elseif item:GetAttribute("VipDoor") then
				item.CanCollide = not vip
				item.Transparency = vip and 0.8 or 0.5
			end
		end
	end
end

------------------------------------------------------------------ Ambient life

local player = game:GetService("Players").LocalPlayer
local splashSound

local function splashAt(position)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	local drops = Instance.new("ParticleEmitter")
	drops.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	drops.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255))
	drops.Size = NumberSequence.new(0.35)
	drops.Lifetime = NumberRange.new(0.4, 0.7)
	drops.Speed = NumberRange.new(8, 14)
	drops.SpreadAngle = Vector2.new(35, 35)
	drops.EmissionDirection = Enum.NormalId.Top
	drops.Acceleration = Vector3.new(0, -40, 0)
	drops.Rate = 0
	drops.Parent = holder
	holder.Parent = Workspace
	drops:Emit(14)
	if splashSound then
		local camera = Workspace.CurrentCamera
		if camera and (camera.CFrame.Position - position).Magnitude < 70 then
			splashSound.PlaybackSpeed = 1.3 + math.random() * 0.4
			splashSound:Play()
		end
	end
	task.delay(1, function()
		holder:Destroy()
	end)
end

-- Every few seconds a fish leaps out of the water somewhere near the player
local function jumpingFish()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local angle = math.random() * math.pi * 2
	local distance = 25 + math.random() * 45
	local spot = root.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.IgnoreWater = false
	local hit = Workspace:Raycast(Vector3.new(spot.X, 60, spot.Z), Vector3.new(0, -100, 0), params)
	local zoneId = hit and hit.Instance:GetAttribute("FishingZone")
	if not zoneId then
		return
	end
	local pool = Fish.ByZone[zoneId]
	if not pool then
		return
	end
	local fish = pool[math.random(1, math.min(#pool, 9))] -- mostly the common ones
	local model = FishModel.Build(fish.id, (fish.weight[1] + fish.weight[2]) / 2, false)
	local body = model.PrimaryPart
	body.Anchored = true
	model.Parent = Workspace

	local heading = math.random() * math.pi * 2
	local direction = Vector3.new(math.cos(heading), 0, math.sin(heading))
	local start = Vector3.new(spot.X, -0.5, spot.Z)
	local travel = 5 + math.random() * 4
	local height = 3 + math.random() * 4
	local duration = 0.9 + math.random() * 0.4
	splashAt(Vector3.new(spot.X, 0.2, spot.Z))
	local t = 0
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		t += dt / duration
		if t >= 1 then
			connection:Disconnect()
			splashAt(start + direction * travel + Vector3.new(0, 0.7, 0))
			model:Destroy()
			return
		end
		local position = start + direction * travel * t + Vector3.new(0, height * 4 * t * (1 - t), 0)
		local slope = height * 4 * (1 - 2 * t) / travel
		local look = (direction + Vector3.new(0, slope, 0)).Unit
		body.CFrame = CFrame.lookAt(position, position + look)
	end)
end

-- Seagulls circling over the islands
local function seagulls()
	local birds = {}
	local centers = { Vector3.new(0, 0, 0), Vector3.new(230, 0, 0), Vector3.new(460, 0, 0), Vector3.new(690, 0, 0) }
	for i = 1, 8 do
		local model = Instance.new("Model")
		model.Name = "Seagull"
		local function bit(size, color)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Size = size
			p.Color = color
			p.Parent = model
			return p
		end
		local body = bit(Vector3.new(0.7, 0.7, 2), Color3.fromRGB(245, 245, 245))
		local left = bit(Vector3.new(2.4, 0.15, 0.9), Color3.fromRGB(200, 200, 205))
		local right = bit(Vector3.new(2.4, 0.15, 0.9), Color3.fromRGB(200, 200, 205))
		model.Parent = Workspace
		table.insert(birds, {
			body = body,
			left = left,
			right = right,
			center = centers[(i - 1) % #centers + 1] + Vector3.new(math.random(-30, 30), 0, math.random(-30, 30)),
			radius = 25 + math.random() * 30,
			height = 30 + math.random() * 15,
			speed = (0.15 + math.random() * 0.15) * (math.random() < 0.5 and -1 or 1),
			phase = math.random() * math.pi * 2,
		})
	end
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for _, bird in ipairs(birds) do
			local a = bird.phase + now * bird.speed
			local position = bird.center + Vector3.new(math.cos(a) * bird.radius, bird.height + math.sin(now * 0.7 + bird.phase) * 2, math.sin(a) * bird.radius)
			local tangent = Vector3.new(-math.sin(a), 0, math.cos(a)) * math.sign(bird.speed)
			local frame = CFrame.lookAt(position, position + tangent) * CFrame.Angles(0, 0, -0.3 * math.sign(bird.speed))
			local flap = math.sin(now * 8 + bird.phase) * 0.5
			bird.body.CFrame = frame
			bird.left.CFrame = frame * CFrame.new(-0.35, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(-1.2, 0, 0)
			bird.right.CFrame = frame * CFrame.new(0.35, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(1.2, 0, 0)
		end
	end)
end

function World.Init()
	splashSound = Instance.new("Sound")
	splashSound.SoundId = "rbxasset://sounds/impact_water.mp3"
	splashSound.Volume = 0.25
	splashSound.Parent = game:GetService("SoundService")

	seagulls()
	task.spawn(function()
		while true do
			task.wait(2 + math.random() * 3)
			pcall(jumpingFish)
		end
	end)

	setupWeatherEffects()
	applyWeather()
	task.spawn(function()
		while true do
			task.wait(2)
			applyWeather()
		end
	end)

	State.Changed:Connect(updateGates)
	updateGates()

	Remotes.OpenPanel.OnClientEvent:Connect(function(name)
		local panel = Panels[name]
		if panel then
			panel.open()
		end
	end)
end

return World
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
