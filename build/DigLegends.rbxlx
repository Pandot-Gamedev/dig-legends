	{ id = "salamander_bones", name = "Fire Salamander Bones", zone = "volcano", rarity = "Uncommon", value = 7000, weight = { 0.5, 3 }, shape = "bone", color = Color3.fromRGB(230, 160, 120) },
	{ id = "dragon_scale", name = "Dragon Scale", zone = "volcano", rarity = "Rare", value = 19000, weight = { 0.5, 2 }, shape = "shell", color = Color3.fromRGB(180, 30, 40) },
	{ id = "ember_ruby", name = "Ember Ruby", zone = "volcano", rarity = "Rare", value = 21000, weight = { 0.02, 0.2 }, shape = "gem", color = Color3.fromRGB(230, 30, 50) },
	{ id = "golem_heart", name = "Lava Golem Heart", zone = "volcano", rarity = "Epic", value = 58000, weight = { 5, 20 }, shape = "orb", color = Color3.fromRGB(255, 90, 20) },
	{ id = "fire_diamond", name = "Fire Diamond", zone = "volcano", rarity = "Epic", value = 64000, weight = { 0.05, 0.3 }, shape = "gem", color = Color3.fromRGB(255, 70, 30) },
	{ id = "dragon_egg", name = "Dragon Egg Fossil", zone = "volcano", rarity = "Legendary", value = 320000, weight = { 10, 40 }, shape = "egg", color = Color3.fromRGB(110, 40, 40) },

	-- Weekly event legendaries (one per week, rotating through the zones)
	{ id = "pirate_chest", name = "Buried Pirate Chest", zone = "backyard", rarity = "Legendary", value = 3000, weight = { 20, 60 }, shape = "relic", color = Color3.fromRGB(140, 90, 40), event = true },
	{ id = "meteorite", name = "Meteorite Chunk", zone = "desert", rarity = "Legendary", value = 12000, weight = { 5, 30 }, shape = "orb", color = Color3.fromRGB(70, 60, 80), event = true },
	{ id = "mountain_heart", name = "Heart of the Mountain", zone = "caves", rarity = "Legendary", value = 50000, weight = { 5, 25 }, shape = "gem", color = Color3.fromRGB(255, 80, 200), event = true },
	{ id = "sunken_crown", name = "Sunken King's Crown", zone = "ruins", rarity = "Legendary", value = 200000, weight = { 2, 6 }, shape = "crown", color = Color3.fromRGB(255, 215, 80), event = true },
	{ id = "phoenix_feather", name = "Phoenix Feather", zone = "volcano", rarity = "Legendary", value = 800000, weight = { 0.1, 0.5 }, shape = "relic", color = Color3.fromRGB(255, 160, 40), event = true },
}

Finds.ById = {}
Finds.ByZone = {} -- regular (non-event) finds per zone
Finds.EventFinds = {}
for _, find in ipairs(Finds.List) do
	assert(Finds.ById[find.id] == nil, "Duplicate find id: " .. find.id)
	Finds.ById[find.id] = find
	if find.event then
		table.insert(Finds.EventFinds, find)
	else
		Finds.ByZone[find.zone] = Finds.ByZone[find.zone] or {}
		table.insert(Finds.ByZone[find.zone], find)
	end
end

-- Zones whose regular finds are all in the Collection
function Finds.IsPageComplete(book, zoneId)
	local list = Finds.ByZone[zoneId]
	if not list then
		return false
	end
	for _, find in ipairs(list) do
		if not book[find.id] then
			return false
		end
	end
	return true
end

function Finds.CompletedPages(book)
	local pages = 0
	for zoneId in pairs(Finds.ByZone) do
		if Finds.IsPageComplete(book, zoneId) then
			pages += 1
		end
	end
	return pages
end

return Finds
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Small helpers for showing numbers and times.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Number(n)
	n = math.floor(n or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local index = 1
	local value = n
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index += 1
	end
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. SUFFIXES[index]
end

-- 3725 -> "1h 2m", 95 -> "1m 35s"
function Format.Duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if days > 0 then
		return string.format("%dd %dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

function Format.Weight(kg)
	if kg >= 100 then
		return string.format("%d kg", math.floor(kg))
	elseif kg < 0.1 then
		-- Small finds like coins and bottle caps weigh a few grams
		return string.format("%d g", math.max(1, math.floor(kg * 1000 + 0.5)))
	end
	return string.format("%.1f kg", kg)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Level</string><ProtectedString name="Source"><![CDATA[-- Digger level. Every find gives XP (more for rarer finds and new ones).
-- Your level shows above your head and pays a coin reward each time it goes up.

local Finds = require(script.Parent.Finds)

local Level = {}

Level.XpByRarity = {
	Common = 5,
	Uncommon = 10,
	Rare = 25,
	Epic = 60,
	Legendary = 150,
}
Level.NewFindBonus = 25
Level.CoinsPerLevel = 150 -- reward for reaching level N is N * this

-- Total XP needed to reach a level (level 1 needs 0)
function Level.XpFor(level)
	return math.floor(40 * (level - 1) ^ 1.6)
end

function Level.FromXp(xp)
	local level = 1
	while Level.XpFor(level + 1) <= xp do
		level += 1
	end
	return level
end

-- How far through the current level, from 0 to 1
function Level.Progress(xp)
	local level = Level.FromXp(xp)
	local from, to = Level.XpFor(level), Level.XpFor(level + 1)
	return (xp - from) / (to - from), level
end

function Level.XpForFind(findId, isNew)
	local find = Finds.ById[findId]
	local xp = Level.XpByRarity[find.rarity] or 5
	if isNew then
		xp += Level.NewFindBonus
	end
	return xp
end

return Level
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Market</string><ProtectedString name="Source"><![CDATA[-- Trading Post prices. Every 30 minutes one find per zone is "in demand" and
-- sells for double, so holding on to the right find can pay off.

local Config = require(script.Parent.Config)
local Finds = require(script.Parent.Finds)
local Zones = require(script.Parent.Zones)
local Events = require(script.Parent.Events)

local Market = {}

Market.HotMultiplier = 2

-- Returns { [findId] = true } for the finds in demand right now, and seconds left
function Market.HotFinds(now)
	now = now or Events.Now()
	local slot = math.floor(now / Config.MarketSeconds)
	local secondsLeft = Config.MarketSeconds - (now % Config.MarketSeconds)
	local random = Random.new(slot * 31 + 7)
	local hot = {}
	for _, zone in ipairs(Zones.List) do
		local pool = {}
		for _, find in ipairs(Finds.ByZone[zone.id] or {}) do
			if find.rarity ~= "Common" then
				table.insert(pool, find)
			end
		end
		if #pool > 0 then
			hot[pool[random:NextInteger(1, #pool)].id] = true
		end
	end
	return hot, secondsLeft
end

-- A player's coin multiplier: rebirths plus completed Collection pages
function Market.Multiplier(data)
	return Config.SellMultiplier(data.rebirths, Finds.CompletedPages(data.book))
end

-- Coins for one find from this player's backpack, right now
function Market.Price(entry, data, hot)
	hot = hot or Market.HotFinds()
	local price = entry.value * Market.Multiplier(data)
	if hot[entry.id] then
		price *= Market.HotMultiplier
	end
	return math.floor(price)
end

return Market
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- All the messages between server and players. The server creates them;
-- players wait for them to appear.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"DataUpdate", -- server -> player: the player's full save data
	"Notify", -- server -> player: a toast message
	"OpenPanel", -- server -> player: open a menu (e.g. the shovel shop)
	"CancelDig", -- player -> server: stop digging
	"DigReady", -- server -> player: something is down there, start the dig minigame
	"DigDone", -- player -> server: how the minigame ended
	"DigResult", -- server -> player: what was found, or why it broke
}

local FUNCTIONS = {
	"Action", -- player -> server: buy shovel, unlock zone, rebirth, teleport, equip...
	"StartDig", -- player -> server: dig at a dig spot, returns the dig id if it started
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Everything sold for Robux. Nothing here changes what you dig up or how
-- many coins you earn: only looks and time-savers.
--
-- HOW TO FILL IN THE IDS (step 5 of the build plan):
--   Game passes: Creator Dashboard > your game > Monetization > Passes
--   Cosmetics:   Creator Dashboard > your game > Monetization > Developer Products
-- An id of 0 means "not set up yet": the item shows as "Coming soon" in the shop.

local Shop = {}

Shop.Passes = {
	{ id = "VIP", gamePassId = 2057879657, name = "VIP", suggestedPrice = 250, description = "Golden VIP name tag, a crown, and access to the VIP lounge." },
	{ id = "AutoSell", gamePassId = 2060422905, name = "Auto Sell", suggestedPrice = 150, description = "Your backpack sells itself when it fills up, wherever you are." },
	{ id = "BigBag", gamePassId = 2058845634, name = "Big Backpack", suggestedPrice = 100, description = "Carry 60 finds instead of 20." },
	{ id = "Teleporter", gamePassId = 2058899650, name = "Zone Teleporter", suggestedPrice = 200, description = "Teleport to any zone you have unlocked." },
}

-- kind: "shovelSkin" changes how your shovel looks, "trail" adds a trail behind you,
-- "title" shows a title above your head.
Shop.Cosmetics = {
	{ id = "skin_golden", kind = "shovelSkin", name = "Golden Shovel Skin", productId = 3723377192, suggestedPrice = 99, color = Color3.fromRGB(255, 200, 40), material = Enum.Material.Foil },
	{ id = "skin_neon", kind = "shovelSkin", name = "Neon Pink Shovel Skin", productId = 3723377204, suggestedPrice = 75, color = Color3.fromRGB(255, 60, 200), material = Enum.Material.Neon },
	{ id = "skin_galaxy", kind = "shovelSkin", name = "Galaxy Shovel Skin", productId = 3723377180, suggestedPrice = 149, color = Color3.fromRGB(110, 60, 255), material = Enum.Material.ForceField },
	{ id = "skin_candy", kind = "shovelSkin", name = "Candy Shovel Skin", productId = 3723377224, suggestedPrice = 49, color = Color3.fromRGB(255, 120, 150), material = Enum.Material.SmoothPlastic },

	{ id = "trail_sparkle", kind = "trail", name = "Sparkle Trail", productId = 3723377257, suggestedPrice = 49, colors = { Color3.fromRGB(0, 170, 255), Color3.fromRGB(0, 255, 200) } },
	{ id = "trail_fire", kind = "trail", name = "Fire Trail", productId = 3723377243, suggestedPrice = 75, colors = { Color3.fromRGB(255, 220, 0), Color3.fromRGB(255, 40, 0) } },
	{ id = "trail_rainbow", kind = "trail", name = "Rainbow Trail", productId = 3723377236, suggestedPrice = 129, colors = { Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 120, 255), Color3.fromRGB(200, 0, 255) } },

	{ id = "title_lucky", kind = "title", name = "Title: Lucky Digger", text = "Lucky Digger", productId = 3723377288, suggestedPrice = 25, color = Color3.fromRGB(120, 200, 255) },
	{ id = "title_whisperer", kind = "title", name = "Title: Rock Whisperer", text = "Rock Whisperer", productId = 3723377276, suggestedPrice = 49, color = Color3.fromRGB(160, 255, 160) },
	{ id = "title_diglegend", kind = "title", name = "Title: Dig Legend", text = "Dig Legend", productId = 3723377268, suggestedPrice = 99, color = Color3.fromRGB(255, 190, 60) },
}

-- Free titles earned by playing. The server checks the "rule".
Shop.EarnedTitles = {
	{ id = "earned_backyard", kind = "title", name = "Backyard Master", text = "Backyard Master", rule = "zoneBook", zone = "backyard", color = Color3.fromRGB(140, 210, 110) },
	{ id = "earned_desert", kind = "title", name = "Desert Master", text = "Desert Master", rule = "zoneBook", zone = "desert", color = Color3.fromRGB(240, 190, 90) },
	{ id = "earned_caves", kind = "title", name = "Crystal Master", text = "Crystal Master", rule = "zoneBook", zone = "caves", color = Color3.fromRGB(180, 130, 255) },
	{ id = "earned_ruins", kind = "title", name = "Ruins Master", text = "Ruins Master", rule = "zoneBook", zone = "ruins", color = Color3.fromRGB(90, 200, 190) },
	{ id = "earned_volcano", kind = "title", name = "Volcano Master", text = "Volcano Master", rule = "zoneBook", zone = "volcano", color = Color3.fromRGB(255, 110, 50) },
	{ id = "earned_legend", kind = "title", name = "Legend Hunter", text = "Legend Hunter", rule = "eventFind", color = Color3.fromRGB(255, 150, 0) },
	{ id = "earned_reborn", kind = "title", name = "Reborn", text = "Reborn", rule = "rebirth", color = Color3.fromRGB(255, 90, 160) },
}

Shop.PassById = {}
for _, pass in ipairs(Shop.Passes) do
	Shop.PassById[pass.id] = pass
end

Shop.CosmeticById = {}
Shop.CosmeticByProductId = {}
for _, item in ipairs(Shop.Cosmetics) do
	Shop.CosmeticById[item.id] = item
	if item.productId ~= 0 then
		Shop.CosmeticByProductId[item.productId] = item
	end
end
for _, item in ipairs(Shop.EarnedTitles) do
	item.earned = true
	Shop.CosmeticById[item.id] = item
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">ShovelModel</string><ProtectedString name="Source"><![CDATA[-- Builds the shovel the player holds: a round shaft with a D-grip on top, a
-- metal collar with rivets, a shaped blade with a foot step, a center ridge and
-- sharpened edges. Every shovel in Shovels.List has its own look, and the
-- better ones glow, sparkle or smoke.
--
-- ShovelModel.Build(tool, shovel, length) adds the parts to the tool and
-- returns its Handle (the shaft, from +length/2 at the top to -length/2 where
-- the blade starts). Blade parts get the attribute Blade = true and edge/glow
-- parts Trim = true, so shovel skins can recolor them.

local CrownModel = require(script.Parent.CrownModel)

local ShovelModel = {}

local WOOD = Color3.fromRGB(150, 105, 62)
local DARK_WOOD = Color3.fromRGB(95, 60, 35)
local IRON = Color3.fromRGB(85, 88, 95)

-- shape: "pointed" (round-point digging shovel) or "square" (garden spade)
local LOOKS = {
	trowel = {
		shape = "pointed",
		shaft = { WOOD, Enum.Material.Wood },
		grip = { DARK_WOOD, Enum.Material.Wood },
		collar = { IRON, Enum.Material.Metal },
		blade = { Color3.fromRGB(150, 100, 70), Enum.Material.CorrodedMetal },
		edge = { Color3.fromRGB(190, 175, 160), Enum.Material.Metal },
	},
	spade = {
		shape = "square",
		shaft = { WOOD, Enum.Material.Wood },
		grip = { Color3.fromRGB(70, 130, 70), Enum.Material.SmoothPlastic },
		collar = { Color3.fromRGB(60, 100, 60), Enum.Material.Metal },
		blade = { Color3.fromRGB(110, 160, 95), Enum.Material.Metal },
		edge = { Color3.fromRGB(210, 215, 220), Enum.Material.Metal },
	},
	steel = {
		shape = "pointed",
		shaft = { Color3.fromRGB(55, 58, 64), Enum.Material.Metal },
		grip = { Color3.fromRGB(25, 25, 28), Enum.Material.SmoothPlastic },
		collar = { Color3.fromRGB(150, 155, 165), Enum.Material.DiamondPlate },
		blade = { Color3.fromRGB(200, 205, 215), Enum.Material.Metal },
		edge = { Color3.fromRGB(240, 245, 250), Enum.Material.Metal },
		reflectance = 0.15,
	},
	golden = {
		shape = "pointed",
		shaft = { Color3.fromRGB(80, 40, 20), Enum.Material.Wood },
		grip = { Color3.fromRGB(255, 200, 40), Enum.Material.Foil },
		collar = { Color3.fromRGB(255, 200, 40), Enum.Material.Foil },
		blade = { Color3.fromRGB(255, 200, 40), Enum.Material.Foil },
		edge = { Color3.fromRGB(255, 240, 170), Enum.Material.Foil },
		reflectance = 0.2,
		glint = true,
	},
	crystal = {
		shape = "pointed",
		shaft = { Color3.fromRGB(55, 35, 85), Enum.Material.SmoothPlastic },
		grip = { Color3.fromRGB(190, 150, 255), Enum.Material.Neon },
		collar = { Color3.fromRGB(210, 190, 255), Enum.Material.Glass },
		blade = { Color3.fromRGB(170, 120, 255), Enum.Material.Glass, 0.2 },
		edge = { Color3.fromRGB(215, 190, 255), Enum.Material.Neon },
		light = Color3.fromRGB(170, 120, 255),
		shards = true,
		glint = true,
	},
	magma = {
		shape = "pointed",
		shaft = { Color3.fromRGB(40, 34, 34), Enum.Material.Basalt },
		grip = { Color3.fromRGB(255, 100, 30), Enum.Material.Neon },
		collar = { Color3.fromRGB(60, 50, 48), Enum.Material.Basalt },
		blade = { Color3.fromRGB(50, 38, 36), Enum.Material.Basalt },
		edge = { Color3.fromRGB(255, 110, 30), Enum.Material.Neon },
		light = Color3.fromRGB(255, 110, 40),
		embers = true,
	},
}
ShovelModel.Looks = LOOKS

local function part(parent, name, size, style, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.Color = style[1]
	p.Material = style[2]
	p.Transparency = style[3] or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function attach(handle, p, offset)
	p.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = p
	weld.Parent = p
	return p
end

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder (long along X) to stand along Y

function ShovelModel.Build(tool, shovel, length)
	local look = LOOKS[shovel.id] or LOOKS.trowel
	local half = length / 2
	local reflect = look.reflectance or 0

	-- The Handle is the shaft's invisible core, so the hand grips stay the same
	local handle = part(tool, "Handle", Vector3.new(0.3, length, 0.3), look.shaft)
	handle.Transparency = 1
	handle.CFrame = CFrame.new()

	local function add(name, size, style, offset, shape)
		return attach(handle, part(tool, name, size, style, shape), offset)
	end
	local function blade(p)
		p:SetAttribute("Blade", true)
		p.Reflectance = reflect
		return p
	end
	local function trim(p)
		p:SetAttribute("Trim", true)
		return p
	end

	-- Shaft and D-grip
	add("Shaft", Vector3.new(length, 0.26, 0.26), look.shaft, UPRIGHT, Enum.PartType.Cylinder)
	for _, side in ipairs({ -1, 1 }) do
		add("GripPost", Vector3.new(0.1, 0.62, 0.12), look.grip, CFrame.new(side * 0.13, half + 0.27, 0) * CFrame.Angles(0, 0, math.rad(-24 * side)))
	end
	add("GripBar", Vector3.new(0.66, 0.17, 0.17), look.grip, CFrame.new(0, half + 0.56, 0), Enum.PartType.Cylinder)

	-- Collar with two rivets
	add("Collar", Vector3.new(0.62, 0.36, 0.36), look.collar, CFrame.new(0, -half + 0.05, 0) * UPRIGHT, Enum.PartType.Cylinder)
	for _, y in ipairs({ 0.12, -0.12 }) do
		add("Rivet", Vector3.one * 0.09, look.edge, CFrame.new(0, -half + 0.05 + y, -0.17), Enum.PartType.Ball)
	end

	-- Blade: foot step along the top, the flat body, a center ridge and the tip
	local top = -half - 0.22
	local bodyHeight = look.shape == "square" and 1.3 or 0.95
	local width = 1.3
	local bladeColor = look.blade[1]
	local ridgeStyle = { bladeColor:Lerp(Color3.new(0, 0, 0), 0.2), look.blade[2], look.blade[3] }
	blade(add("Step", Vector3.new(width + 0.06, 0.12, 0.26), look.blade, CFrame.new(0, top, 0)))
	blade(add("Blade", Vector3.new(width, bodyHeight, 0.12), look.blade, CFrame.new(0, top - bodyHeight / 2, 0)))
	blade(add("Ridge", Vector3.new(0.2, bodyHeight * 0.8, 0.2), ridgeStyle, CFrame.new(0, top - bodyHeight * 0.4, 0)))
	local bottom = top - bodyHeight

	if look.shape == "square" then
		trim(add("Edge", Vector3.new(width + 0.02, 0.08, 0.14), look.edge, CFrame.new(0, bottom, 0)))
	else
		local tipHeight = 0.6
		-- The tip is a triangle pointing down (the frame is flipped upside down)
		local wedges = CrownModel.Triangle(tool, handle, "Tip", width, tipHeight, 0.11, CFrame.new(0, bottom, 0) * CFrame.Angles(0, 0, math.pi), look.blade[1], look.blade[2])
		for _, wedge in ipairs(wedges) do
			wedge.Transparency = look.blade[3] or 0
			blade(wedge)
		end
		-- Sharpened edges along both sides of the tip
		local slant = math.sqrt((width / 2) ^ 2 + tipHeight ^ 2)
		local angle = math.atan2(width / 2, tipHeight)
		for _, side in ipairs({ -1, 1 }) do
			trim(add("Edge", Vector3.new(0.08, slant, 0.14), look.edge, CFrame.new(side * width / 4, bottom - tipHeight / 2, 0) * CFrame.Angles(0, 0, -side * angle)))
		end
	end

	-- Extras for the fancy shovels
	local bladePart = tool:FindFirstChild("Blade")
	if look.shards then
		-- Three crystals growing out of the collar, the middle one tallest
		for _, shard in ipairs({ { x = -0.2, tilt = 30, size = 0.36 }, { x = 0, tilt = 0, size = 0.5 }, { x = 0.2, tilt = -30, size = 0.36 } }) do
			local offset = CFrame.new(shard.x, -half + 0.3 + shard.size / 2, 0.05) * CFrame.Angles(0, 0, math.rad(shard.tilt)) * CFrame.Angles(0, math.rad(45), 0)
			trim(add("Shard", Vector3.new(0.13, shard.size, 0.13), look.edge, offset))
		end
	end
	if look.light then
		local light = Instance.new("PointLight")
		light.Color = look.light
		light.Range = 7
		light.Brightness = 0.8
		light.Parent = bladePart
	end
	if look.glint then
		local glint = Instance.new("ParticleEmitter")
		glint.Name = "Glint"
		glint.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		glint.Color = ColorSequence.new(look.edge[1])
		glint.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		glint.Lifetime = NumberRange.new(0.4, 0.7)
		glint.Rate = 4
		glint.Speed = NumberRange.new(0.2, 0.6)
		glint.LightEmission = 1
		glint.Parent = bladePart
	end
	if look.embers then
		local embers = Instance.new("ParticleEmitter")
		embers.Name = "Embers"
		embers.Texture = "rbxasset://textures/particles/fire_main.dds"
		embers.Color = ColorSequence.new(Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 60, 20))
		embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		embers.Transparency = NumberSequence.new(0.2, 1)
		embers.Lifetime = NumberRange.new(0.4, 0.8)
		embers.Rate = 8
		embers.Speed = NumberRange.new(0.8, 1.6)
		embers.EmissionDirection = Enum.NormalId.Top
		embers.LightEmission = 1
		embers.Parent = bladePart
	end

	return handle
end

-- Recolors the blade for a shovel skin (color + material from Shop.Cosmetics)
function ShovelModel.ApplySkin(tool, skin)
	for _, p in ipairs(tool:GetDescendants()) do
		if p:IsA("BasePart") and p:GetAttribute("Blade") then
			p.Color = skin.color
			p.Material = skin.material
			p.Transparency = 0
		elseif p:IsA("BasePart") and p:GetAttribute("Trim") then
			p.Color = skin.color:Lerp(Color3.new(1, 1, 1), 0.45)
		end
	end
end

return ShovelModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Shovels</string><ProtectedString name="Source"><![CDATA[-- Shovels are bought with in-game coins only (never Robux).
-- luck: multiplies the chance of Rare and better finds
-- speed: multiplies how long it takes to dig down (lower is faster)
-- power: widens the green sweet spot in the dig minigame

local Shovels = {}

Shovels.List = {
	{ id = "trowel", name = "Garden Trowel", price = 0, luck = 1.0, speed = 1.0, power = 0.0, color = Color3.fromRGB(140, 100, 60) },
	{ id = "spade", name = "Garden Spade", price = 400, luck = 1.1, speed = 0.92, power = 0.06, color = Color3.fromRGB(110, 150, 90) },
	{ id = "steel", name = "Steel Shovel", price = 2500, luck = 1.25, speed = 0.85, power = 0.12, color = Color3.fromRGB(200, 205, 215) },
	{ id = "golden", name = "Golden Shovel", price = 12000, luck = 1.45, speed = 0.77, power = 0.18, color = Color3.fromRGB(255, 200, 40) },
	{ id = "crystal", name = "Crystal Shovel", price = 60000, luck = 1.7, speed = 0.68, power = 0.25, color = Color3.fromRGB(170, 120, 255) },
	{ id = "magma", name = "Magma Shovel", price = 300000, luck = 2.0, speed = 0.6, power = 0.32, color = Color3.fromRGB(255, 90, 30) },
}

Shovels.ById = {}
for index, shovel in ipairs(Shovels.List) do
	shovel.order = index
	Shovels.ById[shovel.id] = shovel
end

Shovels.Default = "trowel"

return Shovels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- Grandpa Gus's first-day guide. Each step points at a place in the world (a part
-- with the matching "GuideTarget" attribute) and finishes on a game event.

local Tutorial = {}

Tutorial.Steps = {
	{ event = "EquipShovel", text = "Welcome, digger! Take out your shovel: press 1, or tap it at the bottom of the screen.", target = nil },
	{ event = "Dig", text = "See the sparkling dirt? Stand next to it and click to dig.", target = "DigPatch" },
	{ event = "Find", text = "Tap when the marker is in the green. Hit the gold middle for a better find!", target = "DigPatch" },
	{ event = "Sell", text = "Great find! Bring it to Ruby at the Trading Post and sell it.", target = "Sell" },
	{ event = "Bounties", text = "Come see me at the bounty board. I pay extra for the finds I need!", target = "Bounties" },
}

Tutorial.Done = #Tutorial.Steps + 1
Tutorial.RewardCoins = 250
Tutorial.RewardCharm = { id = "clover", amount = 10 }

return Tutorial
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Zones</string><ProtectedString name="Source"><![CDATA[-- Digging zones, in the order you reach them. A zone needs a digger level and
-- in-game coins to unlock. short = name on the Collection tabs.

local Zones = {}

Zones.List = {
	{ id = "backyard", name = "Backyard", short = "Backyard", level = 1, price = 0, color = Color3.fromRGB(140, 210, 110) },
	{ id = "desert", name = "Desert Dig", short = "Desert", level = 5, price = 2500, color = Color3.fromRGB(240, 190, 90) },
	{ id = "caves", name = "Crystal Caves", short = "Caves", level = 12, price = 20000, color = Color3.fromRGB(180, 130, 255) },
	{ id = "ruins", name = "Sunken Ruins", short = "Ruins", level = 20, price = 120000, color = Color3.fromRGB(90, 200, 190) },
	{ id = "volcano", name = "Volcano Core", short = "Volcano", level = 30, price = 700000, color = Color3.fromRGB(255, 110, 50) },
}

Zones.ById = {}
for index, zone in ipairs(Zones.List) do
	zone.order = index
	Zones.ById[zone.id] = zone
end

Zones.Default = "backyard"

-- The zone you must unlock first (zones open in order, like the bridges)
function Zones.Previous(zoneId)
	local zone = Zones.ById[zoneId]
	return zone and Zones.List[zone.order - 1]
end

return Zones
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000020"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000001F"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Dig Up a Legendary! server. Starts every service in order.

local MapBuilder = require(script.MapBuilder)
local DataService = require(script.DataService)
local ShopService = require(script.ShopService)
local TutorialService = require(script.TutorialService)
local NpcService = require(script.NpcService)
local EconomyService = require(script.EconomyService)
local CosmeticService = require(script.CosmeticService)
local DigService = require(script.DigService)
local WorldService = require(script.WorldService)
local RushService = require(script.RushService)
local BuddyService = require(script.BuddyService)
local Finds = require(game:GetService("ReplicatedStorage").Shared.Finds)

MapBuilder.Build()

-- Services that react to players loading must start before DataService
ShopService.Start()
TutorialService.Start()
EconomyService.Start()
CosmeticService.Start()
DigService.Start()
WorldService.Start()
RushService.Start(DigService.GiveRushLoot)
BuddyService.Start()
NpcService.Start()
DataService.Start()

-- Test helpers for Roblox Studio only (never in the live game). In the command
-- bar, with the Server view selected:
--   game.ServerStorage.DigLegendsTest:Invoke("coins", 5000)
--   game.ServerStorage.DigLegendsTest:Invoke("xp", 10000)
--   game.ServerStorage.DigLegendsTest:Invoke("book", "desert") -- fills that Collection page
--   game.ServerStorage.DigLegendsTest:Invoke("rush") -- starts a Treasure Rush now
if game:GetService("RunService"):IsStudio() then
	local test = Instance.new("BindableFunction")
	test.Name = "DigLegendsTest"
	test.OnInvoke = function(command, amount)
		if command == "rush" then
			RushService.Begin()
			return "ok"
		end
		for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
			DataService.Update(player, function(data)
				if command == "coins" then
					data.coins += amount
				elseif command == "xp" then
					data.xp += amount
				elseif command == "book" then
					for _, find in ipairs(Finds.ByZone[amount] or {}) do
						data.book[find.id] = data.book[find.id] or { count = 1, best = 0.1, shiny = 0 }
					end
				end
			end)
		end
		return "ok"
	end
	test.Parent = game:GetService("ServerStorage")
end

print("[Dig Up a Legendary!] Server ready")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">BuddyService</string><ProtectedString name="Source"><![CDATA[-- Dig buddies: digging within 20 studs of a Roblox friend gives both of you
-- +10% coins for everything you dig up there. Each player's current buddy is
-- kept in their "DigBuddy" attribute (the friend's display name), which
-- DigService reads when a find comes up and the HUD shows on screen.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local BuddyService = {}

local CHECK_SECONDS = 1
local TIP_COOLDOWN = 120 -- seconds between "dig buddy" toasts for one player

local friends = {} -- ["lowId:highId"] = true / false (nil while Roblox hasn't answered)
local asking = {}
local lastTip = {} -- [player] = os.clock()

local function pairKey(a, b)
	return math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
end

local function areFriends(a, b)
	-- Test players in Studio are never real friends, so count everyone there
	if RunService:IsStudio() then
		return true
	end
	local key = pairKey(a, b)
	if friends[key] == nil and not asking[key] then
		asking[key] = true
		task.spawn(function()
			local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
			if ok then
				friends[key] = result
			end
			-- If Roblox didn't answer, ask again on a later check
			task.delay(ok and 0 or 30, function()
				asking[key] = nil
			end)
		end)
	end
	return friends[key] == true
end

local function rootOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 then
		return root
	end
	return nil
end

local function check()
	local players = Players:GetPlayers()
	for _, player in ipairs(players) do
		local root = rootOf(player)
		local buddy, closest = nil, Config.BuddyRange
		if root then
			for _, other in ipairs(players) do
				local otherRoot = other ~= player and rootOf(other)
				if otherRoot then
					local distance = (otherRoot.Position - root.Position).Magnitude
					if distance <= closest and areFriends(player, other) then
						buddy, closest = other, distance
					end
				end
			end
		end
		local name = buddy and buddy.DisplayName or nil
		if name and not player:GetAttribute("DigBuddy") and os.clock() - (lastTip[player] or -math.huge) > TIP_COOLDOWN then
			lastTip[player] = os.clock()
			Remotes.Notify:FireClient(player, string.format("Dig buddy! Digging near %s gives you both +%d%% coins.", name, math.floor(Config.BuddyBonus * 100 + 0.5)), "success")
		end
		if player:GetAttribute("DigBuddy") ~= name then
			player:SetAttribute("DigBuddy", name)
		end
	end
end

-- The coin multiplier for a find this player digs up right now
function BuddyService.Multiplier(player)
	return player:GetAttribute("DigBuddy") and 1 + Config.BuddyBonus or 1
end

function BuddyService.Start()
	task.spawn(function()
		while true do
			task.wait(CHECK_SECONDS)
			check()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastTip[player] = nil
		local id = tostring(player.UserId)
		for key in pairs(friends) do
			local low, high = key:match("^(-?%d+):(-?%d+)$")
			if low == id or high == id then
				friends[key] = nil
			end
		end
	end)
end

return BuddyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">CosmeticService</string><ProtectedString name="Source"><![CDATA[-- Shows each player's name tag (name, digger level, title, VIP) and cosmetics:
-- trails, shovel skins and VIP extras.
-- Also hands out free titles players earn by playing.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Finds = require(Shared.Finds)
local Shop = require(Shared.Shop)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)
local Zones = require(Shared.Zones)
local CrownModel = require(Shared.CrownModel)
local ShovelModel = require(Shared.ShovelModel)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local CosmeticService = {}

local VIP_GOLD = Color3.fromRGB(255, 200, 40)
local applied = {} -- [player] = signature of what is shown, to skip needless rebuilds

local function equippedItem(data, kind)
	local id = data.cosmetics.equipped[kind]
	return id and data.cosmetics.owned[id] and Shop.CosmeticById[id] or nil
end

function CosmeticService.StyleShovel(player, tool)
	local data = DataService.Get(player)
	local skin = data and equippedItem(data, "shovelSkin")
	if skin then
		ShovelModel.ApplySkin(tool, skin)
	end
end

local function clearOld(character)
	for _, name in ipairs({ "DigTitle", "DigTrail", "DigCrown", "DigTrailTop", "DigTrailBottom" }) do
		for _, item in ipairs(character:GetDescendants()) do
			if item.Name == name then
				item:Destroy()
			end
		end
	end
end

local function applyToCharacter(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local head = character:WaitForChild("Head", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not head or not root then
		return
	end
	clearOld(character)

	local vip = ShopService.HasPass(player, "VIP")
	local title = equippedItem(data, "title")

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "DigTitle"
	gui.Size = UDim2.fromOffset(240, 72)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.MaxDistance = 90
	gui.Adornee = head
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	local order = 0
	local function line(text, color, height)
		order += 1
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, height or 22)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextStrokeTransparency = 0.4
		label.LayoutOrder = order
		label.Parent = gui
	end
	if title then
		line(title.text, title.color, 18)
	end
	line(player.DisplayName, vip and VIP_GOLD or Color3.new(1, 1, 1), 24)
	line(string.format("%sLv %d Digger", vip and "VIP  " or "", Level.FromXp(data.xp)), Color3.fromRGB(150, 220, 255), 18)
	gui.Parent = head

	if vip then
		local crown = Instance.new("Model")
		crown.Name = "DigCrown"
		-- Wide enough and high enough to sit on top of most hair
		local radius = math.min(head.Size.X, head.Size.Z) * 0.5
		local core = CrownModel.AddTo(crown, radius, { color = VIP_GOLD })
		crown.PrimaryPart = core
		crown:PivotTo(head.CFrame * CFrame.new(0, head.Size.Y / 2 + radius * 0.8, 0) * CFrame.Angles(math.rad(-6), 0, 0))
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = core
		weld.Parent = core
		crown.Parent = character
	end

	local trailItem = equippedItem(data, "trail")
	if trailItem then
		local top = Instance.new("Attachment")
		top.Name = "DigTrailTop"
		top.Position = Vector3.new(0, 0.8, 0.5)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "DigTrailBottom"
		bottom.Position = Vector3.new(0, -0.8, 0.5)
		bottom.Parent = root
		local keypoints = {}
		for index, color in ipairs(trailItem.colors) do
			table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #trailItem.colors - 1), color))
		end
		local trail = Instance.new("Trail")
		trail.Name = "DigTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = ColorSequence.new(keypoints)
		trail.Lifetime = 0.6
		trail.LightEmission = 0.6
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
end

local function signature(data, runtime)
	local equipped = data.cosmetics.equipped
	return table.concat({
		tostring(equipped.title),
		tostring(equipped.trail),
		tostring(runtime.passes and runtime.passes.VIP),
		tostring(Level.FromXp(data.xp)),
	}, "|")
end

local function earnedTitleUnlocked(rule, data)
	if rule.rule == "zoneBook" then
		return Finds.IsPageComplete(data.book, rule.zone)
	elseif rule.rule == "eventFind" then
		for _, find in ipairs(Finds.EventFinds) do
			if data.book[find.id] then
				return true
			end
		end
	elseif rule.rule == "rebirth" then
		return data.rebirths >= 1
	end
	return false
end

local function checkEarnedTitles(player, data)
	local newTitles = {}
	for _, title in ipairs(Shop.EarnedTitles) do
		if not data.cosmetics.owned[title.id] and earnedTitleUnlocked(title, data) then
			table.insert(newTitles, title)
		end
	end
	if #newTitles == 0 then
		return
	end
	DataService.Update(player, function(saved)
		for _, title in ipairs(newTitles) do
			saved.cosmetics.owned[title.id] = true
		end
	end)
	for _, title in ipairs(newTitles) do
		if title.rule == "zoneBook" then
			Remotes.Notify:FireClient(player, string.format("Collection page complete! +%d%% coins forever.", math.floor(Config.PageSellBonus * 100 + 0.5)), "rare")
			local zone = Zones.ById[title.zone]
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					Remotes.Notify:FireClient(other, string.format("%s completed the %s Collection page!", player.DisplayName, zone and zone.name or title.zone), "rare")
				end
			end
		end
		Remotes.Notify:FireClient(player, "New title unlocked: " .. title.text .. "! Equip it in the Shop.", "rare")
	end
end

function CosmeticService.Start()
	DataService.OnChanged(function(player, data, runtime)
		checkEarnedTitles(player, data)
		local current = signature(data, runtime)
		if applied[player] ~= current then
			applied[player] = current
			applyToCharacter(player)
		end
	end)

	local function watch(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			applyToCharacter(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		applied[player] = nil
	end)
end

return CosmeticService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Loads, saves and hands out each player's save data.
-- Other scripts change data with DataService.Update(player, function(data) ... end)
-- so the player's screen and leaderboard always refresh afterwards.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Shovels = require(Shared.Shovels)
local Zones = require(Shared.Zones)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)

local DataService = {}

local LOCK_EXPIRES = 15 * 60 -- a lock older than this is from a crashed server

local function defaultData()
	return {
		coins = 0,
		totalEarned = 0,
		totalFound = 0,
		rebirths = 0,
		xp = 0,
		tutorial = 1, -- step of Grandpa Gus's guide (Shared/Tutorial)
		bag = {}, -- { {uid, id, weight, value, shiny, favorite} }
		nextUid = 1,
		charms = {
			owned = {}, -- [charmId] = how many
			equipped = "none",
		},
		bounties = { day = 0, list = {} },
		shovelsOwned = { [Shovels.Default] = true },
		equippedShovel = Shovels.Default,
		zones = { [Zones.Default] = true },
		book = {}, -- [findId] = { count, best, shiny }
		cosmetics = {
			owned = {}, -- [cosmeticId] = true
			equipped = {}, -- [kind] = cosmeticId
		},
		purchases = {}, -- [receiptPurchaseId] = true
		lastDailyDay = 0,
		dailyStreak = 0,
	}
end

-- Fill in any fields missing from older saves
local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local store = nil
local savingEnabled = true
local profiles = {} -- [player] = { data = {}, runtime = {} }
local listeners = {} -- functions called after any data change

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		savingEnabled = false
		warn("[DataService] DataStores unavailable, progress will not save: " .. tostring(result))
	end
end

local function keyFor(player)
	return "player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return defaultData(), false
	end

	local key = keyFor(player)
	for attempt = 1, 6 do
		local lockedElsewhere = false
		local stealLock = attempt >= 4 -- after ~15 seconds, assume the old server is gone
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(saved)
				saved = saved or { data = defaultData() }
				local lock = saved.lock
				if lock and lock.jobId ~= game.JobId and os.time() - lock.time < LOCK_EXPIRES and not stealLock then
					lockedElsewhere = true
					return nil
				end
				saved.lock = { jobId = game.JobId, time = os.time() }
				return saved
			end)
		end)

		if ok and not lockedElsewhere and result then
			return reconcile(result.data or defaultData(), defaultData()), true
		end

		if not ok then
			local message = tostring(result)
			warn(string.format("[DataService] Load attempt %d failed for %s: %s", attempt, player.Name, message))
			if RunService:IsStudio() then
				-- Usually an unpublished place, or "Enable Studio Access to API Services" is off
				return defaultData(), false
			end
		end
		task.wait(5)
	end
	return nil, false
end

local function saveData(player, release)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return true
	end
	local data = profile.data
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function(saved)
			saved = saved or {}
			if saved.lock and saved.lock.jobId ~= game.JobId then
				-- Another server took over this player; don't overwrite newer data
				return nil
			end
			saved.data = data
			saved.lock = (not release) and { jobId = game.JobId, time = os.time() } or nil
			return saved
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end

	-- Global "most finds dug up" board
	pcall(function()
		DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName):SetAsync(tostring(player.UserId), data.totalFound)
	end)
	return ok
end

local function setupLeaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ "Level", "Coins", "Found", "Rebirths" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

local function refresh(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local data = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Level.Value = Level.FromXp(data.xp)
		stats.Coins.Value = data.coins
		stats.Found.Value = data.totalFound
		stats.Rebirths.Value = data.rebirths
	end
	for _, listener in ipairs(listeners) do
		task.spawn(listener, player, data, profile.runtime)
	end
	Remotes.DataUpdate:FireClient(player, data, profile.runtime)
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Runtime info that is not saved (game passes owned, bag size, ...)
function DataService.GetRuntime(player)
	local profile = profiles[player]
	return profile and profile.runtime
end

function DataService.Update(player, change)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local results = table.pack(change(profile.data, profile.runtime))
	refresh(player)
	return table.unpack(results, 1, results.n)
end

function DataService.Refresh(player)
	refresh(player)
end

-- Called with (player, data, runtime) after every change
function DataService.OnChanged(listener)
	table.insert(listeners, listener)
end

function DataService.SaveNow(player)
	return saveData(player, false)
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

-- Waits until the player's data has loaded (or they left)
function DataService.WaitFor(player)
	while player.Parent and not profiles[player] do
		task.wait(0.2)
	end
	return profiles[player] ~= nil
end

local loadedCallbacks = {}
-- callback(player, data, runtime) runs once per player, before the data is shared.
-- It may yield, but must not call DataService.Get/Update for that player.
function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function onPlayerAdded(player)
	setupLeaderstats(player)
	local data, canSave = loadData(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("We couldn't load your save. Please rejoin in a minute.")
		return
	end
	-- Loaded callbacks fill in runtime info (like game passes) before anything else sees the data
	local runtime = { passes = {}, bagSize = Config.BagSize }
	for _, callback in ipairs(loadedCallbacks) do
		callback(player, data, runtime)
	end
	if not player.Parent then
		return
	end
	profiles[player] = { data = data, runtime = runtime, canSave = canSave and savingEnabled }
	refresh(player)
	if not profiles[player].canSave then
		Remotes.Notify:FireClient(player, "Saving is off (in Studio, turn on API Services to test saving).", "warning")
	end
end

local function onPlayerRemoving(player)
	if profiles[player] then
		saveData(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(saveData, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveData(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">DigService</string><ProtectedString name="Source"><![CDATA[-- Dig spots, digging down and finds. The server decides what is buried and
-- checks the timing, so players can't pick their own finds. The dig minigame
-- runs on the player's screen using the shared Dig rules.
--
-- A dig goes: digging down -> minigame -> result
--   walking away while digging = "walked": nothing found, the spot stays
--   too many misses            = "cracked": the find breaks (the charm is used up)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Finds = require(Shared.Finds)
local Shovels = require(Shared.Shovels)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Charms = require(Shared.Charms)
local Dig = require(Shared.Dig)
local FindModel = require(Shared.FindModel)
local ShovelModel = require(Shared.ShovelModel)
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local EconomyService = require(script.Parent.EconomyService)
local CosmeticService = require(script.Parent.CosmeticService)
local TutorialService = require(script.Parent.TutorialService)
local RushService = require(script.Parent.RushService)
local BuddyService = require(script.Parent.BuddyService)

local DigService = {}

local SHOVEL_NAME = "Shovel"
local WANDER_LIMIT = 6 -- studs a player may drift from where they started digging
local SHOVEL_LENGTH = 5
-- How far the shovel leans while held. If it points the wrong way in Studio,
-- flip the sign (e.g. to 35).
local SHOVEL_TILT = -55

local random = Random.new()
local digs = {} -- [player] = current dig
local lastDig = {} -- [player] = os.clock()
local spotCooldowns = {} -- [player] = { [spot] = os.clock() when it can be dug again }
local nextDigId = 0

local function isDigSpot(spot)
	return typeof(spot) == "Instance" and spot:IsA("BasePart") and spot:IsDescendantOf(Workspace) and spot:GetAttribute("DigSpot") ~= nil
end

local function shovelTool(player)
	local character = player.Character
	return character and character:FindFirstChild(SHOVEL_NAME)
end

local function gripFor(lean)
	return CFrame.new(0, SHOVEL_LENGTH / 2 - 0.6, 0) * CFrame.Angles(math.rad(SHOVEL_TILT + lean), 0, 0)
end

-- A puff of dirt from the spot, seen by everyone
local function dirtBurst(spot, count)
	local emitter = spot:FindFirstChild("Dirt")
	if not emitter then
		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Dirt"
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(120, 85, 55))
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.6) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.5, 0.9)
		emitter.Speed = NumberRange.new(8, 14)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -35, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Rate = 0
		emitter.Parent = spot
	end
	emitter:Emit(count)
end

local function clearDig(player)
	local dig = digs[player]
	digs[player] = nil
	local tool = shovelTool(player)
	if tool then
		tool.Grip = gripFor(0)
	end
	return dig
end

-- The charm used for this dig (falls back to no charm when you run out)
local function currentCharm(data)
	local charm = Charms.ById[data.charms.equipped]
	if not charm or (not charm.free and (data.charms.owned[charm.id] or 0) <= 0) then
		return Charms.ById[Charms.Default]
	end
	return charm
end

-- Pick what is buried, using shovel luck, the charm, weather and the weekly event.
-- minOrder (optional) skips rarities below it, e.g. Rare or better for Treasure Rush loot.
local function rollFind(data, zoneId, charm, minOrder)
	local shovel = Shovels.ById[data.equippedShovel] or Shovels.ById[Shovels.Default]
	local weather = Events.GetWeather()
	local eventFind = Events.GetEventFind()

	local byRarity = {}
	for _, find in ipairs(Finds.ByZone[zoneId] or {}) do
		byRarity[find.rarity] = byRarity[find.rarity] or {}
		table.insert(byRarity[find.rarity], find)
	end

	local choices = {}
	local total = 0
	for _, rarity in ipairs(Finds.Rarities) do
		if byRarity[rarity.id] and rarity.order >= (minOrder or 1) then
			local weight = rarity.weight
			if rarity.order >= 3 then
				weight *= shovel.luck * (weather.luckMultiplier or 1) * (charm.luck or 1)
			end
			if rarity.order >= 5 then
				weight *= (weather.legendaryMultiplier or 1) * (charm.legendary or 1)
			end
			total += weight
			table.insert(choices, { rarity = rarity, weight = weight })
		end
	end

	if #choices == 0 then
		return rollFind(data, zoneId, charm)
	end
	local pick = random:NextNumber(0, total)
	local chosen = choices[1].rarity
	for _, choice in ipairs(choices) do
		pick -= choice.weight
		if pick <= 0 then
			chosen = choice.rarity
			break
		end
	end

	local find
	if chosen.id == "Legendary" and eventFind and eventFind.zone == zoneId and random:NextNumber() < 0.5 then
		find = eventFind
	else
		local pool = byRarity[chosen.id]
		find = pool[random:NextInteger(1, #pool)]
	end

	-- Heavier finds are rarer and worth more
	local roll = random:NextNumber() ^ 1.6
	local weight = find.weight[1] + (find.weight[2] - find.weight[1]) * roll
	local shinyChance = Config.ShinyChance * (weather.shinyMultiplier or 1) * (charm.shiny or 1)
	local shiny = random:NextNumber() < shinyChance
	local value = find.value * (0.75 + 0.5 * roll)
	if shiny then
		value *= Config.ShinyValueMultiplier
	end

	return {
		id = find.id,
		weight = math.floor(weight * 100 + 0.5) / 100,
		value = value,
		shiny = shiny,
	}
end

-- A pillar of light over the player for a few seconds, seen by everyone
local function beacon(player, color)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local pillar = Instance.new("Part")
	pillar.Name = "FindBeacon"
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(60, 2.5, 2.5)
	pillar.CFrame = CFrame.new(root.Position + Vector3.new(0, 28, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.45
	pillar.Parent = Workspace
	task.delay(4, function()
		pillar:Destroy()
	end)
end

-- Legendary and Shiny finds are announced to the whole server
local function announce(player, find, found)
	local rarity = Finds.RarityById[find.rarity]
	if rarity.order < 5 and not found.shiny then
		return
	end
	local text = string.format("%s dug up a %s%s %s!", player.DisplayName, found.shiny and "Shiny " or "", find.rarity, find.name)
	for _, other in ipairs(Players:GetPlayers()) do
		Remotes.Notify:FireClient(other, text, "rare")
	end
	beacon(player, rarity.color)
end

local function coolSpot(player, spot)
	spotCooldowns[player] = spotCooldowns[player] or {}
	spotCooldowns[player][spot] = os.clock() + Config.SpotCooldown
end

-- Ends the dig without a find and tells the player why
local function lose(player, dig, reason)
	if digs[player] == dig then
		clearDig(player)
	end
	-- Once the find is rolled the spot is used up, however the dig ends. Otherwise
	-- players could put the shovel away to reroll a find they don't like.
	if dig.phase == "minigame" and not dig.rush then
		coolSpot(player, dig.spot)
	end
	Remotes.DigResult:FireClient(player, dig.id, nil, reason)
end

local function onReady(player, dig)
	if digs[player] ~= dig or not player.Parent then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end

	local shovel = Shovels.ById[data.equippedShovel] or Shovels.ById[Shovels.Default]
	if dig.rush then
		-- Treasure Rush digs don't find anything themselves; each good one fills the site
		dig.params = Dig.Params(Finds.RarityById.Uncommon, shovel)
		dig.params.rush = true
		dig.phase = "minigame"
		dig.readyAt = os.clock()
		dirtBurst(dig.spot, 12)
		Remotes.DigReady:FireClient(player, dig.id, dig.params)
		task.delay(Dig.MaxSeconds + 5, function()
			if digs[player] == dig then
				lose(player, dig, "timeout")
			end
		end)
		return
	end

	-- The charm is used up now, whatever happens next
	local charm = dig.charm
	if not charm.free then
		DataService.Update(player, function(saved)
			local left = math.max(0, (saved.charms.owned[charm.id] or 0) - 1)
			saved.charms.owned[charm.id] = left
			if left == 0 and saved.charms.equipped == charm.id then
				saved.charms.equipped = Charms.Default
				Remotes.Notify:FireClient(player, "That was your last " .. charm.name .. ".", "info")
			end
		end)
	end

	dig.find = rollFind(data, dig.zone, charm)
	dig.rarity = Finds.RarityById[Finds.ById[dig.find.id].rarity]
	dig.params = Dig.Params(dig.rarity, shovel)
	dig.phase = "minigame"
	dig.readyAt = os.clock()
	dirtBurst(dig.spot, 12)
	Remotes.DigReady:FireClient(player, dig.id, dig.params)

	task.delay(Dig.MaxSeconds + 5, function()
		if digs[player] == dig then
			lose(player, dig, "timeout")
		end
	end)
end

local function onStartDig(player, spot)
	if not isDigSpot(spot) then
		return nil
	end
	local data = DataService.Get(player)
	local runtime = DataService.GetRuntime(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not data or not root or not humanoid or humanoid.Health <= 0 or not shovelTool(player) then
		return nil
	end
	if digs[player] then
		return nil
	end
	if lastDig[player] and os.clock() - lastDig[player] < Config.DigCooldown then
		return nil
	end

	local rush = RushService.IsSite(spot)
	if not rush and #data.bag >= runtime.bagSize then
		if ShopService.HasPass(player, "AutoSell") then
			EconomyService.SellAll(player, true)
		end
		data = DataService.Get(player)
		if #data.bag >= runtime.bagSize then
			Remotes.Notify:FireClient(player, "Your backpack is full! Sell finds at the Trading Post.", "warning")
			return nil
		end
	end

	-- A little extra range for internet lag
	local flat = Vector3.new(spot.Position.X - root.Position.X, 0, spot.Position.Z - root.Position.Z)
	if flat.Magnitude > (rush and Config.RushReach or Config.DigRange) + 4 then
		Remotes.Notify:FireClient(player, "Get closer to the dig spot.", "warning")
		return nil
	end

	local zoneId = spot:GetAttribute("DigSpot")
	if not rush and not data.zones[zoneId] then
		local zone = Zones.ById[zoneId]
		Remotes.Notify:FireClient(player, "Unlock " .. (zone and zone.name or zoneId) .. " to dig here.", "warning")
		return nil
	end
	local readyAt = not rush and spotCooldowns[player] and spotCooldowns[player][spot]
	if readyAt and os.clock() < readyAt then
		Remotes.Notify:FireClient(player, "You already dug here. Try another spot!", "warning")
		return nil
	end

	lastDig[player] = os.clock()
	nextDigId += 1
	-- Charms are only used up on finds, so Treasure Rush digs leave them alone
	local charm = rush and Charms.ById[Charms.Default] or currentCharm(data)
	local dig = {
		id = nextDigId,
		origin = root.Position,
		zone = zoneId,
		spot = spot,
		phase = "digging",
		charm = charm,
		rush = rush,
	}
	digs[player] = dig

	local shovel = Shovels.ById[data.equippedShovel] or Shovels.ById[Shovels.Default]
	local weather = Events.GetWeather()
	local wait = random:NextNumber(Config.DigDownMin, Config.DigDownMax) * shovel.speed * (weather.digMultiplier or 1) * (charm.digSpeed or 1)
	TutorialService.Event(player, "Dig")

	-- The shovel goes up and down while digging, so everyone can see it
	task.spawn(function()
		local lean = 0
		while digs[player] == dig do
			lean = lean == 0 and 35 or 0
			local tool = shovelTool(player)
			if tool then
				tool.Grip = gripFor(lean)
			end
			if lean > 0 then
				dirtBurst(spot, 4)
			end
			task.wait(0.3)
		end
	end)
	task.delay(wait, onReady, player, dig)
	return dig.id
end

-- Puts a find in the backpack and the Collection, adds XP and level-up coins,
-- tells the player (as dig result digId) and shows it off to everyone
local function awardFind(player, digId, found, details)
	local find = Finds.ById[found.id]
	local levelBefore, levelAfter = 1, 1
	local isNew, isRecord = DataService.Update(player, function(data)
		found.uid = data.nextUid
		data.nextUid += 1
		table.insert(data.bag, found)
		data.totalFound += 1
		local entry = data.book[found.id]
		local firstTime = entry == nil
		if firstTime then
			entry = { count = 0, best = 0, shiny = 0 }
			data.book[found.id] = entry
		end
		local record = not firstTime and found.weight > entry.best
		entry.count += 1
		entry.best = math.max(entry.best, found.weight)
		if found.shiny then
			entry.shiny += 1
		end

		levelBefore = Level.FromXp(data.xp)
		data.xp += Level.XpForFind(found.id, firstTime)
		levelAfter = Level.FromXp(data.xp)
		for level = levelBefore + 1, levelAfter do
			data.coins += level * Level.CoinsPerLevel
		end
		return firstTime, record
	end)

	local result = {
		id = found.id,
		weight = found.weight,
		value = found.value,
		shiny = found.shiny,
		isNew = isNew,
		isRecord = isRecord,
		xp = Level.XpForFind(found.id, isNew),
	}
	for key, value in pairs(details) do
		result[key] = value
	end
	Remotes.DigResult:FireClient(player, digId, result)
	if levelAfter > levelBefore then
		Remotes.Notify:FireClient(player, string.format("LEVEL UP! You're now a Lv %d digger. +%s coins", levelAfter, Format.Number(levelAfter * Level.CoinsPerLevel)), "rare")
	end
	DigService.ShowOff(player, found)
	announce(player, find, found)
end

local function onDigDone(player, digId, outcome, perfects)
	local dig = digs[player]
	if not dig or dig.id ~= digId or dig.phase ~= "minigame" then
		return
	end
	if outcome ~= "found" then
		lose(player, dig, "cracked")
		return
	end
	-- Nobody can dig a find out faster than a perfect, non-stop tapper
	if os.clock() - dig.readyAt < Dig.MinSeconds(dig.params) * 0.9 then
		lose(player, dig, "cracked")
		return
	end
	clearDig(player)

	if dig.rush then
		local progress, target = RushService.AddDig(player)
		Remotes.DigResult:FireClient(player, digId, { rush = true, progress = progress, target = target })
		return
	end
	coolSpot(player, dig.spot)

	perfects = math.clamp(math.floor(tonumber(perfects) or 0), 0, dig.params.strikes)
	local found = dig.find
	local buddy = player:GetAttribute("DigBuddy")
	found.value = math.max(1, math.floor(found.value * Dig.ValueMultiplier(perfects, dig.params.strikes) * BuddyService.Multiplier(player)))
	awardFind(player, digId, found, {
		perfects = perfects,
		strikes = dig.params.strikes,
		buddy = buddy,
	})
	TutorialService.Event(player, "Find")

	local data = DataService.Get(player)
	local runtime = DataService.GetRuntime(player)
	if data and runtime and #data.bag >= runtime.bagSize and ShopService.HasPass(player, "AutoSell") then
		EconomyService.SellAll(player, true)
	end
end

-- Treasure Rush loot: a find of at least this rarity from the best zone the
-- player has unlocked. It goes in the backpack even if the backpack is full.
function DigService.GiveRushLoot(player, minOrder)
	local data = DataService.Get(player)
	if not data or not player.Parent then
		return
	end
	local zoneId = Zones.Default
	for _, zone in ipairs(Zones.List) do
		if data.zones[zone.id] then
			zoneId = zone.id
		end
	end
	local found = rollFind(data, zoneId, Charms.ById[Charms.Default], minOrder)
	found.value = math.max(1, math.floor(found.value))
	awardFind(player, "rush", found, { rushLoot = true })
end

-- The player holds the find up over their head for everyone to see
function DigService.ShowOff(player, found)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local model = head and FindModel.Build(found.id, found.weight, found.shiny)
	if not model then
		return
	end
	local size = FindModel.SizeFor(found.weight)
	local body = model.PrimaryPart
	model:PivotTo(head.CFrame * CFrame.new(0, 1.2 + size * 0.5, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = body
	weld.Parent = body
	model.Parent = character
	task.delay(2.5, function()
		model:Destroy()
	end)
end

-- Builds the shovel tool from the player's equipped shovel and shovel skin
local function buildShovel(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local shovel = Shovels.ById[data.equippedShovel] or Shovels.ById[Shovels.Default]

	local tool = Instance.new("Tool")
	tool.Name = SHOVEL_NAME
	tool.ToolTip = shovel.name
	tool.CanBeDropped = false
	tool.RequiresHandle = true

	ShovelModel.Build(tool, shovel, SHOVEL_LENGTH)

	-- Hold the shovel near its top end, blade down
	tool.Grip = gripFor(0)

	CosmeticService.StyleShovel(player, tool)
	return tool
end

local function giveShovel(player)
	local backpack = player:WaitForChild("Backpack", 10)
	if not backpack then
		return
	end
	local character = player.Character
	local wasEquipped = character and character:FindFirstChild(SHOVEL_NAME) ~= nil
	for _, container in ipairs({ backpack, character }) do
		local old = container and container:FindFirstChild(SHOVEL_NAME)
		if old then
			old:Destroy()
		end
	end
	local tool = buildShovel(player)
	if not tool then
		return
	end
	if wasEquipped and character then
		tool.Parent = character
	else
		tool.Parent = backpack
	end
end

function DigService.GiveShovel(player)
	clearDig(player)
	giveShovel(player)
end

function DigService.Start()
	-- Walking away from your hole stops digging
	task.spawn(function()
		while true do
			task.wait(0.3)
			for player, dig in pairs(digs) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root or (root.Position - dig.origin).Magnitude > WANDER_LIMIT then
					lose(player, dig, "walked")
				end
			end
		end
	end)

	Remotes.StartDig.OnServerInvoke = function(player, spot)
		return onStartDig(player, spot)
	end
	Remotes.DigDone.OnServerEvent:Connect(onDigDone)
	Remotes.CancelDig.OnServerEvent:Connect(function(player)
		local dig = digs[player]
		if dig then
			lose(player, dig, "walked")
		end
	end)

	DataService.OnLoaded(function(player)
		player.CharacterAdded:Connect(function()
			local dig = digs[player]
			if dig then
				lose(player, dig, "walked")
			end
			task.defer(giveShovel, player)
		end)
		task.spawn(function()
			if DataService.WaitFor(player) and player.Character then
				giveShovel(player)
			end
		end)
	end)

	-- Rebuild the shovel when the player equips a new shovel or shovel skin
	local shovelLooks = {}
	DataService.OnChanged(function(player, data)
		local look = data.equippedShovel .. "|" .. tostring(data.cosmetics.equipped.shovelSkin)
		if shovelLooks[player] ~= nil and shovelLooks[player] ~= look then
			DigService.GiveShovel(player)
		end
		shovelLooks[player] = look
	end)

	Players.PlayerRemoving:Connect(function(player)
		clearDig(player)
		lastDig[player] = nil
		spotCooldowns[player] = nil
		shovelLooks[player] = nil
	end)
end

return DigService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[-- Coins: the Trading Post, charms, bounties, shovels, zones, rebirths and daily
-- rewards, plus the menu buttons players press (all go through the "Action" remote).

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Finds = require(Shared.Finds)
local Shovels = require(Shared.Shovels)
local Zones = require(Shared.Zones)
local Shop = require(Shared.Shop)
local Charms = require(Shared.Charms)
local Market = require(Shared.Market)
local Bounties = require(Shared.Bounties)
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)
local TutorialService = require(script.Parent.TutorialService)

local EconomyService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind)
end

-- True if the player stands near a station (Trading Post, Charm Cart). Maps without
-- that station don't require it.
local function nearStation(player, station)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local found = false
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == station then
			found = true
			if root and (item.Position - root.Position).Magnitude <= Config.StationRange then
				return true
			end
		end
	end
	return not found
end

local function findInBag(data, uid)
	for index, find in ipairs(data.bag) do
		if find.uid == uid then
			return index, find
		end
	end
	return nil
end

-- Sells every find that isn't marked as a favorite.
-- auto = true for the Auto Sell pass (works anywhere).
function EconomyService.SellAll(player, auto)
	local data = DataService.Get(player)
	if not data then
		return false, "Still loading"
	end
	if not auto and not nearStation(player, "Sell") then
		return false, "Sell finds at the Trading Post"
	end
	local hot = Market.HotFinds()
	local count, earned = DataService.Update(player, function(saved)
		local keep, total, sold = {}, 0, 0
		for _, find in ipairs(saved.bag) do
			if find.favorite then
				table.insert(keep, find)
			else
				total += Market.Price(find, saved, hot)
				sold += 1
			end
		end
		saved.coins += total
		saved.totalEarned += total
		saved.bag = keep
		return sold, total
	end)
	if count == 0 then
		return false, "Nothing to sell (favorites are never sold)"
	end
	notify(player, string.format("Sold %d %s for %s coins", count, count == 1 and "find" or "finds", Format.Number(earned)), "coins")
	if not auto then
		TutorialService.Event(player, "Sell")
	end
	return true
end

function EconomyService.SellFind(player, uidText)
	local data = DataService.Get(player)
	local uid = tonumber(uidText)
	if not data or not uid then
		return false, "Unknown find"
	end
	if not nearStation(player, "Sell") then
		return false, "Sell finds at the Trading Post"
	end
	local index, find = findInBag(data, uid)
	if not index then
		return false, "That find is gone"
	end
	if find.favorite then
		return false, "Unfavorite it first"
	end
	local price = Market.Price(find, data)
	DataService.Update(player, function(saved)
		table.remove(saved.bag, index)
		saved.coins += price
		saved.totalEarned += price
	end)
	notify(player, string.format("Sold %s for %s coins", Finds.ById[find.id].name, Format.Number(price)), "coins")
	TutorialService.Event(player, "Sell")
	return true
end

function EconomyService.ToggleFavorite(player, uidText)
	local data = DataService.Get(player)
	local index = data and findInBag(data, tonumber(uidText))
	if not index then
		return false, "That find is gone"
	end
	DataService.Update(player, function(saved)
		saved.bag[index].favorite = not saved.bag[index].favorite or nil
	end)
	return true
end

function EconomyService.EquipCharm(player, charmId)
	local charm = Charms.ById[charmId]
	local data = DataService.Get(player)
	if not charm or not data then
		return false, "Unknown charm"
	end
	if not charm.free and (data.charms.owned[charm.id] or 0) <= 0 then
		return false, "You don't have any " .. charm.name
	end
	DataService.Update(player, function(saved)
		saved.charms.equipped = charm.id
	end)
	return true
end

function EconomyService.BuyCharm(player, charmId)
	local charm = Charms.ById[charmId]
	local data = DataService.Get(player)
	if not charm or not data or not charm.price then
		return false, "You can't buy that"
	end
	if not nearStation(player, "Charms") then
		return false, "Buy charms at the Charm Cart"
	end
	if data.coins < charm.price then
		return false, "Not enough coins"
	end
	DataService.Update(player, function(saved)
		saved.coins -= charm.price
		saved.charms.owned[charm.id] = (saved.charms.owned[charm.id] or 0) + charm.buyAmount
	end)
	notify(player, string.format("+%d %s", charm.buyAmount, charm.name), "success")
	return true
end

-- Which backpack finds a recipe would use: the cheapest non-favorite finds of each rarity
local function pickIngredients(data, recipe)
	local used = {}
	for _, need in ipairs(recipe) do
		local candidates = {}
		for _, find in ipairs(data.bag) do
			if not find.favorite and not used[find.uid] and Finds.ById[find.id].rarity == need.rarity then
				table.insert(candidates, find)
			end
		end
		if #candidates < need.count then
			return nil
		end
		table.sort(candidates, function(a, b)
			return a.value < b.value
		end)
		for i = 1, need.count do
			used[candidates[i].uid] = true
		end
	end
	return used
end
EconomyService.PickIngredients = pickIngredients

function EconomyService.CraftCharm(player, charmId)
	local charm = Charms.ById[charmId]
	local data = DataService.Get(player)
	if not charm or not data or not charm.recipe then
		return false, "You can't make that"
	end
	if not nearStation(player, "Charms") then
		return false, "Make charms at the Charm Cart"
	end
	local used = pickIngredients(data, charm.recipe)
	if not used then
		return false, "You don't have the finds for that (favorites are never used)"
	end
	DataService.Update(player, function(saved)
		local keep = {}
		for _, find in ipairs(saved.bag) do
			if not used[find.uid] then
				table.insert(keep, find)
			end
		end
		saved.bag = keep
		saved.charms.owned[charm.id] = (saved.charms.owned[charm.id] or 0) + charm.craftAmount
	end)
	notify(player, string.format("Made %d %s", charm.craftAmount, charm.name), "success")
	return true
end

-- Gives the player today's bounties if they don't have them yet
local function refreshBounties(player, data)
	local today = Bounties.Today(os.time())
	if data.bounties.day ~= today then
		data.bounties = { day = today, list = Bounties.Generate(player.UserId, today, data.zones) }
		return true
	end
	return false
end

function EconomyService.ClaimBounty(player, indexText)
	local data = DataService.Get(player)
	local index = tonumber(indexText)
	local bounty = data and index and data.bounties.list[index]
	if not bounty or bounty.done then
		return false, "That bounty is gone"
	end
	local chosen, found = {}, 0
	for _, find in ipairs(data.bag) do
		if find.id == bounty.findId and not find.favorite and found < bounty.count then
			chosen[find.uid] = true
			found += 1
		end
	end
	if found < bounty.count then
		return false, string.format("You need %d %s (favorites don't count)", bounty.count, Finds.ById[bounty.findId].name)
	end
	local reward = Bounties.Reward(bounty, Market.Multiplier(data))
	DataService.Update(player, function(saved)
		local keep = {}
		for _, find in ipairs(saved.bag) do
			if not chosen[find.uid] then
				table.insert(keep, find)
			end
		end
		saved.bag = keep
		saved.coins += reward
		saved.totalEarned += reward
		saved.charms.owned[bounty.charm] = (saved.charms.owned[bounty.charm] or 0) + bounty.charmAmount
		saved.bounties.list[index].done = true
	end)
	notify(player, string.format("Bounty done! +%s coins, +%d %s", Format.Number(reward), bounty.charmAmount, Charms.ById[bounty.charm].name), "coins")
	return true
end

function EconomyService.BuyShovel(player, shovelId)
	local shovel = Shovels.ById[shovelId]
	local data = DataService.Get(player)
	if not shovel or not data then
		return false, "Unknown shovel"
	end
	if data.shovelsOwned[shovel.id] then
		return EconomyService.EquipShovel(player, shovelId)
	end
	if shovel.requiresRebirths and data.rebirths < shovel.requiresRebirths then
		return false, string.format("Needs %d rebirth(s)", shovel.requiresRebirths)
	end
	if data.coins < shovel.price then
		return false, "Not enough coins"
	end
	DataService.Update(player, function(saved)
		saved.coins -= shovel.price
		saved.shovelsOwned[shovel.id] = true
		saved.equippedShovel = shovel.id
	end)
	notify(player, "You bought the " .. shovel.name .. "!", "success")
	return true
end

function EconomyService.EquipShovel(player, shovelId)
	local data = DataService.Get(player)
	if not data or not data.shovelsOwned[shovelId] then
		return false, "You don't own that shovel"
	end
	DataService.Update(player, function(saved)
		saved.equippedShovel = shovelId
	end)
	return true
end

function EconomyService.UnlockZone(player, zoneId)
	local zone = Zones.ById[zoneId]
	local data = DataService.Get(player)
	if not zone or not data then
		return false, "Unknown zone"
	end
	if data.zones[zone.id] then
		return true
	end
	local previous = Zones.Previous(zone.id)
	if previous and not data.zones[previous.id] then
		return false, string.format("Unlock %s first", previous.name)
	end
	if Level.FromXp(data.xp) < zone.level then
		return false, string.format("Reach digger level %d to unlock %s", zone.level, zone.name)
	end
	if data.coins < zone.price then
		return false, string.format("You need %s coins to unlock %s", Format.Number(zone.price), zone.name)
	end
	DataService.Update(player, function(saved)
		saved.coins -= zone.price
		saved.zones[zone.id] = true
	end)
	notify(player, zone.name .. " unlocked!", "success")
	return true
end

function EconomyService.Teleport(player, zoneId)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return false, "Not ready"
	end
	if zoneId ~= "hub" then
		if not ShopService.HasPass(player, "Teleporter") then
			return false, "The Zone Teleporter pass lets you teleport to zones"
		end
		if not data.zones[zoneId] then
			return false, "Unlock that zone first"
		end
	end
	for _, item in ipairs(workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("ZoneSpawn") == zoneId then
			character:PivotTo(item.CFrame + Vector3.new(0, 4, 0))
			return true
		end
	end
	return false, "No teleport spot for that zone"
end

function EconomyService.Rebirth(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Not ready"
	end
	local cost = Config.RebirthCost(data.rebirths)
	local requiredZone = Zones.ById[Config.RebirthRequiresZone]
	if requiredZone and not data.zones[requiredZone.id] then
		return false, "Unlock " .. requiredZone.name .. " first"
	end
	if data.coins < cost then
		return false, string.format("You need %s coins to rebirth", Format.Number(cost))
	end
	DataService.Update(player, function(saved)
		-- Keep: collection book, favorite finds, charms, cosmetics, titles, stats. Reset: coins, shovels, zones, other finds.
		saved.rebirths += 1
		saved.coins = 0
		local favorites = {}
		for _, find in ipairs(saved.bag) do
			if find.favorite then
				table.insert(favorites, find)
			end
		end
		saved.bag = favorites
		saved.shovelsOwned = { [Shovels.Default] = true }
		saved.equippedShovel = Shovels.Default
		saved.zones = { [Zones.Default] = true }
	end)
	EconomyService.Teleport(player, "hub")
	notify(player, string.format("Reborn! You now earn +%d%% coins from finds.", math.floor((Market.Multiplier(DataService.Get(player)) - 1) * 100 + 0.5)), "success")
	return true
end

function EconomyService.EquipCosmetic(player, cosmeticId)
	local item = Shop.CosmeticById[cosmeticId]
	local data = DataService.Get(player)
	if not item or not data or not data.cosmetics.owned[cosmeticId] then
		return false, "You don't own that"
	end
	DataService.Update(player, function(saved)
		if saved.cosmetics.equipped[item.kind] == cosmeticId then
			saved.cosmetics.equipped[item.kind] = nil -- pressing again takes it off
		else
			saved.cosmetics.equipped[item.kind] = cosmeticId
		end
	end)
	return true
end

local function giveDailyReward(player, data)
	local today = math.floor(os.time() / 86400)
	if data.lastDailyDay == today then
		return
	end
	if data.lastDailyDay == today - 1 then
		data.dailyStreak += 1
	else
		data.dailyStreak = 1
	end
	data.lastDailyDay = today
	local day = math.min(data.dailyStreak, Config.DailyStreakCap)
	local reward = math.floor(Config.DailyRewardBase * day * Market.Multiplier(data))
	data.coins += reward
	data.totalEarned += reward
	task.spawn(function()
		if DataService.WaitFor(player) then
			notify(player, string.format("Daily reward (day %d streak): +%s coins! Come back tomorrow for more.", data.dailyStreak, Format.Number(reward)), "coins")
		end
	end)
end

local actions = {
	SellAll = function(player)
		return EconomyService.SellAll(player, false)
	end,
	SellFind = EconomyService.SellFind,
	ToggleFavorite = EconomyService.ToggleFavorite,
	EquipCharm = EconomyService.EquipCharm,
	BuyCharm = EconomyService.BuyCharm,
	CraftCharm = EconomyService.CraftCharm,
	ClaimBounty = EconomyService.ClaimBounty,
	BuyShovel = EconomyService.BuyShovel,
	EquipShovel = EconomyService.EquipShovel,
	UnlockZone = EconomyService.UnlockZone,
	Teleport = EconomyService.Teleport,
	Rebirth = EconomyService.Rebirth,
	EquipCosmetic = EconomyService.EquipCosmetic,
}

function EconomyService.Start()
	DataService.OnLoaded(function(player, data)
		giveDailyReward(player, data)
		refreshBounties(player, data)
	end)

	-- New bounties at midnight UTC for players who are online
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
				local data = DataService.Get(player)
				if data and data.bounties.day ~= Bounties.Today(os.time()) then
					DataService.Update(player, function(saved)
						refreshBounties(player, saved)
					end)
				end
			end
		end
	end)

	Remotes.Action.OnServerInvoke = function(player, actionName, argument)
		local action = actions[actionName]
		if type(actionName) ~= "string" or not action then
			return false, "Unknown action"
		end
		if argument ~= nil and type(argument) ~= "string" then
			return false, "Bad request"
		end
		local ok, success, message = pcall(action, player, argument)
		if not ok then
			warn("[EconomyService] " .. actionName .. " failed: " .. tostring(success))
			return false, "Something went wrong"
		end
		return success, message
	end
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds a simple starter world (Dig Town + one island per zone) when the place
-- has no folder called "Map" in Workspace. That means the game is playable the
-- moment you press Play. To use your own scenery later, the game only cares
-- about parts with these attributes:
--   DigSpot     = "backyard"   a patch of dirt you can dig (players stand next to it)
--   ZoneGate    = "desert"     wall that blocks a locked zone
--   ZoneSpawn   = "backyard"   where the teleporter drops players
--   Station     = "Sell" / "Shovels" / "Charms" / "Bounties" / "Leaderboard" / "EventBoard"
--   VipDoor     = true         door only VIP players can walk through
--   Npc         = "Gus"        where a shopkeeper stands (see NpcService)
--   GuideTarget = "DigPatch"   where Grandpa Gus's guide arrow points
--   RushSite    = true         where the Treasure Rush dig site pops up (see RushService)

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Zones = require(Shared.Zones)
local Format = require(Shared.Format)

local MapBuilder = {}

local GROUND_Y = 3

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function sign(parentPart, text, face, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parentPart
	return label
end

local function prompt(parentPart, action, object, distance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.Parent = parentPart
	return p
end

local function island(folder, name, center, size, topColor, topMaterial)
	part({
		Name = name .. "Beach",
		Size = Vector3.new(size.X + 16, 6, size.Z + 16),
		Position = Vector3.new(center.X, GROUND_Y - 4, center.Z),
		Material = Enum.Material.Sand,
		Color = Color3.fromRGB(235, 215, 160),
		Parent = folder,
	})
	part({
		Name = name .. "Ground",
		Size = Vector3.new(size.X, 1, size.Z),
		Position = Vector3.new(center.X, GROUND_Y - 0.5, center.Z),
		Material = topMaterial or Enum.Material.Grass,
		Color = topColor,
		Parent = folder,
	})
end

local function tree(folder, position, leafColor, random)
	local height = random:NextNumber(10, 16)
	part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 2, 2),
		CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(110, 80, 50),
		Parent = folder,
	})
	part({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * random:NextNumber(8, 12),
		Position = position + Vector3.new(0, height + 2, 0),
		Material = Enum.Material.Grass,
		Color = leafColor,
		CanCollide = false,
		Parent = folder,
	})
end

local function stall(folder, name, position, color, title)
	local model = Instance.new("Model")
	model.Name = name
	local counter = part({
		Name = "Counter",
		Size = Vector3.new(14, 4, 4),
		Position = position + Vector3.new(0, 2, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(160, 110, 70),
		Parent = model,
	})
	for _, x in ipairs({ -6.5, 6.5 }) do
		part({
			Name = "Post",
			Size = Vector3.new(1, 10, 1),
			Position = position + Vector3.new(x, 5, -3),
			Material = Enum.Material.Wood,
			Color = Color3.fromRGB(110, 80, 50),
			Parent = model,
		})
	end
	part({
		Name = "Roof",
		Size = Vector3.new(16, 1, 8),
		Position = position + Vector3.new(0, 10.5, -1.5),
		Material = Enum.Material.Fabric,
		Color = color,
		Parent = model,
	})
	local board = part({
		Name = "Sign",
		Size = Vector3.new(12, 3, 0.5),
		Position = position + Vector3.new(0, 12.5, 2),
		Color = Color3.fromRGB(60, 40, 30),
		Parent = model,
	})
	sign(board, title, Enum.NormalId.Front)
	sign(board, title, Enum.NormalId.Back)
	model.Parent = folder
	return counter
end

local function board(folder, name, cframe, size, station)
	local p = part({
		Name = name,
		Size = size,
		CFrame = cframe,
		Color = Color3.fromRGB(30, 40, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	p:SetAttribute("Station", station)
	return p
end

local function lamp(folder, position)
	part({ Name = "LampPost", Size = Vector3.new(0.6, 9, 0.6), Position = position + Vector3.new(0, 4.5, 0), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal, Parent = folder })
	local bulb = part({ Name = "LampBulb", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.4, Position = position + Vector3.new(0, 9.4, 0), Color = Color3.fromRGB(255, 220, 150), Material = Enum.Material.Neon, CanCollide = false, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 210, 150)
	light.Parent = bulb
end

local function crate(folder, position, random)
	local size = random:NextNumber(2.5, 4)
	part({ Name = "Crate", Size = Vector3.one * size, CFrame = CFrame.new(position + Vector3.new(0, size / 2, 0)) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(170, 125, 75), Parent = folder })
end

local function barrel(folder, position)
	part({ Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.5, 2.6, 2.6), CFrame = CFrame.new(position + Vector3.new(0, 1.75, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Wood, Color = Color3.fromRGB(120, 80, 45), Parent = folder })
end

-- A sparkling patch of dirt. Players stand next to it and dig.
local function digSpot(folder, position, zoneId, random)
	local spot = part({
		Name = "DigSpot",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 5, 5),
		CFrame = CFrame.new(position.X, GROUND_Y + 0.1, position.Z) * CFrame.Angles(0, random:NextNumber(0, math.pi), math.rad(90)),
		Material = Enum.Material.Ground,
		Color = Color3.fromRGB(105, 75, 45),
		CanCollide = false,
		Parent = folder,
	})
	spot:SetAttribute("DigSpot", zoneId)
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkle"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(Color3.fromRGB(255, 230, 140))
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.8, 1.4)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(60, 60)
	sparkles.EmissionDirection = Enum.NormalId.Right -- the cylinder lies on its side, so +X points up
	sparkles.Rate = 4
	sparkles.Parent = spot
	return spot
end

-- Places dig spots inside an area, at least 9 studs apart and away from the middle path
local function scatterSpots(folder, center, half, count, zoneId, random, placed)
	local tries = 0
	while count > 0 and tries < 400 do
		tries += 1
		local at = Vector3.new(center.X + random:NextNumber(-half.X, half.X), 0, center.Z + random:NextNumber(-half.Z, half.Z))
		local clear = math.abs(at.Z - center.Z) > 8
		for _, other in ipairs(placed) do
			if (other - at).Magnitude < 9 then
				clear = false
				break
			end
		end
		if clear then
			table.insert(placed, at)
			digSpot(folder, at, zoneId, random)
			count -= 1
		end
	end
end

local function fence(folder, from, to)
	local length = (to - from).Magnitude
	local middle = (from + to) / 2
	local look = CFrame.lookAt(middle, to)
	part({ Name = "FenceRail", Size = Vector3.new(0.4, 0.5, length), CFrame = look * CFrame.new(0, 2.2, 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(235, 230, 215), Parent = folder })
	for i = 0, math.floor(length / 4) do
		part({ Name = "FencePost", Size = Vector3.new(0.5, 3, 0.5), CFrame = look * CFrame.new(0, 1.5, -length / 2 + i * length / math.max(1, math.floor(length / 4))), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(235, 230, 215), Parent = folder })
	end
end

local function shed(folder, position, color)
	part({ Name = "Shed", Size = Vector3.new(10, 8, 8), Position = position + Vector3.new(0, 4, 0), Material = Enum.Material.WoodPlanks, Color = color, Parent = folder })
	for _, side in ipairs({ -1, 1 }) do
		local roof = Instance.new("WedgePart")
		roof.Name = "ShedRoof"
		roof.Anchored = true
		roof.Size = Vector3.new(11, 3, 4.5)
		roof.CFrame = CFrame.new(position + Vector3.new(0, 9.5, side * 2.25)) * CFrame.Angles(0, side > 0 and math.pi or 0, 0)
		roof.Material = Enum.Material.Slate
		roof.Color = Color3.fromRGB(120, 60, 50)
		roof.Parent = folder
	end
	part({ Name = "ShedDoor", Size = Vector3.new(3, 6, 0.2), Position = position + Vector3.new(0, 3, 4.05), Material = Enum.Material.Wood, Color = Color3.fromRGB(90, 60, 40), Parent = folder })
end

local function gnome(folder, position, hatColor)
	part({ Name = "GnomeBody", Size = Vector3.new(1.2, 1.4, 1.2), Position = position + Vector3.new(0, 0.7, 0), Color = Color3.fromRGB(60, 90, 200), Parent = folder })
	part({ Name = "GnomeHead", Shape = Enum.PartType.Ball, Size = Vector3.one, Position = position + Vector3.new(0, 1.9, 0), Color = Color3.fromRGB(234, 184, 146), Parent = folder })
	part({ Name = "GnomeBeard", Size = Vector3.new(0.8, 0.6, 0.3), Position = position + Vector3.new(0, 1.55, -0.5), Color = Color3.fromRGB(245, 245, 245), Parent = folder })
	part({ Name = "GnomeHat", Size = Vector3.new(0.9, 0.6, 0.9), Position = position + Vector3.new(0, 2.6, 0), Color = hatColor, Parent = folder })
	part({ Name = "GnomeHatTip", Size = Vector3.new(0.45, 0.6, 0.45), Position = position + Vector3.new(0, 3.2, 0), Color = hatColor, Parent = folder })
end

local function rock(folder, position, color, random)
	local size = random:NextNumber(2, 5)
	part({ Name = "Rock", Size = Vector3.new(size, size * 0.7, size * 0.9), CFrame = CFrame.new(position + Vector3.new(0, size * 0.3, 0)) * CFrame.Angles(random:NextNumber(-0.3, 0.3), random:NextNumber(0, math.pi), random:NextNumber(-0.3, 0.3)), Material = Enum.Material.Slate, Color = color, Parent = folder })
end

local function lighthouse(folder, position)
	for i = 0, 4 do
		part({
			Name = "LighthouseBand",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(8, 10 - i * 0.8, 10 - i * 0.8),
			CFrame = CFrame.new(position + Vector3.new(0, 4 + i * 8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = i % 2 == 0 and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(200, 50, 50),
			Parent = folder,
		})
	end
	local lamp = part({ Name = "LighthouseLamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 5, Position = position + Vector3.new(0, 42.5, 0), Color = Color3.fromRGB(255, 240, 170), Material = Enum.Material.Neon, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 60
	light.Brightness = 2
	light.Parent = lamp
	part({ Name = "LighthouseRoof", Size = Vector3.new(7, 1, 7), Position = position + Vector3.new(0, 45.5, 0), Color = Color3.fromRGB(60, 60, 70), Parent = folder })
end

-- True when a spot of this size at "at" keeps clear of the dig spots
local function clearOf(placed, at, radius)
	for _, spot in ipairs(placed) do
		if (Vector3.new(at.X, 0, at.Z) - Vector3.new(spot.X, 0, spot.Z)).Magnitude < radius then
			return false
		end
	end
	return true
end

local function cactus(folder, position, random)
	local height = random:NextNumber(6, 10)
	local green = Color3.fromRGB(70, 140, 70)
	part({ Name = "Cactus", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 1.8, 1.8), CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Grass, Color = green, Parent = folder })
	for _, side in ipairs({ -1, 1 }) do
		local armY = random:NextNumber(height * 0.4, height * 0.7)
		part({ Name = "CactusArm", Size = Vector3.new(2, 1.2, 1.2), Position = position + Vector3.new(side * 1.4, armY, 0), Material = Enum.Material.Grass, Color = green, Parent = folder })
		part({ Name = "CactusArm", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 1.2, 1.2), CFrame = CFrame.new(position + Vector3.new(side * 2.2, armY + 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Grass, Color = green, Parent = folder })
	end
end

local function pyramid(folder, position, base)
	local steps = 5
	for i = 0, steps - 1 do
		local width = base * (1 - i / steps)
		part({ Name = "PyramidStep", Size = Vector3.new(width, 2.4, width), Position = position + Vector3.new(0, 1.2 + i * 2.4, 0), Material = Enum.Material.Sandstone, Color = Color3.fromRGB(225, 190, 120), Parent = folder })
	end
	part({ Name = "PyramidTop", Size = Vector3.new(2, 1.5, 2), Position = position + Vector3.new(0, steps * 2.4 + 0.75, 0), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 210, 80), Parent = folder })
end

local function crystal(folder, position, color, random)
	local first
	for _ = 1, random:NextInteger(3, 5) do
		local height = random:NextNumber(3, 8)
		local width = random:NextNumber(0.8, 1.6)
		local piece = part({
			Name = "Crystal",
			Size = Vector3.new(width, height, width),
			CFrame = CFrame.new(position + Vector3.new(random:NextNumber(-1.5, 1.5), height * 0.4, random:NextNumber(-1.5, 1.5))) * CFrame.Angles(random:NextNumber(-0.5, 0.5), random:NextNumber(0, math.pi), random:NextNumber(-0.5, 0.5)),
			Material = Enum.Material.Glass,
			Color = color,
			Transparency = 0.2,
			Parent = folder,
		})
		first = first or piece
	end
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 14
	glow.Brightness = 1.5
	glow.Parent = first
end

local function column(folder, position, height, broken, random)
	local marble = Color3.fromRGB(225, 225, 215)
	part({ Name = "ColumnBase", Size = Vector3.new(3.2, 0.8, 3.2), Position = position + Vector3.new(0, 0.4, 0), Material = Enum.Material.Marble, Color = marble, Parent = folder })
	part({ Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 2.2, 2.2), CFrame = CFrame.new(position + Vector3.new(0, 0.8 + height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Marble, Color = marble, Parent = folder })
	if not broken then
		part({ Name = "ColumnTop", Size = Vector3.new(3.2, 0.8, 3.2), Position = position + Vector3.new(0, 1.2 + height, 0), Material = Enum.Material.Marble, Color = marble, Parent = folder })
	else
		part({ Name = "ColumnPiece", Shape = Enum.PartType.Cylinder, Size = Vector3.new(random:NextNumber(3, 5), 2.2, 2.2), CFrame = CFrame.new(position + Vector3.new(random:NextNumber(2.5, 4), 1.1, random:NextNumber(-2, 2))) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0), Material = Enum.Material.Marble, Color = marble, Parent = folder })
	end
end

-- An archway over the path where the bridge reaches an island
local function arch(folder, position, color, material)
	for _, z in ipairs({ -6, 6 }) do
		part({ Name = "ArchPillar", Size = Vector3.new(3, 14, 3), Position = position + Vector3.new(0, 7, z), Material = material, Color = color, Parent = folder })
	end
	part({ Name = "ArchTop", Size = Vector3.new(4, 3, 17), Position = position + Vector3.new(0, 15.5, 0), Material = material, Color = color, Parent = folder })
end

local function lavaPool(folder, position, size)
	local pool = part({ Name = "LavaPool", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, size, size), CFrame = CFrame.new(position + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 100, 20), CanCollide = false, Parent = folder })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = size * 1.5
	light.Brightness = 2
	light.Parent = pool
end

-- A smoking volcano out in the sea behind the last island
local function volcanoMountain(folder, position)
	for i = 0, 5 do
		local width = 70 - i * 10
		part({ Name = "VolcanoSlope", Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, width, width), CFrame = CFrame.new(position + Vector3.new(0, -4 + i * 8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Basalt, Color = Color3.fromRGB(55, 45, 45), Parent = folder })
	end
	local crater = part({ Name = "VolcanoCrater", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 16, 16), CFrame = CFrame.new(position + Vector3.new(0, 40.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 90, 20), Parent = folder })
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(70, 60, 60))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 25) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(6, 9)
	smoke.Speed = NumberRange.new(8, 14)
	smoke.Rate = 3
	smoke.EmissionDirection = Enum.NormalId.Right -- the cylinder lies on its side, so +X points up
	smoke.Parent = crater
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 110, 40)
	light.Range = 40
	light.Brightness = 3
	light.Parent = crater
end

-- Props that give each zone island its own look, kept away from the dig spots, trees and rocks in placed
local function decorateZone(folder, zoneId, centerX, placed, random)
	local function each(count, radius, place)
		local tries = 0
		while count > 0 and tries < 200 do
			tries += 1
			local at = Vector3.new(centerX + random:NextNumber(-42, 42), GROUND_Y, random:NextNumber(-42, 42))
			if math.abs(at.Z) > 9 and clearOf(placed, at, radius) then
				place(at)
				table.insert(placed, Vector3.new(at.X, 0, at.Z))
				count -= 1
			end
		end
	end
	local entrance = Vector3.new(centerX - 45, GROUND_Y, 0) -- the island's west edge, clear of the dig spots
	if zoneId == "backyard" then
		shed(folder, Vector3.new(centerX + 30, GROUND_Y, -36), Color3.fromRGB(170, 70, 60))
		gnome(folder, Vector3.new(centerX - 20, GROUND_Y, 14), Color3.fromRGB(60, 160, 60))
	elseif zoneId == "desert" then
		each(1, 12, function(at)
			pyramid(folder, at, 14)
		end)
		each(6, 5, function(at)
			cactus(folder, at, random)
		end)
	elseif zoneId == "caves" then
		arch(folder, entrance, Color3.fromRGB(80, 70, 100), Enum.Material.Slate)
		local colors = { Color3.fromRGB(180, 120, 255), Color3.fromRGB(110, 230, 255), Color3.fromRGB(255, 130, 220) }
		each(7, 6, function(at)
			crystal(folder, at, colors[random:NextInteger(1, #colors)], random)
		end)
	elseif zoneId == "ruins" then
		arch(folder, entrance, Color3.fromRGB(215, 215, 200), Enum.Material.Marble)
		each(7, 6, function(at)
			column(folder, at, random:NextNumber(5, 12), random:NextNumber() < 0.5, random)
		end)
	elseif zoneId == "volcano" then
		each(5, 7, function(at)
			lavaPool(folder, at, random:NextNumber(4, 7))
		end)
		volcanoMountain(folder, Vector3.new(centerX + 95, GROUND_Y, 0))
	end
end

-- Where a shopkeeper stands. By default they face +Z (the front of the stalls).
local function npcSpot(folder, npc, position, turn)
	local spot = part({ Name = npc .. "Spot", Size = Vector3.new(2, 1, 2), CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, turn or math.pi, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	spot:SetAttribute("Npc", npc)
end

function MapBuilder.Build()
	if Workspace:FindFirstChild("Map") then
		return -- the creator made their own map
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map
	local spots = Instance.new("Folder")
	spots.Name = "DigSpots"
	spots.Parent = map

	local random = Random.new(42)

	-- Ocean
	local terrain = Workspace.Terrain
	terrain:FillBlock(CFrame.new(500, -22, 0), Vector3.new(1700, 8, 700), Enum.Material.Sand)
	terrain:FillBlock(CFrame.new(500, -9, 0), Vector3.new(1700, 18, 700), Enum.Material.Water)
	terrain.WaterColor = Color3.fromRGB(40, 150, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.15

	-- Dig Town (the hub island)
	island(scenery, "Hub", Vector3.new(0, 0, 0), Vector3.new(140, 0, 140), Color3.fromRGB(110, 190, 90))
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "HubSpawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(10, 1, 10)
	spawnLocation.Position = Vector3.new(0, GROUND_Y + 0.5, 30)
	spawnLocation.Material = Enum.Material.Wood
	spawnLocation.Color = Color3.fromRGB(190, 150, 100)
	spawnLocation.Duration = 0
	spawnLocation.Parent = map

	local hubSpawn = part({ Name = "HubTeleport", Size = Vector3.new(4, 1, 4), Position = Vector3.new(0, GROUND_Y + 0.5, 20), Transparency = 1, CanCollide = false, Parent = map })
	hubSpawn:SetAttribute("ZoneSpawn", "hub")

	local sellCounter = stall(scenery, "TradingPost", Vector3.new(-35, GROUND_Y, -25), Color3.fromRGB(200, 60, 80), "TRADING POST")
	sellCounter:SetAttribute("Station", "Sell")
	prompt(sellCounter, "Sell finds", "Trading Post")

	local shovelCounter = stall(scenery, "ShovelShop", Vector3.new(35, GROUND_Y, -25), Color3.fromRGB(230, 150, 40), "SHOVEL SHOP")
	shovelCounter:SetAttribute("Station", "Shovels")
	prompt(shovelCounter, "Browse shovels", "Shovel Shop")

	local charmCounter = stall(scenery, "CharmCart", Vector3.new(-35, GROUND_Y, 8), Color3.fromRGB(90, 180, 90), "CHARM CART")
	charmCounter:SetAttribute("Station", "Charms")
	prompt(charmCounter, "Buy & make charms", "Charm Cart")

	local bountyBoard = board(map, "BountyBoard", CFrame.new(-30, GROUND_Y + 6, 48), Vector3.new(14, 10, 1), "Bounties")
	bountyBoard.Color = Color3.fromRGB(120, 85, 55)
	bountyBoard.Material = Enum.Material.WoodPlanks
	sign(bountyBoard, "GRANDPA GUS'S\nBOUNTIES", Enum.NormalId.Front, Color3.fromRGB(255, 230, 160))
	sign(bountyBoard, "GRANDPA GUS'S\nBOUNTIES", Enum.NormalId.Back, Color3.fromRGB(255, 230, 160))
	prompt(bountyBoard, "Check bounties", "Bounty Board")

	board(map, "GlobalBoard", CFrame.new(0, GROUND_Y + 10, -60), Vector3.new(28, 18, 1), "Leaderboard")
	board(map, "EventBoard", CFrame.new(-55, GROUND_Y + 7, 25) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(20, 12, 1), "EventBoard")

	-- The starter patch: a fenced garden in town with Backyard dig spots, so new players can dig right away
	local patchCenter = Vector3.new(40, 0, 44)
	local corners = {
		Vector3.new(26, GROUND_Y, 31),
		Vector3.new(56, GROUND_Y, 31),
		Vector3.new(56, GROUND_Y, 58),
		Vector3.new(26, GROUND_Y, 58),
	}
	fence(scenery, corners[2], corners[3])
	fence(scenery, corners[3], corners[4])
	fence(scenery, corners[4], corners[1])
	fence(scenery, corners[1], Vector3.new(36, GROUND_Y, 31)) -- a gap in the fence is the way in
	fence(scenery, Vector3.new(46, GROUND_Y, 31), corners[2])
	part({ Name = "PatchSoil", Size = Vector3.new(28, 0.2, 25), Position = patchCenter + Vector3.new(0, GROUND_Y + 0.05, 0.5), Material = Enum.Material.Ground, Color = Color3.fromRGB(130, 100, 65), CanCollide = false, Parent = scenery })
	local patchSign = part({ Name = "PatchSign", Size = Vector3.new(10, 2.4, 0.4), Position = Vector3.new(41, GROUND_Y + 7, 30.5), Color = Color3.fromRGB(60, 40, 30), CanCollide = false, Parent = scenery })
	for _, x in ipairs({ 36, 46 }) do
		part({ Name = "SignPole", Size = Vector3.new(0.4, 7, 0.4), Position = Vector3.new(x, GROUND_Y + 3.5, 30.5), Color = Color3.fromRGB(100, 70, 45), Parent = scenery })
	end
	sign(patchSign, "STARTER PATCH", Enum.NormalId.Front, Color3.fromRGB(255, 230, 160))
	sign(patchSign, "STARTER PATCH", Enum.NormalId.Back, Color3.fromRGB(255, 230, 160))
	local patchTarget = part({ Name = "PatchTarget", Size = Vector3.new(4, 1, 4), Position = patchCenter + Vector3.new(0, GROUND_Y + 0.5, 0), Transparency = 1, CanCollide = false, CanQuery = false, Parent = map })
	patchTarget:SetAttribute("GuideTarget", "DigPatch")
	local placed = {}
	for _, at in ipairs({ Vector3.new(32, 0, 38), Vector3.new(44, 0, 37), Vector3.new(51, 0, 45), Vector3.new(38, 0, 51), Vector3.new(30, 0, 50), Vector3.new(48, 0, 53) }) do
		table.insert(placed, at)
		digSpot(spots, at, Zones.Default, random)
	end

	lighthouse(scenery, Vector3.new(-62, GROUND_Y, -62))

	-- The open square between the shops and the starter patch, where Treasure Rushes pop up
	local rushSite = part({ Name = "RushSite", Size = Vector3.new(4, 1, 4), Position = Vector3.new(20, GROUND_Y, 8), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = map })
	rushSite:SetAttribute("RushSite", true)

	npcSpot(scenery, "Ruby", Vector3.new(-35, GROUND_Y, -27.6))
	npcSpot(scenery, "Digby", Vector3.new(35, GROUND_Y, -27.6))
	npcSpot(scenery, "Clover", Vector3.new(-35, GROUND_Y, 5.4))
	npcSpot(scenery, "Gus", Vector3.new(-20, GROUND_Y, 46), math.rad(-50))

	-- Paths, lamps and clutter so the town feels lived in
	for _, path in ipairs({
		{ Vector3.new(0, 0, -15), Vector3.new(8, 0.2, 90) },
		{ Vector3.new(0, 0, -10), Vector3.new(110, 0.2, 8) },
		{ Vector3.new(20, 0, 26), Vector3.new(40, 0.2, 6) },
	}) do
		part({ Name = "Path", Size = path[2], Position = path[1] + Vector3.new(0, GROUND_Y + 0.05, 0), Material = Enum.Material.Pebble, Color = Color3.fromRGB(200, 185, 150), CanCollide = false, Parent = scenery })
	end
	for _, at in ipairs({ Vector3.new(6, 0, 10), Vector3.new(-6, 0, -30), Vector3.new(-20, 0, -14), Vector3.new(20, 0, -14), Vector3.new(50, 0, -5), Vector3.new(-50, 0, -5), Vector3.new(22, 0, 32) }) do
		lamp(scenery, at + Vector3.new(0, GROUND_Y, 0))
	end
	for _, at in ipairs({ Vector3.new(-46, 0, -22), Vector3.new(-44, 0, -18), Vector3.new(46, 0, -18), Vector3.new(-46, 0, 12) }) do
		crate(scenery, at + Vector3.new(0, GROUND_Y, 0), random)
	end
	for _, at in ipairs({ Vector3.new(-25, 0, -22), Vector3.new(26, 0, -14), Vector3.new(-24, 0, 12), Vector3.new(46, 0, -22) }) do
		barrel(scenery, at + Vector3.new(0, GROUND_Y, 0))
	end
	gnome(scenery, Vector3.new(58, GROUND_Y, 34), Color3.fromRGB(210, 50, 50))

	-- VIP lounge (cosmetic perk: a nice private spot by town, no extra dig spots)
	part({ Name = "VipLounge", Size = Vector3.new(30, 1, 44), Position = Vector3.new(-10, GROUND_Y - 0.5, 98), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(200, 160, 60), Parent = scenery })
	for _, x in ipairs({ -20, 0 }) do
		part({ Name = "VipBench", Size = Vector3.new(8, 1, 2.5), Position = Vector3.new(x, GROUND_Y + 1, 108), Material = Enum.Material.Wood, Color = Color3.fromRGB(120, 80, 45), Parent = scenery })
	end
	part({ Name = "VipFountain", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 8, 8), CFrame = CFrame.new(-10, GROUND_Y + 1, 96) * CFrame.Angles(0, 0, math.rad(90)), Material = Enum.Material.Marble, Color = Color3.fromRGB(240, 235, 220), Parent = scenery })
	lamp(scenery, Vector3.new(2, GROUND_Y, 112))
	lamp(scenery, Vector3.new(-22, GROUND_Y, 112))
	local vipDoor = part({ Name = "VipDoor", Size = Vector3.new(32, 12, 1), Position = Vector3.new(-10, GROUND_Y + 6, 77), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Transparency = 0.5, Parent = map })
	vipDoor:SetAttribute("VipDoor", true)
	sign(vipDoor, "VIP LOUNGE", Enum.NormalId.Front, Color3.fromRGB(255, 240, 180))
	sign(vipDoor, "VIP LOUNGE", Enum.NormalId.Back, Color3.fromRGB(255, 240, 180))
	for _, x in ipairs({ -25.5, 5.5 }) do
		part({ Name = "VipWall", Size = Vector3.new(1, 12, 42), Position = Vector3.new(x, GROUND_Y + 6, 98.5), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Transparency = 0.7, Parent = map })
	end

	for _ = 1, 14 do
		local x = random:NextNumber(-64, 64)
		local z = random:NextNumber(-64, 64)
		local clear = math.abs(z) > 8 and math.abs(x) > 12 and not (x < -45 and z < -45) and not (x > 20 and z > 24)
		if (math.abs(x) > 52 or math.abs(z) > 52) and clear then
			tree(scenery, Vector3.new(x, GROUND_Y, z), Color3.fromRGB(60, 160, 60), random)
		end
	end

	-- One island per zone, in a row going east
	local looks = {
		backyard = { ground = Color3.fromRGB(120, 190, 90), material = Enum.Material.Grass, leaves = Color3.fromRGB(70, 170, 60), rock = Color3.fromRGB(140, 140, 140), trees = 6 },
		desert = { ground = Color3.fromRGB(235, 200, 130), material = Enum.Material.Sand, leaves = Color3.fromRGB(120, 170, 70), rock = Color3.fromRGB(200, 140, 90), trees = 2 },
		caves = { ground = Color3.fromRGB(90, 80, 110), material = Enum.Material.Slate, leaves = Color3.fromRGB(170, 120, 255), rock = Color3.fromRGB(150, 110, 220), trees = 0 },
		ruins = { ground = Color3.fromRGB(120, 150, 130), material = Enum.Material.Cobblestone, leaves = Color3.fromRGB(60, 130, 90), rock = Color3.fromRGB(170, 170, 150), trees = 3 },
		volcano = { ground = Color3.fromRGB(60, 50, 50), material = Enum.Material.Basalt, leaves = Color3.fromRGB(255, 120, 40), rock = Color3.fromRGB(40, 35, 35), trees = 0 },
	}
	local previousEdge = 78
	for index, zone in ipairs(Zones.List) do
		local centerX = 230 * index
		local look = looks[zone.id] or looks.backyard
		island(scenery, zone.name, Vector3.new(centerX, 0, 0), Vector3.new(90, 0, 90), look.ground, look.material)

		local zonePlaced = {}
		scatterSpots(spots, Vector3.new(centerX, 0, 0), Vector3.new(38, 0, 38), 12, zone.id, random, zonePlaced)

		for _ = 1, look.trees do
			local x = centerX + random:NextNumber(-38, 38)
			local z = random:NextNumber(-38, 38)
			local clear = math.abs(z) > 12
			for _, at in ipairs(zonePlaced) do
				if (Vector3.new(x, 0, z) - at).Magnitude < 7 then
					clear = false
				end
			end
			if clear then
				tree(scenery, Vector3.new(x, GROUND_Y, z), look.leaves, random)
				table.insert(zonePlaced, Vector3.new(x, 0, z))
			end
		end
		for _ = 1, 5 do
			local at = Vector3.new(centerX + random:NextNumber(-42, 42), GROUND_Y, random:NextNumber(-42, 42))
			local clear = math.abs(at.Z) > 10
			for _, spot in ipairs(zonePlaced) do
				if (Vector3.new(at.X, 0, at.Z) - spot).Magnitude < 8 then
					clear = false
				end
			end
			if clear then
				rock(scenery, at, look.rock, random)
				table.insert(zonePlaced, Vector3.new(at.X, 0, at.Z))
			end
		end
		decorateZone(scenery, zone.id, centerX, zonePlaced, random)

		local zoneSign = part({ Name = "ZoneSign", Size = Vector3.new(24, 6, 1), Position = Vector3.new(centerX, GROUND_Y + 14, -40), Color = Color3.fromRGB(30, 40, 60), Parent = scenery })
		sign(zoneSign, zone.name, Enum.NormalId.Front, zone.color)
		sign(zoneSign, zone.name, Enum.NormalId.Back, zone.color)

		-- Bridge from the previous island
		local islandEdge = centerX - 53
		local bridgeLength = islandEdge - previousEdge
		part({
			Name = "Bridge",
			Size = Vector3.new(bridgeLength, 1, 10),
			Position = Vector3.new(previousEdge + bridgeLength / 2, GROUND_Y - 0.5, 0),
			Material = Enum.Material.WoodPlanks,
			Color = Color3.fromRGB(150, 110, 70),
			Parent = scenery,
		})
		previousEdge = centerX + 53

		if zone.price > 0 then
			local gate = part({
				Name = zone.name .. "Gate",
				Size = Vector3.new(2, 14, 12),
				Position = Vector3.new(islandEdge - bridgeLength + 6, GROUND_Y + 7, 0),
				Color = zone.color,
				Material = Enum.Material.ForceField,
				Parent = map,
			})
			gate:SetAttribute("ZoneGate", zone.id)
			local text = string.format("%s\nLevel %d\n%s coins", zone.name, zone.level, Format.Number(zone.price))
			sign(gate, text, Enum.NormalId.Left)
			sign(gate, text, Enum.NormalId.Right)
			prompt(gate, "Unlock", zone.name, 14)
		end

		local zoneSpawn = part({ Name = zone.name .. "Spawn", Size = Vector3.new(4, 1, 4), Position = Vector3.new(centerX, GROUND_Y + 0.5, 0), Transparency = 1, CanCollide = false, Parent = map })
		zoneSpawn:SetAttribute("ZoneSpawn", zone.id)
	end

	map.Parent = Workspace
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">NpcService</string><ProtectedString name="Source"><![CDATA[-- Shopkeepers and Grandpa Gus. They stand on parts with an "Npc" attribute
-- (MapBuilder places them at each stall) and face the way that part faces.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local NpcService = {}

local SKIN = Color3.fromRGB(234, 184, 146)

local LOOKS = {
	Gus = { name = "Grandpa Gus", role = "Bounties", shirt = Color3.fromRGB(150, 110, 60), pants = Color3.fromRGB(80, 70, 50), hat = Color3.fromRGB(200, 170, 110), beard = true },
	Ruby = { name = "Ruby", role = "Trading Post", shirt = Color3.fromRGB(200, 50, 70), pants = Color3.fromRGB(50, 50, 70), hat = Color3.fromRGB(240, 200, 60) },
	Clover = { name = "Clover", role = "Charm Cart", shirt = Color3.fromRGB(90, 170, 80), pants = Color3.fromRGB(70, 60, 50), hat = Color3.fromRGB(60, 120, 50) },
	Digby = { name = "Digby", role = "Shovel Shop", shirt = Color3.fromRGB(220, 140, 40), pants = Color3.fromRGB(60, 60, 60), hat = Color3.fromRGB(250, 210, 40) },
}

local function accessory(model, head, name, size, offset, color, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.CanCollide = false
	p.Massless = true
	p.Shape = shape or Enum.PartType.Block
	p.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
end

local function makeNpc(spot)
	local look = LOOKS[spot:GetAttribute("Npc")]
	if not look then
		return
	end
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = SKIN
	description.LeftArmColor = SKIN
	description.RightArmColor = SKIN
	description.TorsoColor = look.shirt
	description.LeftLegColor = look.pants
	description.RightLegColor = look.pants

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[NpcService] Couldn't create " .. look.name .. ": " .. tostring(model))
		return
	end
	model.Name = look.name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = look.name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local root = model:FindFirstChild("HumanoidRootPart")
	root.Anchored = true

	local height = humanoid.HipHeight + root.Size.Y / 2
	model:PivotTo(CFrame.new(spot.Position + Vector3.new(0, spot.Size.Y / 2 + height, 0)) * spot.CFrame.Rotation)

	local head = model:FindFirstChild("Head")
	if head then
		local brim = CFrame.new(0, head.Size.Y / 2 + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90))
		accessory(model, head, "HatBrim", Vector3.new(0.15, 2, 2), brim, look.hat, Enum.PartType.Cylinder)
		accessory(model, head, "HatTop", Vector3.new(1.1, 0.5, 1.1), CFrame.new(0, head.Size.Y / 2 + 0.35, 0), look.hat)
		if look.beard then
			accessory(model, head, "Beard", Vector3.new(0.9, 0.5, 0.3), CFrame.new(0, -head.Size.Y / 2 + 0.05, -head.Size.Z / 2), Color3.fromRGB(235, 235, 235))
		end

		local tag = Instance.new("BillboardGui")
		tag.Size = UDim2.fromOffset(200, 50)
		tag.StudsOffset = Vector3.new(0, 2.8, 0)
		tag.MaxDistance = 80
		local name = Instance.new("TextLabel")
		name.Size = UDim2.fromScale(1, 0.6)
		name.BackgroundTransparency = 1
		name.Text = look.name
		name.TextScaled = true
		name.Font = Enum.Font.FredokaOne
		name.TextColor3 = Color3.new(1, 1, 1)
		name.TextStrokeTransparency = 0.3
		name.Parent = tag
		local role = name:Clone()
		role.Position = UDim2.fromScale(0, 0.6)
		role.Size = UDim2.fromScale(1, 0.4)
		role.Text = look.role
		role.TextColor3 = Color3.fromRGB(255, 220, 120)
		role.Parent = tag
		tag.Parent = head
	end

	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
	model:SetAttribute("NpcId", spot:GetAttribute("Npc"))
	model.Parent = Workspace
end

function NpcService.Start()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Npc") then
			task.spawn(makeNpc, item)
		end
	end
end

return NpcService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">RushService</string><ProtectedString name="Source"><![CDATA[-- Treasure Rush: every 15 minutes a big glowing dig site pops up in Dig Town.
-- Everyone digs it with the normal dig minigame, and every good dig fills the
-- site a bit. When it is full, every helper gets a guaranteed Rare or better
-- find from the best zone they have unlocked (Epic or better when 3 or more
-- players helped). Nobody shares a find, so helping never costs anything.
--
-- Players' screens follow the rush through attributes on ReplicatedStorage:
--   RushActive (bool), RushProgress, RushTarget, RushHelpers, RushEndsAt (server time)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Finds = require(Shared.Finds)
local Events = require(Shared.Events)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local RushService = {}

local DEFAULT_SITE = Vector3.new(20, 3, 8) -- used when the map has no RushSite part
local GOLD = Color3.fromRGB(255, 200, 60)

local rush = nil -- the rush going on right now, if any
local giveLoot = nil -- function(player, minRarityOrder), set in Start

local function notifyAll(text, kind)
	for _, player in ipairs(Players:GetPlayers()) do
		Remotes.Notify:FireClient(player, text, kind)
	end
end

local function sitePosition()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("RushSite") then
			return item.Position
		end
	end
	return DEFAULT_SITE
end

local function publish()
	ReplicatedStorage:SetAttribute("RushActive", rush ~= nil)
	ReplicatedStorage:SetAttribute("RushProgress", rush and rush.progress or 0)
	ReplicatedStorage:SetAttribute("RushTarget", rush and rush.target or 0)
	ReplicatedStorage:SetAttribute("RushHelpers", rush and rush.helperCount or 0)
	ReplicatedStorage:SetAttribute("RushEndsAt", rush and rush.endsAt or 0)
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- A mound of dirt with a half-buried chest, a beam of light and a sign that
-- shows how much is dug
local function buildSite(at)
	local model = Instance.new("Model")
	model.Name = "TreasureRush"

	local mound = part({
		Name = "RushMound",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 12, 12),
		CFrame = CFrame.new(at.X, at.Y + 0.2, at.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Ground,
		Color = Color3.fromRGB(120, 85, 50),
		CanCollide = false,
		Parent = model,
	})
	-- The mound is the dig spot: DigService and the players' screens look for this
	mound:SetAttribute("DigSpot", "rush")
	mound:SetAttribute("TreasureRush", true)

	local chest = part({ Name = "Chest", Size = Vector3.new(5, 2.6, 3.4), CFrame = CFrame.new(at.X, at.Y + 1.1, at.Z) * CFrame.Angles(math.rad(-12), math.rad(20), 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(130, 80, 40), Parent = model })
	part({ Name = "ChestLid", Size = Vector3.new(5.1, 0.9, 3.5), CFrame = chest.CFrame * CFrame.new(0, 1.7, 0), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(150, 95, 50), Parent = model })
	for _, x in ipairs({ -1.8, 1.8 }) do
		part({ Name = "ChestBand", Size = Vector3.new(0.4, 3.6, 3.6), CFrame = chest.CFrame * CFrame.new(x, 0.45, 0), Material = Enum.Material.Metal, Color = GOLD, CanCollide = false, Parent = model })
	end

	local beam = part({
		Name = "RushBeam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(120, 3, 3),
		CFrame = CFrame.new(at.X, at.Y + 60, at.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = GOLD,
		Transparency = 0.55,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Parent = model,
	})

	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 22
	light.Brightness = 2
	light.Parent = chest

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkle"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(GOLD)
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(1, 1.8)
	sparkles.Speed = NumberRange.new(3, 7)
	sparkles.SpreadAngle = Vector2.new(70, 70)
	sparkles.EmissionDirection = Enum.NormalId.Right -- the mound lies on its side, so +X points up
	sparkles.Rate = 25
	sparkles.Parent = mound

	local dirt = Instance.new("ParticleEmitter")
	dirt.Name = "Dirt"
	dirt.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dirt.Color = ColorSequence.new(Color3.fromRGB(120, 85, 55))
	dirt.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2) })
	dirt.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	dirt.Lifetime = NumberRange.new(0.5, 0.9)
	dirt.Speed = NumberRange.new(8, 14)
	dirt.SpreadAngle = Vector2.new(40, 40)
	dirt.Acceleration = Vector3.new(0, -35, 0)
	dirt.EmissionDirection = Enum.NormalId.Right
	dirt.Rate = 0
	dirt.Parent = mound

	-- The sign floats over the chest and can be seen from across town
	local signHolder = part({ Name = "RushSign", Size = Vector3.new(1, 1, 1), Position = at + Vector3.new(0, 9, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = model })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 92)
	gui.LightInfluence = 0
	gui.MaxDistance = 400
	gui.Parent = signHolder
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 34)
	title.BackgroundTransparency = 1
	title.Text = "TREASURE RUSH!"
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = GOLD
	title.TextStrokeTransparency = 0.2
	title.Parent = gui
	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.fromOffset(10, 40)
	barBack.Size = UDim2.new(1, -20, 0, 20)
	barBack.BackgroundColor3 = Color3.fromRGB(40, 30, 20)
	barBack.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = barBack
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = GOLD
	fill.Parent = barBack
	corner:Clone().Parent = fill
	local info = Instance.new("TextLabel")
	info.Position = UDim2.fromOffset(0, 64)
	info.Size = UDim2.new(1, 0, 0, 26)
	info.BackgroundTransparency = 1
	info.TextScaled = true
	info.Font = Enum.Font.GothamBold
	info.TextColor3 = Color3.new(1, 1, 1)
	info.TextStrokeTransparency = 0.2
	info.Parent = gui

	model.PrimaryPart = mound
	model.Parent = Workspace
	return {
		model = model,
		mound = mound,
		chest = chest,
		beam = beam,
		fill = fill,
		info = info,
		title = title,
	}
end

local function refreshSign()
	if not rush then
		return
	end
	local site = rush.site
	site.fill.Size = UDim2.fromScale(math.clamp(rush.progress / rush.target, 0, 1), 1)
	local left = math.max(0, rush.endsAt - Events.Now())
	site.info.Text = string.format("%d/%d dug  -  %s left", rush.progress, rush.target, Format.Duration(left))
end

-- Ends the rush: loot for every helper if it was dug out, otherwise it sinks
local function finish(succeeded)
	local current = rush
	if not current then
		return
	end
	rush = nil
	publish()

	-- Nobody can start a new dig here while the site goes away
	local site = current.site
	site.mound:SetAttribute("DigSpot", nil)
	site.mound:SetAttribute("TreasureRush", nil)
	if succeeded then
		local helpers = {}
		for player in pairs(current.helpers) do
			if player.Parent then
				table.insert(helpers, player)
			end
		end
		local team = #helpers >= Config.RushTeamSize
		local minOrder = team and Finds.RarityById.Epic.order or Finds.RarityById.Rare.order
		notifyAll(string.format("The Treasure Rush is dug out! %d digger%s got %s finds.", #helpers, #helpers == 1 and "" or "s", team and "Epic or better" or "Rare or better"), "rare")
		for _, player in ipairs(helpers) do
			task.spawn(giveLoot, player, minOrder)
		end
		-- The lid flies open and the chest bursts with sparkles
		site.title.Text = "DUG OUT!"
		site.info.Text = string.format("%d digger%s shared the loot", #helpers, #helpers == 1 and "" or "s")
		site.fill.Size = UDim2.fromScale(1, 1)
		local lid = site.model:FindFirstChild("ChestLid")
		if lid then
			lid.CFrame = lid.CFrame * CFrame.new(0, 1, -1.6) * CFrame.Angles(math.rad(-70), 0, 0)
		end
		local burst = site.mound:FindFirstChild("Sparkle")
		if burst then
			burst.Rate = 0
			burst:Emit(120)
		end
		task.delay(6, function()
			site.model:Destroy()
		end)
	else
		notifyAll("The Treasure Rush sank back into the ground. Next time!", "info")
		site.title.Text = "IT SANK..."
		site.beam.Transparency = 0.9
		task.delay(3, function()
			site.model:Destroy()
		end)
	end
end

function RushService.Begin()
	if rush then
		return
	end
	local players = #Players:GetPlayers()
	if players == 0 then
		return
	end
	local at = sitePosition()
	rush = {
		site = buildSite(at),
		progress = 0,
		target = math.min(Config.RushDigsMax, Config.RushDigs + Config.RushDigsPerPlayer * (players - 1)),
		helpers = {}, -- [player] = good digs
		helperCount = 0,
		endsAt = Events.Now() + Config.RushSeconds,
	}
	publish()
	refreshSign()
	notifyAll("TREASURE RUSH in Dig Town! Dig it out together for a guaranteed great find.", "rare")

	local mine = rush
	task.spawn(function()
		while rush == mine do
			if Events.Now() >= mine.endsAt then
				finish(false)
				break
			end
			refreshSign()
			task.wait(1)
		end
	end)
end

function RushService.IsSite(spot)
	return rush ~= nil and spot == rush.site.mound
end

-- A player finished a good dig at the site. Returns the progress and target,
-- or nil if the rush is already over.
function RushService.AddDig(player)
	if not rush then
		return nil
	end
	if not rush.helpers[player] then
		rush.helpers[player] = 0
		rush.helperCount += 1
	end
	rush.helpers[player] += 1
	rush.progress += 1
	local progress, target = rush.progress, rush.target
	local dirt = rush.site.mound:FindFirstChild("Dirt")
	if dirt then
		dirt:Emit(16)
	end
	publish()
	refreshSign()
	if progress >= target then
		finish(true)
	end
	return progress, target
end

-- loot(player, minRarityOrder) gives one helper their find
function RushService.Start(loot)
	giveLoot = loot
	publish()
	task.spawn(function()
		task.wait(Config.RushFirstSeconds)
		while true do
			RushService.Begin()
			task.wait(Config.RushEverySeconds)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		if rush and rush.helpers[player] then
			rush.helpers[player] = nil
			rush.helperCount -= 1
			publish()
		end
	end)
end

return RushService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: game passes (VIP, Auto Sell, Big Backpack, Teleporter) and
-- cosmetic developer products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

local function applyPassEffects(runtime)
	runtime.bagSize = runtime.passes.BigBag and Config.BigBagSize or Config.BagSize
end

function ShopService.HasPass(player, passId)
	local runtime = DataService.GetRuntime(player)
	return runtime ~= nil and runtime.passes ~= nil and runtime.passes[passId] == true
end

local function checkPasses(player, runtime)
	runtime.passes = {}
	local testing = RunService:IsStudio() and Config.TestPassesInStudio
	for _, pass in ipairs(Shop.Passes) do
		if testing then
			runtime.passes[pass.id] = true
		elseif pass.gamePassId ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.gamePassId)
			end)
			runtime.passes[pass.id] = ok and owns or false
		end
	end
	applyPassEffects(runtime)
end

local function onPassPurchased(player, gamePassId, purchased)
	if not purchased then
		return
	end
	for _, pass in ipairs(Shop.Passes) do
		if pass.gamePassId == gamePassId and pass.gamePassId ~= 0 then
			DataService.Update(player, function(_, runtime)
				runtime.passes[pass.id] = true
				applyPassEffects(runtime)
			end)
			Remotes.Notify:FireClient(player, "Thanks for buying " .. pass.name .. "!", "success")
		end
	end
end

-- Roblox calls this for every developer product purchase. It must only return
-- PurchaseGranted once the item is given AND saved, otherwise Roblox retries later.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local item = Shop.CosmeticByProductId[receipt.ProductId]
	if not item then
		warn("[ShopService] Unknown product id " .. tostring(receipt.ProductId) .. " - add it to Shop.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.Get(player)
	if data.purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	DataService.Update(player, function(saved)
		saved.purchases[receipt.PurchaseId] = true
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)

	if not DataService.SaveNow(player) then
		-- Keep the item, Roblox will call again and the purchase id stops a double grant
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "You got " .. item.name .. "! It's equipped.", "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	DataService.OnLoaded(function(player, _, runtime)
		checkPasses(player, runtime)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[-- Moves players through Grandpa Gus's first-day guide (see Shared/Tutorial).
-- Other services call TutorialService.Event(player, "Dig") etc.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)
local Charms = require(Shared.Charms)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local TutorialService = {}

function TutorialService.Event(player, event)
	local data = DataService.Get(player)
	if not data or data.tutorial >= Tutorial.Done then
		return
	end
	local step = Tutorial.Steps[data.tutorial]
	if not step or step.event ~= event then
		return
	end
	local finished = data.tutorial + 1 >= Tutorial.Done
	DataService.Update(player, function(saved)
		saved.tutorial += 1
		if finished then
			saved.coins += Tutorial.RewardCoins
			local reward = Tutorial.RewardCharm
			saved.charms.owned[reward.id] = (saved.charms.owned[reward.id] or 0) + reward.amount
		end
	end)
	if finished then
		Remotes.Notify:FireClient(player, string.format("Grandpa Gus: You're a natural! Here's %s coins and %d %s charms. Happy digging!", Format.Number(Tutorial.RewardCoins), Tutorial.RewardCharm.amount, Charms.ById[Tutorial.RewardCharm.id].name), "success")
	end
end

function TutorialService.Start()
	-- The "take out your shovel" step: watch for the shovel appearing in the character
	DataService.OnLoaded(function(player)
		local function watch(character)
			character.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					TutorialService.Event(player, "EquipShovel")
				end
			end)
		end
		if player.Character then
			watch(player.Character)
		end
		player.CharacterAdded:Connect(watch)
	end)
end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- Connects the world to the game: shop and Trading Post prompts, zone gates,
-- the global leaderboard board and the weekly event board.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local EconomyService = require(script.Parent.EconomyService)
local TutorialService = require(script.Parent.TutorialService)

local WorldService = {}

local LEADERBOARD_REFRESH = 120

local function hookPrompt(prompt)
	local holder = prompt.Parent
	if not holder then
		return
	end
	local station = holder:GetAttribute("Station")
	local gateZone = holder:GetAttribute("ZoneGate")
	local panels = { Sell = "Market", Shovels = "Shovels", Charms = "Charms", Bounties = "Bounties" }
	if station and panels[station] then
		prompt.Triggered:Connect(function(player)
			Remotes.OpenPanel:FireClient(player, panels[station])
			if station == "Bounties" then
				TutorialService.Event(player, "Bounties")
			end
		end)
	elseif gateZone then
		prompt.Triggered:Connect(function(player)
			local ok, message = EconomyService.UnlockZone(player, gateZone)
			if not ok and message then
				Remotes.Notify:FireClient(player, message, "warning")
			end
		end)
	end
end

local function makeBoardFace(boardPart, titleText, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = gui
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.Text = titleText
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = Color3.fromRGB(255, 220, 120)
	title.Parent = gui
	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.Position = UDim2.new(0, 0, 0.18, 0)
	body.Size = UDim2.new(1, 0, 0.8, 0)
	body.BackgroundTransparency = 1
	body.Text = "Loading..."
	body.TextScaled = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Font = Enum.Font.GothamMedium
	body.TextColor3 = Color3.new(1, 1, 1)
	body.Parent = gui
	gui.Parent = boardPart
	return body
end

-- Boards show the same text on both sides. Returns a function that sets the text.
local function makeBoardGui(boardPart, titleText)
	local front = makeBoardFace(boardPart, titleText, Enum.NormalId.Front)
	local back = makeBoardFace(boardPart, titleText, Enum.NormalId.Back)
	return function(text)
		front.Text = text
		back.Text = text
	end
end

local function findStation(name)
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == name then
			return item
		end
	end
	return nil
end

local nameCache = {}
local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function runLeaderboard(boardPart)
	local setText = makeBoardGui(boardPart, "Most Finds Dug Up")
	local store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	while true do
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok then
			local lines = {}
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				table.insert(lines, string.format("%d. %s  -  %s", rank, nameFor(tonumber(entry.key)), Format.Number(entry.value)))
			end
			setText(#lines > 0 and table.concat(lines, "\n") or "No finds yet. Be the first!")
		else
			setText("Leaderboard unavailable right now.")
		end
		task.wait(LEADERBOARD_REFRESH)
	end
end

local function runEventBoard(boardPart)
	local setText = makeBoardGui(boardPart, "This Week's Legend")
	while true do
		local find, weekLeft = Events.GetEventFind()
		local weather, weatherLeft = Events.GetWeather()
		local zone = Zones.ById[find.zone]
		setText(string.format(
			"%s\nonly in %s\nends in %s\n\nWeather: %s\n%s\n(changes in %s)",
			find.name,
			zone and zone.name or find.zone,
			Format.Duration(weekLeft),
			weather.name,
			weather.description,
			Format.Duration(weatherLeft)
		))
		task.wait(1)
	end
end

function WorldService.Start()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("ProximityPrompt") then
			hookPrompt(item)
		end
	end
	Workspace.DescendantAdded:Connect(function(item)
		if item:IsA("ProximityPrompt") then
			task.defer(hookPrompt, item)
		end
	end)

	local leaderboard = findStation("Leaderboard")
	if leaderboard then
		task.spawn(runLeaderboard, leaderboard)
	end
	local eventBoard = findStation("EventBoard")
	if eventBoard then
		task.spawn(runEventBoard, eventBoard)
	end
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000002D"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000002C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000002B"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Dig Up a Legendary! player script. Builds the screen and starts digging controls.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = require(script.UI)
local Notifications = require(script.Notifications)
local CameraController = require(script.CameraController)
local Panels = require(script.Panels)
local Hud = require(script.Hud)
local Digging = require(script.Digging)
local World = require(script.World)
local Guide = require(script.Guide)
local MenuLock = require(script.MenuLock)

local player = Players.LocalPlayer

local screenGui = UI.new("ScreenGui", {
	Name = "DigLegendsUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Shrink the whole UI on small screens (phones)
local scale = UI.new("UIScale", { Parent = screenGui })
local function rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 700), 0.55, 1.2)
	end
end
while not Workspace.CurrentCamera do
	task.wait()
end
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

-- The dig minigame gets its own unscaled screen so its tap area covers everything
local diggingGui = UI.new("ScreenGui", {
	Name = "DigMinigameUI",
	ResetOnSpawn = false,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player.PlayerGui,
})

Notifications.Init(screenGui)
CameraController.Init(diggingGui)
Panels.Init(screenGui)
Hud.Init(screenGui)
Digging.Init(diggingGui)
World.Init()
Guide.Init(screenGui)
MenuLock.Init()

]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[-- Over-the-shoulder camera for mouse players: moving the mouse turns the camera
-- and your character, like most action games. The mouse is free again whenever
-- a menu is open, or when you press Alt (press again to lock it).
-- Phones and tablets keep Roblox's normal touch camera.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.UI)

local CameraController = {}

local SENSITIVITY = 0.0035 -- radians per pixel of mouse movement
local GAMEPAD_SPEED = 3 -- radians per second at full stick
local SHOULDER = Vector3.new(1.6, 0.9, 0) -- camera sits over the right shoulder
local MIN_PITCH, MAX_PITCH = math.rad(-75), math.rad(60)
local MIN_ZOOM, MAX_ZOOM = 5, 28

local player = Players.LocalPlayer
local enabled = false
local cursorFree = false
local yaw, pitch, zoom = 0, math.rad(-15), 12
local stick = Vector2.zero
local shakeUntil, shakeAmount = 0, 0
local crosshair

function CameraController.IsActive()
	return enabled
end

function CameraController.IsLocked()
	return enabled and not cursorFree and not UI.IsWindowOpen()
end

-- Shake the camera (used when digging hits something)
function CameraController.Shake(amount, seconds)
	shakeAmount = math.max(shakeAmount, amount)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

-- Colors the aiming dot (nil = plain white)
function CameraController.SetCrosshairColor(color)
	if crosshair then
		crosshair.BackgroundColor3 = color or Color3.new(1, 1, 1)
	end
end

-- The ray the player is aiming along: screen center when locked, else the mouse
function CameraController.AimRay()
	local camera = Workspace.CurrentCamera
	if CameraController.IsLocked() then
		local size = camera.ViewportSize
		return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
	end
	local mouse = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function update(dt)
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or not root or not humanoid then
		return
	end

	local locked = CameraController.IsLocked()
	UserInputService.MouseBehavior = locked and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = not locked
	crosshair.Visible = locked

	if stick.Magnitude > 0.15 then
		yaw -= stick.X * GAMEPAD_SPEED * dt
		pitch = math.clamp(pitch + stick.Y * GAMEPAD_SPEED * dt, MIN_PITCH, MAX_PITCH)
	end

	-- Character faces where the camera looks
	if humanoid.Health > 0 and not humanoid.Sit then
		humanoid.AutoRotate = false
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end

	camera.CameraType = Enum.CameraType.Scriptable
	local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local focus = root.Position + Vector3.new(0, 1.5, 0)
	local offset = rotation:VectorToWorldSpace(SHOULDER + Vector3.new(0, 0, zoom))

	-- Don't let the camera go through walls
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local position = focus + offset
	local hit = Workspace:Raycast(focus, offset, params)
	if hit then
		position = hit.Position - offset.Unit * 0.5
	end

	local shake = CFrame.new()
	if os.clock() < shakeUntil then
		local s = shakeAmount
		shake = CFrame.Angles(math.rad((math.random() - 0.5) * s), math.rad((math.random() - 0.5) * s), 0)
	else
		shakeAmount = 0
	end
	camera.CFrame = CFrame.new(position) * rotation * shake
	camera.Focus = CFrame.new(focus)
end

function CameraController.Init(screenGui)
	-- Touch-only devices keep the normal camera
	if not UserInputService.MouseEnabled then
		return
	end
	enabled = true

	crosshair = UI.new("Frame", {
		Name = "Crosshair",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(4), UI.stroke(Color3.new(0, 0, 0), 1) })

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement and CameraController.IsLocked() then
			yaw -= input.Delta.X * SENSITIVITY
			pitch = math.clamp(pitch - input.Delta.Y * SENSITIVITY, MIN_PITCH, MAX_PITCH)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not UI.IsWindowOpen() then
			zoom = math.clamp(zoom - input.Position.Z * 2, MIN_ZOOM, MAX_ZOOM)
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
			cursorFree = not cursorFree
		end
	end)

	local function onCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then
			local look = root.CFrame.LookVector
			yaw = math.atan2(-look.X, -look.Z)
		end
	end
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	player.CharacterAdded:Connect(onCharacter)

	RunService:BindToRenderStep("ShoulderCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Digging</string><ProtectedString name="Source"><![CDATA[-- Digging on the player's screen.
--   1. Take out the shovel and stand next to a sparkling dig spot. The text
--      under the middle of the screen tells you if you can dig there.
--   2. Click to dig down. Walking away stops digging.
--   3. The dig minigame: a marker slides along a bar. Tap while it is in the
--      green to dig deeper; the gold middle is a perfect hit and makes the find
--      worth more. Tapping outside the green cracks the find.
--   A Treasure Rush site is dug the same way, but each good dig fills the
--   site instead of finding something; the loot comes when it is dug out.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Finds = require(Shared.Finds)
local Dig = require(Shared.Dig)
local Format = require(Shared.Format)
local Config = require(Shared.Config)
local Zones = require(Shared.Zones)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local Notifications = require(script.Parent.Notifications)
local State = require(script.Parent.State)
local CameraController = require(script.Parent.CameraController)
local T = UI.Theme

local Digging = {}

local SHOVEL_NAME = "Shovel"
local WAIT_TIMEOUT = 30 -- give up if the server never answers

local MESSAGES = {
	cracked = "CRACK! Your find broke. Tap while the marker is in the green.",
	walked = "You walked away, so you stopped digging.",
	timeout = "You took too long and the find sank too deep.",
}

local player = Players.LocalPlayer
local screenGui
local statusLabel
local aimLabel
local highlight

local phase = "idle" -- idle, starting, digging, minigame, done
local findCardUntil = 0 -- no new dig until the "Found!" card is gone (os.clock time)
local digId = nil
local digSpot = nil
local token = 0

local spots = {} -- [spot] = true for every dig spot this player's game has loaded
local hiddenUntil = {} -- [spot] = os.clock() when this player can dig it again

local sounds = {}
local function sound(name, id, volume)
	local s = Instance.new("Sound")
	s.Name = "Dig" .. name
	s.SoundId = id
	s.Volume = volume or 0.6
	s.Parent = SoundService
	sounds[name] = s
end
local function play(name, pitch)
	local s = sounds[name]
	if s then
		s.PlaybackSpeed = pitch or 1
		SoundService:PlayLocalSound(s)
	end
end

local function setStatus(text)
	statusLabel.Text = text or ""
	statusLabel.Visible = text ~= nil
end

-- While digging the player stands still. Trying to walk stops digging.
local rooted = nil
local function setRooted(on)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if on and humanoid and not rooted then
		rooted = { humanoid = humanoid, speed = humanoid.WalkSpeed }
		humanoid.WalkSpeed = 0
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	elseif not on and rooted then
		if rooted.humanoid.Parent then
			rooted.humanoid.WalkSpeed = rooted.speed > 0 and rooted.speed or 16
			rooted.humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
		rooted = nil
	end
end

-- Closes the dig minigame if one is on screen (set while it runs)
local closeMinigame = nil

local function reset()
	if closeMinigame then
		closeMinigame()
	end
	setRooted(false)
	phase = "idle"
	digId = nil
	digSpot = nil
	token += 1
	setStatus(nil)
end

------------------------------------------------------------------ Dig spots

-- A spot you just dug looks empty (for you only) until you can dig it again
local function hideSpot(spot)
	local untilTime = os.clock() + Config.SpotCooldown
	hiddenUntil[spot] = untilTime
	spot.Transparency = 0.75
	local sparkle = spot:FindFirstChild("Sparkle")
	if sparkle then
		sparkle.Enabled = false
	end
	task.delay(Config.SpotCooldown, function()
		if hiddenUntil[spot] == untilTime and spot.Parent then
			hiddenUntil[spot] = nil
			spot.Transparency = 0
			if sparkle then
				sparkle.Enabled = true
			end
		end
	end)
end

local function isRush(spot)
	return spot ~= nil and spot:GetAttribute("TreasureRush") == true
end

local function isHidden(spot)
	local untilTime = hiddenUntil[spot]
	return untilTime ~= nil and os.clock() < untilTime
end

local function flatDistance(a, b)
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- The closest spot in reach that this player can dig, plus the closest spot in
-- reach of any kind (to explain why you can't dig it)
local function spotsNear(root)
	local best, bestDistance = nil, math.huge
	local any, anyDistance = nil, math.huge
	for spot in pairs(spots) do
		if not spot.Parent or not spot:GetAttribute("DigSpot") then
			spots[spot] = nil -- a Treasure Rush site that is over
		else
			local rush = isRush(spot)
			local distance = flatDistance(spot.Position, root.Position)
			if distance <= (rush and Config.RushReach or Config.DigRange) then
				if distance < anyDistance then
					any, anyDistance = spot, distance
				end
				local zoneId = spot:GetAttribute("DigSpot")
				local unlocked = rush or (State.data and State.data.zones[zoneId])
				if unlocked and not isHidden(spot) and distance < bestDistance then
					best, bestDistance = spot, distance
				end
			end
		end
	end
	return best, any
end

local function startDig()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local spot, any = spotsNear(root)
	if not spot then
		if any and isHidden(any) then
			Notifications.Show("You already dug here. Try another spot!", "warning")
		elseif any then
			local zone = Zones.ById[any:GetAttribute("DigSpot")]
			Notifications.Show("Unlock " .. (zone and zone.name or "this zone") .. " to dig here.", "warning")
		else
			Notifications.Show("Stand next to a sparkling dig spot to dig.", "info")
		end
		return
	end

	phase = "starting"
	local ok, id = pcall(function()
		return Remotes.StartDig:InvokeServer(spot)
	end)
	if not ok or not id then
		reset()
		return
	end
	phase = "digging"
	digId = id
	digSpot = spot
	setRooted(true)
	play("dig", 1)
	setStatus("Digging...")
	token += 1
	local mine = token
	task.delay(WAIT_TIMEOUT, function()
		if token == mine and phase == "digging" then
			reset()
		end
	end)
end

-- Click / tap with the shovel out
local function onActivated()
	if phase == "idle" and not UI.IsWindowOpen() and os.clock() >= findCardUntil then
		startDig()
	end
end

local hookedTools = setmetatable({}, { __mode = "k" })
local function hookTool(tool)
	if not hookedTools[tool] then
		hookedTools[tool] = true
		tool.Activated:Connect(onActivated)
	end
end

local function watchCharacter(character)
	reset()
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == SHOVEL_NAME then
			hookTool(child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") and child.Name == SHOVEL_NAME and (phase == "digging" or phase == "minigame") then
			if phase == "minigame" and digSpot and not isRush(digSpot) then
				hideSpot(digSpot) -- the server uses up the spot too
			end
			Remotes.CancelDig:FireServer()
			reset()
		end
	end)
end

------------------------------------------------------------------ The dig minigame

local function startMinigame(id, params)
	phase = "minigame"
	setStatus(nil)
	local rarity = Finds.RarityById[params.rarity]
	local random = Random.new()
	local connections = {}
	local finished = false
	local hits, perfects, cracks = 0, 0, 0
	local center = Dig.NextCenter(random, params)
	local elapsed = 0
	local lastTap = -math.huge

	local box = UI.new("Frame", {
		Name = "DigGame",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -100),
		Size = UDim2.fromOffset(460, 160),
		BackgroundColor3 = T.Background,
		ZIndex = 21,
		Parent = screenGui,
	}, { UI.corner(14) })
	local outline = UI.stroke(rarity.color, 3)
	outline.Parent = box
	local title = params.rush and "TREASURE RUSH" or string.format("??? (%s)", rarity.id)
	UI.label(title, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 26), TextColor3 = params.rush and T.Gold or rarity.color, ZIndex = 22, Parent = box })

	local barBack = UI.new("Frame", {
		Position = UDim2.fromOffset(20, 44),
		Size = UDim2.new(1, -40, 0, 34),
		BackgroundColor3 = Color3.fromRGB(95, 65, 40),
		ZIndex = 22,
		Parent = box,
	}, { UI.corner(8) })
	local sweet = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromScale(params.zone, 1),
		BackgroundColor3 = T.Good,
		ZIndex = 23,
		Parent = barBack,
	}, { UI.corner(6) })
	UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(params.perfect / params.zone, 1),
		BackgroundColor3 = T.Gold,
		ZIndex = 24,
		Parent = sweet,
	})
	local marker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 6, 1, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 25,
		Parent = barBack,
	}, { UI.corner(3), UI.stroke(Color3.new(0, 0, 0), 1) })

	local depth = UI.label("", { Position = UDim2.fromOffset(20, 86), Size = UDim2.new(0.5, -20, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 22, Parent = box })
	local crackLine = UI.label("", { Position = UDim2.new(0.5, 0, 0, 86), Size = UDim2.new(0.5, -20, 0, 24), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = T.Bad, ZIndex = 22, Parent = box })
	local mood = UI.label("Tap in the green!", { Position = UDim2.new(0, 0, 1, -42), Size = UDim2.new(1, 0, 0, 22), ZIndex = 22, Parent = box })
	UI.label("Click / tap / Space when the marker is in the green", { Position = UDim2.new(0, 0, 1, -18), Size = UDim2.new(1, 0, 0, 14), Font = T.BodyFont, TextColor3 = T.Muted, ZIndex = 22, Parent = box })

	local function refreshLines()
		depth.Text = string.format("Depth %d/%d", hits, params.strikes)
		crackLine.Text = string.rep("X ", cracks) .. string.rep("- ", params.cracks - cracks)
		sweet.Position = UDim2.fromScale(center, 0)
	end
	refreshLines()

	local function close()
		finished = true
		closeMinigame = nil
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		box:Destroy()
	end
	closeMinigame = close

	local function finish(outcome)
		if finished then
			return
		end
		close()
		phase = "done"
		if outcome == "cracked" then
			CameraController.Shake(4, 0.3)
		end
		Remotes.DigDone:FireServer(id, outcome, perfects)
		setStatus(outcome == "found" and "Digging it out..." or nil)
		task.delay(5, function()
			if phase == "done" and digId == id then
				reset()
			end
		end)
	end

	local function tap()
		if elapsed - lastTap < Dig.MinTapGap then
			return -- too soon after the last tap; doesn't count either way
		end
		lastTap = elapsed
		local result = Dig.Judge(Dig.MarkerAt(elapsed, params.speed), center, params)
		if result == "miss" then
			cracks += 1
			play("crack", 1.2)
			CameraController.Shake(2.5, 0.15)
			mood.Text = "CRACK! Careful!"
			mood.TextColor3 = T.Bad
			outline.Color = T.Bad
			if cracks >= params.cracks then
				finish("cracked")
				return
			end
		else
			hits += 1
			if result == "perfect" then
				perfects += 1
				play("ping", 1.5)
				mood.Text = "PERFECT!"
				mood.TextColor3 = T.Gold
			else
				mood.Text = "Nice dig!"
				mood.TextColor3 = T.Good
			end
			play("dig", 0.9 + hits * 0.08)
			outline.Color = rarity.color
			CameraController.Shake(1, 0.08)
			if hits >= params.strikes then
				refreshLines()
				finish("found")
				return
			end
			center = Dig.NextCenter(random, params)
		end
		refreshLines()
	end

	local function isTapInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.Space
			or input.KeyCode == Enum.KeyCode.ButtonR2
			or input.KeyCode == Enum.KeyCode.ButtonA
	end
	table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
		if isTapInput(input) and not (processed and input.UserInputType == Enum.UserInputType.Touch) and not UI.IsWindowOpen() then
			tap()
		end
	end))

	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		-- A menu window pauses the minigame and hides it until the window closes
		box.Visible = not UI.IsWindowOpen()
		if not box.Visible then
			return
		end
		elapsed += math.min(dt, 0.1)
		marker.Position = UDim2.fromScale(Dig.MarkerAt(elapsed, params.speed), 0.5)
		if elapsed > Dig.MaxSeconds then
			finish("cracked")
		end
	end))
end

------------------------------------------------------------------ Aiming

-- What happens if the player digs right now
local function aimInfo(root)
	if not State.data then
		return "Loading...", T.Muted, nil
	end
	local spot, any = spotsNear(root)
	if spot and isRush(spot) then
		return "Click to dig the Treasure Rush!", T.Gold, spot
	elseif spot then
		return "Click to dig!", T.Good, spot
	end
	if any and isHidden(any) then
		return "Dug out. Try another spot", T.Gold, nil
	elseif any then
		local zone = Zones.ById[any:GetAttribute("DigSpot")]
		return "Locked: unlock " .. (zone and zone.name or "this zone") .. " first", T.Bad, nil
	end
	return "Walk to a sparkling dig spot", T.Muted, nil
end

local function updateAim()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local holding = character and character:FindFirstChild(SHOVEL_NAME)
	if phase ~= "idle" or not holding or not root or UI.IsWindowOpen() or os.clock() < findCardUntil then
		aimLabel.Visible = false
		highlight.Adornee = nil
		CameraController.SetCrosshairColor(nil)
		return
	end
	local text, color, spot = aimInfo(root)
	if not UserInputService.MouseEnabled then
		text = text:gsub("Click", "Tap")
	end
	aimLabel.Text = text
	aimLabel.TextColor3 = color
	aimLabel.Visible = true
	highlight.Adornee = spot
	CameraController.SetCrosshairColor(color)
end

------------------------------------------------------------------ Results

local function confetti(colors)
	for _ = 1, 40 do
		local size = math.random(8, 14)
		local piece = UI.new("Frame", {
			Position = UDim2.new(math.random(), 0, 0, -20),
			Size = UDim2.fromOffset(size, size * 0.6),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[math.random(1, #colors)],
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = screenGui,
		})
		local fall = TweenService:Create(piece, TweenInfo.new(math.random(15, 28) / 10, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-360, 360),
		})
		fall:Play()
		fall.Completed:Connect(function()
			piece:Destroy()
		end)
	end
end

local function showFind(result)
	local find = Finds.ById[result.id]
	local rarity = Finds.RarityById[find.rarity]
	local card = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(400, 150),
		BackgroundColor3 = T.Background,
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(rarity.color, 4), UI.padding(10), UI.list(4) })
	local top = "Found!"
	if result.rushLoot then
		top = "TREASURE RUSH LOOT!"
	elseif result.isNew then
		top = "NEW FIND! Added to your Collection"
	elseif result.isRecord then
		top = "NEW PERSONAL RECORD!"
	end
	UI.label(top, { Size = UDim2.new(1, 0, 0, 22), TextColor3 = (result.isNew or result.isRecord or result.rushLoot) and T.Gold or T.Muted, Parent = card })
	UI.label((result.shiny and "Shiny " or "") .. find.name, { Size = UDim2.new(1, 0, 0, 36), TextColor3 = rarity.color, Parent = card })
	if result.isNew or result.isRecord or result.rushLoot or rarity.order >= 4 then
		confetti({ rarity.color, T.Gold, Color3.new(1, 1, 1), T.Accent })
		play("ping", 1.3)
	end
	UI.label(string.format("%s  -  %s  -  %s coins  -  +%d XP", find.rarity, Format.Weight(result.weight), Format.Number(result.value), result.xp or 0), {
		Size = UDim2.new(1, 0, 0, 22),
		Font = T.BodyFont,
		Parent = card,
	})
	local bonus = math.floor((Dig.ValueMultiplier(result.perfects or 0, result.strikes or 1) - 1) * 100 + 0.5)
	local line = string.format("Perfect hits %d/%d  (+%d%% value)", result.perfects or 0, result.strikes or 0, bonus)
	if result.rushLoot then
		line = "Thanks for helping dig out the Treasure Rush!"
	elseif result.buddy then
		line ..= string.format("  -  Dig buddy +%d%%", math.floor(Config.BuddyBonus * 100 + 0.5))
	end
	UI.label(line, {
		Size = UDim2.new(1, 0, 0, 20),
		Font = T.BodyFont,
		TextColor3 = (bonus > 0 or result.buddy or result.rushLoot) and T.Gold or T.Muted,
		Parent = card,
	})
	findCardUntil = os.clock() + 2.8
	task.delay(2.5, function()
		local tween = TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		card:Destroy()
	end)
end

function Digging.Init(gui)
	screenGui = gui
	sound("dig", "rbxasset://sounds/collide.wav", 0.5)
	sound("crack", "rbxasset://sounds/glassbreak.wav", 0.5)
	sound("ping", "rbxasset://sounds/electronicpingshort.wav", 0.6)

	statusLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -120),
		Size = UDim2.fromOffset(520, 30),
		Visible = false,
		TextStrokeTransparency = 0.4,
		Parent = gui,
	})
	aimLabel = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 16),
		Size = UDim2.fromOffset(420, 22),
		Visible = false,
		TextStrokeTransparency = 0.3,
		Parent = gui,
	})
	highlight = Instance.new("Highlight")
	highlight.Name = "DigSpotHighlight"
	highlight.FillColor = T.Gold
	highlight.FillTransparency = 0.6
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = Workspace

	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("DigSpot") then
			spots[item] = true
		end
	end
	Workspace.DescendantAdded:Connect(function(item)
		if item:IsA("BasePart") and item:GetAttribute("DigSpot") then
			spots[item] = true
		end
	end)

	local aimClock = 0
	RunService.Heartbeat:Connect(function(dt)
		-- Trying to walk while digging down stops digging
		if rooted and phase == "digging" and rooted.humanoid.MoveDirection.Magnitude > 0.1 then
			Remotes.CancelDig:FireServer()
			reset()
			Notifications.Show(MESSAGES.walked, "info")
		end
		aimClock += dt
		if aimClock >= 0.1 then
			aimClock = 0
			updateAim()
		end
	end)

	if player.Character then
		watchCharacter(player.Character)
		local tool = player.Character:FindFirstChild(SHOVEL_NAME)
		if tool then
			hookTool(tool)
		end
	end
	player.CharacterAdded:Connect(watchCharacter)

	Remotes.DigReady.OnClientEvent:Connect(function(id, params)
		if id == digId and phase == "digging" then
			play("ping")
			CameraController.Shake(1.5, 0.2)
			startMinigame(id, params)
		end
	end)

	Remotes.DigResult.OnClientEvent:Connect(function(id, result, reason)
		if id == "rush" then
			showFind(result) -- Treasure Rush loot, which can come in the middle of another dig
			return
		end
		if id ~= digId then
			return
		end
		local spot = digSpot
		reset()
		if spot and not isRush(spot) and (result or reason ~= "walked") then
			hideSpot(spot)
		end
		if result and result.rush then
			if result.progress then
				Notifications.Show(string.format("Treasure Rush: %d/%d dug!", result.progress, result.target), "coins")
				play("ping", 1.1)
			else
				Notifications.Show("This Treasure Rush is already over.", "info")
			end
		elseif result then
			showFind(result)
		else
			Notifications.Show(MESSAGES[reason] or MESSAGES.cracked, "warning")
		end
	end)
end

return Digging
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- Grandpa Gus's first-day guide on screen: the current goal at the top, a golden
-- line from you to where you need to go, and Gus talking above his head.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local T = UI.Theme

local Guide = {}

local GUS_TIPS = {
	"Bring me the finds on my board and I'll pay you three times what Ruby would!",
	"Sparkling dirt means treasure. Each spot takes a little while to refill after you dig it.",
	"Hit the gold middle of the green for perfect digs. Perfect finds are worth more!",
	"Finds that are in demand sell for double. Check Ruby's Trading Post!",
	"Clover at the Charm Cart turns your spare finds into lucky charms.",
	"A legendary find is buried somewhere every week. Check the event board!",
}

local player = Players.LocalPlayer
local card, cardText
local beam, beamFrom, beamTo, marker, follower
local gusBubble, gusText

local function findTarget(name)
	if not name then
		return nil
	end
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and (item:GetAttribute("GuideTarget") == name or item:GetAttribute("Station") == name) then
			return item
		end
	end
	return nil
end

local function findGus()
	for _, item in ipairs(Workspace:GetChildren()) do
		if item:IsA("Model") and item:GetAttribute("NpcId") == "Gus" then
			return item
		end
	end
	return nil
end

local function currentStep()
	local data = State.data
	if not data or not data.tutorial or data.tutorial >= Tutorial.Done then
		return nil, nil
	end
	return Tutorial.Steps[data.tutorial], data.tutorial
end

local function update()
	local step, index = currentStep()
	card.Visible = step ~= nil
	if not step then
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	cardText.Text = string.format("Grandpa Gus (%d/%d): %s", index, #Tutorial.Steps, step.text)

	local target = findTarget(step.target)
	if target then
		beamTo.Parent = target
		beam.Enabled = true
		marker.Adornee = target
		marker.Enabled = true
	else
		beam.Enabled = false
		marker.Enabled = false
	end
end

local function setupGus()
	gusBubble = UI.new("BillboardGui", {
		Name = "GusSays",
		Size = UDim2.fromOffset(260, 90),
		StudsOffset = Vector3.new(0, 5.5, 0),
		MaxDistance = 70,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local bubble = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = gusBubble }, { UI.corner(12), UI.padding(8) })
	gusText = UI.label("", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(30, 30, 40), Font = T.BodyFont, TextWrapped = true, Parent = bubble })

	task.spawn(function()
		local tip = 1
		while true do
			local gus = findGus()
			gusBubble.Adornee = gus and gus:FindFirstChild("Head")
			local step = currentStep()
			if step then
				gusText.Text = step.text
			else
				gusText.Text = GUS_TIPS[tip]
				tip = tip % #GUS_TIPS + 1
			end
			task.wait(step and 1 or 8)
		end
	end)
end

function Guide.Init(screenGui)
	card = UI.new("Frame", {
		Name = "GuideCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.fromOffset(560, 56),
		BackgroundColor3 = Color3.fromRGB(255, 244, 214),
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 3), UI.padding(8) })
	cardText = UI.label("", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(60, 40, 20), Font = T.BodyFont, TextWrapped = true, Parent = card })

	-- An invisible part that follows the player carries the start of the line
	follower = Instance.new("Part")
	follower.Name = "GuideFollower"
	follower.Anchored = true
	follower.CanCollide = false
	follower.CanQuery = false
	follower.CanTouch = false
	follower.Transparency = 1
	follower.Size = Vector3.one * 0.2
	follower.Parent = Workspace
	beamFrom = Instance.new("Attachment")
	beamFrom.Name = "GuideFrom"
	beamFrom.Parent = follower
	beamTo = Instance.new("Attachment")
	beamTo.Name = "GuideTo"
	beamTo.Position = Vector3.new(0, 3, 0)
	beam = Instance.new("Beam")
	beam.Attachment0 = beamFrom
	beam.Attachment1 = beamTo
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(T.Gold)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) })
	beam.LightEmission = 1
	beam.Enabled = false
	beam.Parent = beamFrom

	marker = UI.new("BillboardGui", {
		Name = "GuideMarker",
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local arrow = UI.label("V", { Size = UDim2.fromScale(1, 1), TextColor3 = T.Gold, TextStrokeTransparency = 0, Parent = marker })

	RunService.RenderStepped:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			follower.Position = root.Position - Vector3.new(0, 1.5, 0)
		end
		if marker.Enabled then
			marker.StudsOffset = Vector3.new(0, 6 + math.sin(os.clock() * 4) * 0.6, 0)
			arrow.TextTransparency = 0
		end
	end)

	State.Changed:Connect(update)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		update()
	end)
	update()
	setupGus()
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Always-on screen info: coins, bag, the weekly event, Treasure Rush and dig
-- buddy news, and the menu buttons.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Market = require(Shared.Market)
local Zones = require(Shared.Zones)
local Events = require(Shared.Events)
local Charms = require(Shared.Charms)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)
local Notifications = require(script.Parent.Notifications)
local CameraController = require(script.Parent.CameraController)
local T = UI.Theme

local Hud = {}

function Hud.Init(screenGui)
	-- Stats, top left
	local stats = UI.new("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(16, 16),
		Size = UDim2.fromOffset(230, 160),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(10), UI.list(4) })
	local levelLine = UI.label("Lv 1 Digger", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Color3.fromRGB(150, 220, 255), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, Parent = stats })
	local xpBack = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Card, LayoutOrder = 0, Parent = stats }, { UI.corner(3) })
	local xpFill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(150, 220, 255), Parent = xpBack }, { UI.corner(3) })
	levelLine.LayoutOrder = -2
	xpBack.LayoutOrder = -1
	local coins = UI.label("0 coins", { Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = stats })
	local bag = UI.label("Backpack 0/20", { Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = stats })
	local charmLine = UI.label("Charm: none", { Size = UDim2.new(1, 0, 0, 18), Font = T.BodyFont, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3, Parent = stats })
	local bonus = UI.label("", { Size = UDim2.new(1, 0, 0, 18), Font = T.BodyFont, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 4, Parent = stats })

	local function update(data, runtime)
		local progress, level = Level.Progress(data.xp or 0)
		levelLine.Text = string.format("Lv %d Digger", level)
		xpFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		coins.Text = Format.Number(data.coins) .. " coins"
		local size = runtime.bagSize or Config.BagSize
		bag.Text = string.format("Backpack %d/%d", #data.bag, size)
		bag.TextColor3 = #data.bag >= size and T.Bad or T.Text
		local charm = Charms.ById[data.charms.equipped] or Charms.ById[Charms.Default]
		charmLine.Text = charm.free and "Charm: none" or string.format("Charm: %s x%d", charm.name, data.charms.owned[charm.id] or 0)
		charmLine.TextColor3 = charm.color
		local extra = math.floor((Market.Multiplier(data) - 1) * 100 + 0.5)
		if extra > 0 then
			bonus.Text = string.format("Coin bonus: +%d%%", extra)
		else
			bonus.Text = "Sell finds at the Trading Post"
		end
	end
	State.Changed:Connect(update)
	if State.data then
		update(State.data, State.runtime)
	end

	-- Event and weather banner, top center
	local banner = UI.new("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(520, 52),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(6), UI.list(2) })
	local eventLine = UI.label("", { Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.Gold, Parent = banner })
	local weatherLine = UI.label("", { Size = UDim2.new(1, 0, 0, 16), Font = T.BodyFont, TextColor3 = T.Muted, Parent = banner })
	task.spawn(function()
		while true do
			local find, weekLeft = Events.GetEventFind()
			local zone = Zones.ById[find.zone]
			eventLine.Text = string.format("Weekly legend: %s in %s (%s left)", find.name, zone and zone.name or "", Format.Duration(weekLeft))
			local weather, weatherLeft = Events.GetWeather()
			weatherLine.Text = string.format("%s: %s (%s)", weather.name, weather.description, Format.Duration(weatherLeft))
			task.wait(1)
		end
	end)

	-- Treasure Rush and dig buddy news, under the banner. The rush line is a
	-- button that takes you to Dig Town, where the rush site is.
	local news = UI.new("Frame", {
		Name = "News",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(520, 70),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(4) })
	local rushButton = UI.button("", Color3.fromRGB(200, 140, 30), function()
		local ok, message = State.Action("Teleport", "hub")
		if not ok and message then
			Notifications.Show(message, "warning")
		end
	end, { Name = "Rush", Size = UDim2.new(1, 0, 0, 34), Visible = false, LayoutOrder = 1, Parent = news })
	local buddyLine = UI.label("", {
		Name = "Buddy",
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = T.Good,
		TextStrokeTransparency = 0.4,
		Visible = false,
		LayoutOrder = 2,
		Parent = news,
	})
	local player = Players.LocalPlayer
	local function updateBuddy()
		local buddy = player:GetAttribute("DigBuddy")
		buddyLine.Visible = buddy ~= nil
		buddyLine.Text = buddy and string.format("Dig buddy: %s is near, +%d%% coins for you both", buddy, math.floor(Config.BuddyBonus * 100 + 0.5)) or ""
	end
	player:GetAttributeChangedSignal("DigBuddy"):Connect(updateBuddy)
	updateBuddy()
	task.spawn(function()
		while true do
			-- Make room for Grandpa Gus's guide card while it shows
			local guide = screenGui:FindFirstChild("GuideCard")
			news.Position = UDim2.new(0.5, 0, 0, guide and guide.Visible and 134 or 70)
			local active = ReplicatedStorage:GetAttribute("RushActive") == true
			rushButton.Visible = active
			if active then
				local left = math.max(0, (ReplicatedStorage:GetAttribute("RushEndsAt") or 0) - Events.Now())
				rushButton.Text = string.format(
					"TREASURE RUSH in Dig Town! %d/%d dug, %s left. %s to go",
					ReplicatedStorage:GetAttribute("RushProgress") or 0,
					ReplicatedStorage:GetAttribute("RushTarget") or 0,
					Format.Duration(left),
					UserInputService.MouseEnabled and "Click" or "Tap"
				)
			end
			task.wait(0.5)
		end
	end)

	-- Menu buttons, left side under the stats, with keyboard shortcuts. On short
	-- screens (phones) they wrap into a second column, and shrink only if needed.
	local MENU_TOP, CELL_HEIGHT, GAP = 186, 42, 6
	local menu = UI.new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(16, MENU_TOP),
		Size = UDim2.fromOffset(130 * 2 + GAP, 8 * (CELL_HEIGHT + GAP)),
		BackgroundTransparency = 1,
		Parent = screenGui,
	})
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(130, CELL_HEIGHT)
	grid.CellPadding = UDim2.fromOffset(GAP, GAP)
	grid.FillDirection = Enum.FillDirection.Vertical
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = menu
	local menuScale = Instance.new("UIScale")
	menuScale.Parent = menu
	local function fitMenu()
		local room = screenGui.AbsoluteSize.Y - MENU_TOP - 16
		local rows = math.clamp(math.floor((room + GAP) / (CELL_HEIGHT + GAP)), 4, 8)
		grid.FillDirectionMaxCells = rows
		menuScale.Scale = math.clamp(room / (rows * (CELL_HEIGHT + GAP) - GAP), 0.6, 1)
	end
	screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitMenu)
	fitMenu()

	local buttons = {
		{ "Backpack", "Bag", Color3.fromRGB(90, 140, 220), Enum.KeyCode.Q },
		{ "Collection", "Book", Color3.fromRGB(80, 160, 255), Enum.KeyCode.B },
		{ "Bounties", "Bounties", Color3.fromRGB(200, 150, 70), Enum.KeyCode.N },
		{ "Shovels", "Shovels", Color3.fromRGB(230, 140, 60), Enum.KeyCode.R },
		{ "Shop", "Shop", Color3.fromRGB(70, 200, 110), Enum.KeyCode.P },
		{ "Travel", "Teleport", Color3.fromRGB(170, 100, 255), Enum.KeyCode.T },
		{ "Rebirth", "Rebirth", Color3.fromRGB(255, 90, 160), nil },
	}
	local shortcuts = {}
	for index, info in ipairs(buttons) do
		local keyName = info[4] and (" (" .. info[4].Name .. ")") or ""
		UI.button(info[1] .. keyName, info[3], function()
			Panels[info[2]].toggle()
		end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = index, Parent = menu })
		if info[4] then
			shortcuts[info[4]] = info[2]
		end
	end
	if CameraController.IsActive() then
		UI.label("Alt: free the mouse", { Size = UDim2.fromOffset(130, 18), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 99, Parent = menu })
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local panel = shortcuts[input.KeyCode]
		if panel then
			Panels[panel].toggle()
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">MenuLock</string><ProtectedString name="Source"><![CDATA[-- While a menu window is open the player can't walk, jump, switch tools or use
-- prompts. Everything comes back when the window closes. (Digging already
-- won't start while a window is open, see Digging.luau.)

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local StarterGui = game:GetService("StarterGui")

local UI = require(script.Parent.UI)

local MenuLock = {}

local player = Players.LocalPlayer
local controls = nil
local locked = false

local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
		return module and require(module):GetControls()
	end)
	if ok and result then
		controls = result
	end
	return controls
end

local function setBackpack(on)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, on)
	end)
end

local function apply()
	local open = UI.IsWindowOpen()
	if open == locked then
		return
	end
	locked = open
	local c = getControls()
	if c then
		if open then
			c:Disable()
		else
			c:Enable()
		end
	end
	ProximityPromptService.Enabled = not open
	setBackpack(not open)
end

function MenuLock.IsLocked()
	return locked
end

function MenuLock.Init()
	task.spawn(getControls)
	-- Deferred so switching straight from one window to another doesn't unlock in between
	UI.WindowChanged:Connect(function()
		task.defer(apply)
	end)
end

return MenuLock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Small messages that pop up on the right side of the screen.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local T = UI.Theme

local Notifications = {}

local COLORS = {
	success = T.Good,
	warning = T.Bad,
	coins = T.Gold,
	rare = Color3.fromRGB(255, 120, 200),
	info = T.Accent,
}

local container

function Notifications.Init(screenGui)
	container = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.fromOffset(320, 400),
		BackgroundTransparency = 1,
		ZIndex = 20, -- above open windows
		Parent = screenGui,
	}, { UI.list(6) })

	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Show(text, kind)
	end)
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	local toast = UI.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Text = text,
		TextColor3 = COLORS[kind or "info"] or T.Text,
		Font = T.Font,
		TextScaled = true,
		TextWrapped = true,
		Parent = container,
	}, { UI.corner(10), UI.padding(6) })

	task.delay(4, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)

	-- Keep at most 6 on screen
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 6 then
		toasts[1]:Destroy()
	end
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- The menus: Backpack, Trading Post, Charm Cart, Bounties, Collection, Shovels,
-- Shop, Travel and Rebirth.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Finds = require(Shared.Finds)
local Shovels = require(Shared.Shovels)
local Zones = require(Shared.Zones)
local Shop = require(Shared.Shop)
local Events = require(Shared.Events)
local Charms = require(Shared.Charms)
local Market = require(Shared.Market)
local Bounties = require(Shared.Bounties)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Notifications = require(script.Parent.Notifications)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}

local function act(actionName, argument)
	local ok, message = State.Action(actionName, argument)
	if not ok and message then
		Notifications.Show(message, "warning")
	end
	return ok
end

-- Robux prices come from Roblox, so they always match the Creator Dashboard
local priceCache = {}
local function robuxPrice(id, infoType, onReady)
	local key = tostring(infoType) .. id
	if priceCache[key] then
		onReady(priceCache[key])
		return
	end
	task.spawn(function()
		-- Asks Roblox every time instead of hard-coding prices, so each player sees
		-- their own regional price
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(id, infoType)
		end)
		if not ok then
			ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, infoType)
			end)
		end
		if ok and info and info.PriceInRobux then
			priceCache[key] = info.PriceInRobux
			onReady(info.PriceInRobux)
		end
	end)
end

local function row(parent, height, order)
	return UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = T.Card,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(10) })
end

local function heading(parent, text, order)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, LayoutOrder = order, Parent = parent })
end

------------------------------------------------------------------ Backpack and Trading Post
local function sortedBag(data)
	local list = table.clone(data.bag)
	table.sort(list, function(a, b)
		return a.value > b.value
	end)
	return list
end

local function hotNames(hot)
	local names = {}
	for id in pairs(hot) do
		table.insert(names, Finds.ById[id].name)
	end
	table.sort(names)
	return table.concat(names, ", ")
end

-- One row per find. selling = true shows Sell buttons (Trading Post only).
local function findRows(body, data, selling, startOrder)
	local hot = Market.HotFinds()
	local bag = sortedBag(data)
	if #bag == 0 then
		UI.label("Your backpack is empty. Go dig something up!", { Size = UDim2.new(1, -8, 0, 26), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = startOrder, Parent = body })
		return
	end
	for index, entry in ipairs(bag) do
		local find = Finds.ById[entry.id]
		local rarity = Finds.RarityById[find.rarity]
		local card = row(body, 50, startOrder + index)
		local name = (entry.shiny and "Shiny " or "") .. find.name
		UI.label(name, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.5, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color, Parent = card })
		local price = Market.Price(entry, data, hot)
		local detail = string.format("%s  -  %s  -  %s coins%s", find.rarity, Format.Weight(entry.weight), Format.Number(price), hot[entry.id] and "  (IN DEMAND x2)" or "")
		UI.label(detail, { Position = UDim2.fromOffset(12, 28), Size = UDim2.new(0.6, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = hot[entry.id] and T.Gold or T.Muted, Parent = card })

		local uid = tostring(entry.uid)
		UI.button(entry.favorite and "Favorite" or "Keep?", entry.favorite and T.Gold or T.Card, function()
			act("ToggleFavorite", uid)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, selling and -112 or -12, 0.5, 0), Size = UDim2.fromOffset(96, 34), Parent = card })
		if selling then
			UI.button("Sell", entry.favorite and T.Card or T.Good, function()
				act("SellFind", uid)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(90, 34), Parent = card })
		end
	end
end

local function renderBag(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local size = State.runtime.bagSize or Config.BagSize
	heading(body, string.format("Finds (%d/%d)", #data.bag, size), 1)
	UI.label("Favorites are never sold, used for charms or turned in. Sell at the Trading Post.", { Size = UDim2.new(1, -8, 0, 20), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 2, Parent = body })
	findRows(body, data, false, 10)

	heading(body, "Charms (one is used up each dig)", 1000)
	for index, charm in ipairs(Charms.List) do
		local count = charm.free and math.huge or (data.charms.owned[charm.id] or 0)
		if count > 0 then
			local card = row(body, 50, 1000 + index)
			UI.label(charm.name .. (charm.free and "" or ("  x" .. count)), { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(0.6, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = charm.color, Parent = card })
			UI.label(charm.description, { Position = UDim2.fromOffset(12, 28), Size = UDim2.new(0.7, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
			local equipped = data.charms.equipped == charm.id
			UI.button(equipped and "In use" or "Use", equipped and T.Card or T.Accent, function()
				act("EquipCharm", charm.id)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(110, 34), Parent = card })
		end
	end
end

local function renderMarket(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local hot, left = Market.HotFinds()
	UI.label(string.format("In demand (sells for x2) for %s: %s", Format.Duration(left), hotNames(hot)), {
		Size = UDim2.new(1, -8, 0, 40),
		TextWrapped = true,
		TextColor3 = T.Gold,
		LayoutOrder = 1,
		Parent = body,
	})

	local total, count = 0, 0
	for _, entry in ipairs(data.bag) do
		if not entry.favorite then
			total += Market.Price(entry, data, hot)
			count += 1
		end
	end
	UI.button(string.format("Sell all %d for %s coins (keeps favorites)", count, Format.Number(total)), count > 0 and T.Good or T.Card, function()
		act("SellAll")
	end, { Size = UDim2.new(1, -8, 0, 44), LayoutOrder = 2, Parent = body })
	UI.label("Tip: keep finds that are about to be in demand, or trade them for charms and bounties.", { Size = UDim2.new(1, -8, 0, 18), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 3, Parent = body })
	findRows(body, data, true, 10)
end

------------------------------------------------------------------ Charm Cart
local function findCountByRarity(data)
	local counts = {}
	for _, entry in ipairs(data.bag) do
		if not entry.favorite then
			local rarity = Finds.ById[entry.id].rarity
			counts[rarity] = (counts[rarity] or 0) + 1
		end
	end
	return counts
end

local function renderCharms(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local counts = findCountByRarity(data)
	UI.label("Charms bring luck. One is used up each time you find something, even if it breaks.", { Size = UDim2.new(1, -8, 0, 20), Font = T.BodyFont, TextColor3 = T.Muted, LayoutOrder = 0, Parent = body })
	for index, charm in ipairs(Charms.List) do
		if not charm.free then
			local owned = data.charms.owned[charm.id] or 0
			local card = row(body, 96, index)
			UI.label(string.format("%s  (you have %d)", charm.name, owned), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.45, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = charm.color, Parent = card })
			UI.label(charm.description, { Position = UDim2.fromOffset(12, 32), Size = UDim2.new(0.45, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
			if charm.recipe then
				local parts, canCraft = {}, true
				for _, need in ipairs(charm.recipe) do
					local have = counts[need.rarity] or 0
					canCraft = canCraft and have >= need.count
					table.insert(parts, string.format("%d %s (have %d)", need.count, need.rarity, have))
				end
				UI.label(string.format("Make %d from: %s", charm.craftAmount, table.concat(parts, " + ")), { Position = UDim2.fromOffset(12, 54), Size = UDim2.new(0.62, 0, 0, 34), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Text, Parent = card })
				UI.button("Make", canCraft and T.Good or T.Card, function()
					act("CraftCharm", charm.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 52), Size = UDim2.fromOffset(150, 34), Parent = card })
			end
			if charm.price then
				UI.button(string.format("Buy %d: %s", charm.buyAmount, Format.Number(charm.price)), data.coins >= charm.price and T.Accent or T.Card, function()
					act("BuyCharm", charm.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(150, 34), Parent = card })
			end
			if owned > 0 then
				local equipped = data.charms.equipped == charm.id
				UI.button(equipped and "In use" or "Use", equipped and T.Card or T.Accent, function()
					act("EquipCharm", charm.id)
				end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -170, 0, 10), Size = UDim2.fromOffset(90, 34), Parent = card })
			end
		end
	end
end

------------------------------------------------------------------ Bounties
local function renderBounties(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local now = os.time()
	local resetIn = 86400 - (now % 86400)
	UI.label(string.format("Grandpa Gus pays %dx the Trading Post price, plus charms. New bounties in %s.", Bounties.RewardMultiplier, Format.Duration(resetIn)), {
		Size = UDim2.new(1, -8, 0, 22),
		Font = T.BodyFont,
		TextColor3 = T.Muted,
		LayoutOrder = 0,
		Parent = body,
	})
	for index, bounty in ipairs(data.bounties.list) do
		local find = Finds.ById[bounty.findId]
		local rarity = Finds.RarityById[find.rarity]
		local have = 0
		for _, entry in ipairs(data.bag) do
			if entry.id == bounty.findId and not entry.favorite then
				have += 1
			end
		end
		local card = row(body, 70, index)
		UI.label(string.format("Bring %dx %s", bounty.count, find.name), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.62, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = rarity.color, Parent = card })
		local reward = Bounties.Reward(bounty, Market.Multiplier(data))
		local zone = Zones.ById[find.zone]
		UI.label(string.format("Have %d/%d  -  found in %s  -  reward %s coins + %d %s", math.min(have, bounty.count), bounty.count, zone and zone.name or "", Format.Number(reward), bounty.charmAmount, Charms.ById[bounty.charm].name), {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.new(0.68, 0, 0, 28),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			Parent = card,
		})
		local props = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 40), Parent = card }
		if bounty.done then
			UI.button("Done!", T.Card, nil, props)
		else
			UI.button("Turn in", have >= bounty.count and T.Good or T.Card, function()
				act("ClaimBounty", tostring(index))
			end, props)
		end
	end
end

------------------------------------------------------------------ Collection
local bookTab = Zones.List[1].id

local function renderBook(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(10).Parent = body

	local tabs = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1, LayoutOrder = 1, Parent = body }, { UI.list(8, Enum.FillDirection.Horizontal) })
	local tabList = {}
	for _, zone in ipairs(Zones.List) do
		table.insert(tabList, { id = zone.id, name = zone.name, short = zone.short, finds = Finds.ByZone[zone.id] or {} })
	end
	table.insert(tabList, { id = "event", name = "Weekly Legends", short = "Legends", finds = Finds.EventFinds })

	local found, total = 0, #Finds.List
	for id in pairs(data.book) do
		if Finds.ById[id] then
			found += 1
		end
	end

	local current
	for index, tab in ipairs(tabList) do
		if tab.id == bookTab then
			current = tab
		end
		UI.button(tab.short, tab.id == bookTab and T.Accent or T.Card, function()
			bookTab = tab.id
			Panels.Book.refresh()
		end, { Size = UDim2.new(1 / #tabList, -8, 0, 36), LayoutOrder = index, Parent = tabs })
	end
	current = current or tabList[1]

	local zoneFound = 0
	for _, find in ipairs(current.finds) do
		if data.book[find.id] then
			zoneFound += 1
		end
	end
	local header = string.format("%s: %d/%d found   (whole collection: %d/%d)", current.name, zoneFound, #current.finds, found, total)
	if current.id ~= "event" then
		header ..= Finds.IsPageComplete(data.book, current.id) and "   Page complete!" or string.format("   Complete it: +%d%% coins", math.floor(Config.PageSellBonus * 100 + 0.5))
	end
	UI.label(header, {
		Size = UDim2.new(1, -8, 0, 24),
		Font = T.BodyFont,
		TextColor3 = T.Muted,
		LayoutOrder = 2,
		Parent = body,
	})

	local grid = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = body }, {
		UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(134, 112), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	for index, find in ipairs(current.finds) do
		local entry = data.book[find.id]
		local rarity = Finds.RarityById[find.rarity]
		local card = UI.new("Frame", { BackgroundColor3 = T.Card, LayoutOrder = index, Parent = grid }, { UI.corner(10), UI.stroke(rarity.color, 2), UI.padding(6), UI.list(2) })
		UI.label(entry and find.name or "???", { Size = UDim2.new(1, 0, 0, 34), TextWrapped = true, Parent = card })
		UI.label(find.rarity, { Size = UDim2.new(1, 0, 0, 18), TextColor3 = rarity.color, Parent = card })
		local detail = "Not found yet"
		if entry then
			detail = string.format("x%d  best %s", entry.count, Format.Weight(entry.best))
			if entry.shiny > 0 then
				detail ..= string.format("\n%d shiny", entry.shiny)
			end
		end
		UI.label(detail, { Size = UDim2.new(1, 0, 0, 34), Font = T.BodyFont, TextColor3 = T.Muted, TextWrapped = true, Parent = card })
	end

	if current.id == "event" then
		local eventFind, left = Events.GetEventFind()
		local zone = Zones.ById[eventFind.zone]
		UI.label(string.format("This week: %s in %s (ends in %s)", eventFind.name, zone and zone.name or "", Format.Duration(left)), {
			Size = UDim2.new(1, -8, 0, 24),
			Font = T.BodyFont,
			TextColor3 = T.Gold,
			LayoutOrder = 4,
			Parent = body,
		})
	end
end

------------------------------------------------------------------ Shovels
local function renderShovels(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	for index, shovel in ipairs(Shovels.List) do
		local card = row(body, 64, index)
		UI.label(shovel.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = shovel.color:Lerp(Color3.new(1, 1, 1), 0.4), Parent = card })
		local stats = string.format("Luck x%.2f   Digs %d%% faster   Sweet spot +%d%%", shovel.luck, math.floor((1 - shovel.speed) * 100 + 0.5), math.floor(shovel.power * 100 + 0.5))
		UI.label(stats, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.68, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })

		local text, color, onClick
		if data.equippedShovel == shovel.id then
			text, color = "Equipped", T.Card
		elseif data.shovelsOwned[shovel.id] then
			text, color = "Equip", T.Accent
			onClick = function()
				act("EquipShovel", shovel.id)
			end
		elseif shovel.requiresRebirths and data.rebirths < shovel.requiresRebirths then
			text, color = string.format("%d rebirth", shovel.requiresRebirths), T.Card
		else
			text = Format.Number(shovel.price) .. " coins"
			color = data.coins >= shovel.price and T.Good or T.Bad
			onClick = function()
				act("BuyShovel", shovel.id)
			end
		end
		UI.button(text, color, onClick, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 40), Parent = card })
	end
end

------------------------------------------------------------------ Shop
local function renderShop(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	heading(body, "Game passes (yours forever)", nextOrder())
	for _, pass in ipairs(Shop.Passes) do
		local card = row(body, 64, nextOrder())
		UI.label(pass.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.label(pass.description, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.68, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
		local button = UI.button("...", T.Good, nil, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 40), Parent = card })
		if State.HasPass(pass.id) then
			button.Text = "Owned"
			button.BackgroundColor3 = T.Card
		elseif pass.gamePassId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(pass.gamePassId, Enum.InfoType.GamePass, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptGamePassPurchase(player, pass.gamePassId)
			end)
		end
	end

	local function cosmeticRow(item)
		local card = row(body, 52, nextOrder())
		local label = UI.label(item.name, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.65, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), Parent = label })
		local owned = data.cosmetics.owned[item.id]
		local equipped = data.cosmetics.equipped[item.kind] == item.id
		local button = UI.button("...", T.Good, nil, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 36), Parent = card })
		if owned then
			button.Text = equipped and "Unequip" or "Equip"
			button.BackgroundColor3 = equipped and T.Card or T.Accent
			button.Activated:Connect(function()
				act("EquipCosmetic", item.id)
			end)
		elseif item.earned then
			button.Text = "Not earned"
			button.BackgroundColor3 = T.Card
		elseif item.productId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(item.productId, Enum.InfoType.Product, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptProductPurchase(player, item.productId)
			end)
		end
	end

	heading(body, "Shovel skins (looks only)", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "shovelSkin" then
			cosmeticRow(item)
		end
	end
	heading(body, "Trails (looks only)", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "trail" then
			cosmeticRow(item)
		end
	end
	heading(body, "Titles", nextOrder())
	for _, item in ipairs(Shop.Cosmetics) do
		if item.kind == "title" then
			cosmeticRow(item)
		end
	end
	heading(body, "Earned titles (free, unlocked by playing)", nextOrder())
	for _, item in ipairs(Shop.EarnedTitles) do
		cosmeticRow(item)
	end
end

------------------------------------------------------------------ Teleport
local function renderTeleport(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local hasPass = State.HasPass("Teleporter")
	if not hasPass then
		UI.label("Walk across the bridges to reach zones, or get the Zone Teleporter pass in the Shop.", {
			Size = UDim2.new(1, -8, 0, 40),
			TextWrapped = true,
			Font = T.BodyFont,
			TextColor3 = T.Muted,
			LayoutOrder = 0,
			Parent = body,
		})
	end

	local hubRow = row(body, 56, 1)
	UI.label("Dig Town (hub)", { Position = UDim2.fromOffset(12, 14), Size = UDim2.new(0.6, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, Parent = hubRow })
	UI.button("Go", T.Accent, function()
		if act("Teleport", "hub") then
			Panels.Teleport.close()
		end
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 38), Parent = hubRow })

	for index, zone in ipairs(Zones.List) do
		local card = row(body, 56, index + 1)
		UI.label(zone.name, { Position = UDim2.fromOffset(12, 14), Size = UDim2.new(0.6, 0, 0, 28), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = zone.color, Parent = card })
		local props = { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 38), Parent = card }
		local previous = Zones.Previous(zone.id)
		if not data.zones[zone.id] and previous and not data.zones[previous.id] then
			UI.button("Unlock " .. previous.short .. " first", T.Card, nil, props)
		elseif not data.zones[zone.id] and Level.FromXp(data.xp) < zone.level then
			UI.button("Needs Lv " .. zone.level, T.Card, nil, props)
		elseif not data.zones[zone.id] then
			UI.button("Unlock " .. Format.Number(zone.price), data.coins >= zone.price and T.Good or T.Bad, function()
				act("UnlockZone", zone.id)
			end, props)
		elseif hasPass then
			UI.button("Go", T.Accent, function()
				if act("Teleport", zone.id) then
					Panels.Teleport.close()
				end
			end, props)
		else
			UI.button("Unlocked", T.Card, nil, props)
		end
	end
end

------------------------------------------------------------------ Rebirth
local function renderRebirth(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(10).Parent = body
	local cost = Config.RebirthCost(data.rebirths)
	local pages = Finds.CompletedPages(data.book)
	local nowBonus = math.floor((Config.SellMultiplier(data.rebirths, pages) - 1) * 100 + 0.5)
	local nextBonus = math.floor((Config.SellMultiplier(data.rebirths + 1, pages) - 1) * 100 + 0.5)
	local requiredZone = Zones.ById[Config.RebirthRequiresZone]

	local lines = {
		string.format("Rebirths: %d   (now +%d%% coins from finds)", data.rebirths, nowBonus),
		string.format("Next rebirth: +%d%% coins from finds, forever", nextBonus),
		string.format("Cost: %s coins", Format.Number(cost)),
		"You keep: your Collection, favorite finds, charms, titles, skins, trails and passes.",
		"You reset: coins, shovels, unlocked zones and the rest of your backpack.",
	}
	if requiredZone then
		local done = data.zones[requiredZone.id] and "  (done)" or "  (not yet)"
		table.insert(lines, "Requires: " .. requiredZone.name .. " unlocked." .. done)
	end
	for index, text in ipairs(lines) do
		UI.label(text, { Size = UDim2.new(1, -8, 0, 26), TextWrapped = true, Font = index <= 3 and T.Font or T.BodyFont, TextColor3 = index <= 3 and T.Text or T.Muted, LayoutOrder = index, Parent = body })
	end
	local ready = data.coins >= cost and (not requiredZone or data.zones[requiredZone.id])
	UI.button("Rebirth", ready and T.Good or T.Card, function()
		if act("Rebirth") then
			Panels.Rebirth.close()
		end
	end, { Size = UDim2.fromOffset(200, 50), LayoutOrder = 99, Parent = body })
end

function Panels.Init(screenGui)
	Panels.Bag = UI.window(screenGui, "Backpack", renderBag)
	Panels.Market = UI.window(screenGui, "Trading Post", renderMarket)
	Panels.Charms = UI.window(screenGui, "Charm Cart", renderCharms)
	Panels.Bounties = UI.window(screenGui, "Grandpa Gus's Bounties", renderBounties)
	Panels.Book = UI.window(screenGui, "Collection", renderBook)
	Panels.Shovels = UI.window(screenGui, "Shovels", renderShovels)
	Panels.Shop = UI.window(screenGui, "Shop", renderShop)
	Panels.Teleport = UI.window(screenGui, "Travel", renderTeleport)
	Panels.Rebirth = UI.window(screenGui, "Rebirth", renderRebirth)

	State.Changed:Connect(function()
		for _, name in ipairs({ "Bag", "Market", "Charms", "Bounties", "Book", "Shovels", "Shop", "Teleport", "Rebirth" }) do
			Panels[name].refresh()
		end
	end)
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- The player's latest save data, as sent by the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {
	data = nil,
	runtime = { passes = {}, bagSize = 20 },
}

local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

Remotes.DataUpdate.OnClientEvent:Connect(function(data, runtime)
	State.data = data
	State.runtime = runtime or State.runtime
	changed:Fire(data, State.runtime)
end)

function State.HasPass(passId)
	return State.runtime.passes ~= nil and State.runtime.passes[passId] == true
end

-- Calls a server action and shows its error message if it fails
function State.Action(actionName, argument)
	local ok, success, message = pcall(function()
		return Remotes.Action:InvokeServer(actionName, argument)
	end)
	if not ok then
		return false, "Connection problem, try again"
	end
	return success, message
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Helpers for building the on-screen menus in code, so nothing has to be
-- drawn by hand in Studio. Colors and fonts live in UI.Theme.

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(20, 32, 52),
	Panel = Color3.fromRGB(30, 46, 74),
	Card = Color3.fromRGB(42, 62, 96),
	Accent = Color3.fromRGB(60, 170, 255),
	Gold = Color3.fromRGB(255, 200, 40),
	Good = Color3.fromRGB(70, 200, 110),
	Bad = Color3.fromRGB(230, 80, 80),
	Muted = Color3.fromRGB(150, 170, 200),
	Text = Color3.fromRGB(255, 255, 255),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamMedium,
}

local T = UI.Theme

-- UI.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function UI.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness)
	return UI.new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.padding(pixels)
	local p = UDim.new(0, pixels)
	return UI.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function UI.list(spacing, direction)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, spacing or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(text, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in pairs(props or {}) do
		label[key] = value
	end
	return label
end

function UI.button(text, color, onClick, props)
	local button = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.Accent,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(120, 40),
	}, { UI.corner(8), UI.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
	for key, value in pairs(props or {}) do
		button[key] = value
	end
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		child:Destroy()
	end
end

-- A centered window with a title, a close button and a scrolling body.
-- Only one window is open at a time.
local openWindow = nil
local windowChanged = Instance.new("BindableEvent")
UI.WindowChanged = windowChanged.Event -- fires with true/false when a window opens/closes

function UI.IsWindowOpen()
	return openWindow ~= nil
end

function UI.window(screenGui, title, render)
	local frame = UI.new("Frame", {
		Name = title .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 440),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Active = true, -- clicks on the window don't reach the game (no digging through it)
		ZIndex = 10, -- above the HUD and Grandpa Gus's tips, so the close button is never covered
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(T.Background, 4) })

	UI.label(title, { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -90, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })

	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.new(1, -32, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	})

	local window = { frame = frame, body = body }

	function window.refresh()
		if frame.Visible then
			UI.clear(body)
			render(body)
		end
	end

	function window.open()
		if openWindow and openWindow ~= window then
			openWindow.close()
		end
		openWindow = window
		frame.Visible = true
		window.refresh()
		windowChanged:Fire(true)
	end

	function window.close()
		frame.Visible = false
		if openWindow == window then
			openWindow = nil
			windowChanged:Fire(false)
		end
	end

	function window.toggle()
		if frame.Visible then
			window.close()
		else
			window.open()
		end
	end

	UI.button("X", T.Bad, window.close, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(40, 40),
		Parent = frame,
	})

	return window
end

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Things in the world that only this player sees: weather, opened zone gates,
-- the VIP door, and ambient life (seagulls).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Events = require(Shared.Events)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)

local World = {}

local LOOKS = {
	Clear = { ClockTime = 14, Brightness = 2.5, Density = 0.25, Color = Color3.fromRGB(200, 220, 255), Rain = 0 },
	Rain = { ClockTime = 13, Brightness = 1.2, Density = 0.4, Color = Color3.fromRGB(150, 160, 175), Rain = 300 },
	Fog = { ClockTime = 9, Brightness = 1.5, Density = 0.62, Color = Color3.fromRGB(200, 205, 210), Rain = 0 },
	Storm = { ClockTime = 19, Brightness = 0.8, Density = 0.5, Color = Color3.fromRGB(90, 95, 120), Rain = 700 },
	GoldenHour = { ClockTime = 17.6, Brightness = 2.2, Density = 0.3, Color = Color3.fromRGB(255, 190, 120), Rain = 0 },
}

local atmosphere
local rainEmitter

local function setupWeatherEffects()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting

	local rainPart = Instance.new("Part")
	rainPart.Name = "RainCloud"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.CanTouch = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(120, 1, 120)
	rainEmitter = Instance.new("ParticleEmitter")
	rainEmitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	rainEmitter.Color = ColorSequence.new(Color3.fromRGB(180, 200, 255))
	rainEmitter.Size = NumberSequence.new(0.15)
	rainEmitter.Lifetime = NumberRange.new(1.2)
	rainEmitter.Speed = NumberRange.new(50)
	rainEmitter.EmissionDirection = Enum.NormalId.Bottom
	rainEmitter.Rate = 0
	rainEmitter.Parent = rainPart
	rainPart.Parent = Workspace

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if camera then
			rainPart.Position = camera.CFrame.Position + Vector3.new(0, 40, 0)
		end
	end)
end

local currentWeather = nil
local function applyWeather()
	local weather = Events.GetWeather()
	if weather.id == currentWeather then
		return
	end
	currentWeather = weather.id
	local look = LOOKS[weather.id] or LOOKS.Clear
	local info = TweenInfo.new(5)
	TweenService:Create(Lighting, info, { ClockTime = look.ClockTime, Brightness = look.Brightness }):Play()
	TweenService:Create(atmosphere, info, { Density = look.Density, Color = look.Color }):Play()
	rainEmitter.Rate = look.Rain
end

local function updateGates()
	local data = State.data
	if not data then
		return
	end
	local vip = State.HasPass("VIP")
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") then
			local zoneId = item:GetAttribute("ZoneGate")
			if zoneId then
				local open = data.zones[zoneId] == true
				item.CanCollide = not open
				item.Transparency = open and 0.9 or 0
				local prompt = item:FindFirstChildOfClass("ProximityPrompt")
				if prompt then
					prompt.Enabled = not open
				end
				for _, gui in ipairs(item:GetChildren()) do
					if gui:IsA("SurfaceGui") then
						gui.Enabled = not open
					end
				end
			elseif item:GetAttribute("VipDoor") then
				item.CanCollide = not vip
				item.Transparency = vip and 0.8 or 0.5
			end
		end
	end
end

------------------------------------------------------------------ Ambient life

-- Seagulls circling over the islands
local function seagulls()
	local birds = {}
	local centers = { Vector3.new(0, 0, 0), Vector3.new(230, 0, 0), Vector3.new(460, 0, 0), Vector3.new(690, 0, 0), Vector3.new(920, 0, 0) }
	for i = 1, 8 do
		local model = Instance.new("Model")
		model.Name = "Seagull"
		local function bit(size, color)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Size = size
			p.Color = color
			p.Parent = model
			return p
		end
		local body = bit(Vector3.new(0.7, 0.7, 2), Color3.fromRGB(245, 245, 245))
		local left = bit(Vector3.new(2.4, 0.15, 0.9), Color3.fromRGB(200, 200, 205))
		local right = bit(Vector3.new(2.4, 0.15, 0.9), Color3.fromRGB(200, 200, 205))
		model.Parent = Workspace
		table.insert(birds, {
			body = body,
			left = left,
			right = right,
			center = centers[(i - 1) % #centers + 1] + Vector3.new(math.random(-30, 30), 0, math.random(-30, 30)),
			radius = 25 + math.random() * 30,
			height = 30 + math.random() * 15,
			speed = (0.15 + math.random() * 0.15) * (math.random() < 0.5 and -1 or 1),
			phase = math.random() * math.pi * 2,
		})
	end
	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for _, bird in ipairs(birds) do
			local a = bird.phase + now * bird.speed
			local position = bird.center + Vector3.new(math.cos(a) * bird.radius, bird.height + math.sin(now * 0.7 + bird.phase) * 2, math.sin(a) * bird.radius)
			local tangent = Vector3.new(-math.sin(a), 0, math.cos(a)) * math.sign(bird.speed)
			local frame = CFrame.lookAt(position, position + tangent) * CFrame.Angles(0, 0, -0.3 * math.sign(bird.speed))
			local flap = math.sin(now * 8 + bird.phase) * 0.5
			bird.body.CFrame = frame
			bird.left.CFrame = frame * CFrame.new(-0.35, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(-1.2, 0, 0)
			bird.right.CFrame = frame * CFrame.new(0.35, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(1.2, 0, 0)
		end
	end)
end

function World.Init()
	seagulls()

	setupWeatherEffects()
	applyWeather()
	task.spawn(function()
		while true do
			task.wait(2)
			applyWeather()
		end
	end)

	State.Changed:Connect(updateGates)
	updateGates()

	Remotes.OpenPanel.OnClientEvent:Connect(function(name)
		local panel = Panels[name]
		if panel then
			panel.open()
		end
	end)
end

return World
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
