<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000013"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Bounties</string><ProtectedString name="Source"><![CDATA[-- Grandpa Gus's daily bounties: three find requests per player per day.
-- Turning one in pays three times what the Trading Post would, plus charms.

local Finds = require(script.Parent.Finds)
local Zones = require(script.Parent.Zones)

local Bounties = {}

Bounties.RewardMultiplier = 3

-- { rarity, count range, charm reward }
local SLOTS = {
	{ rarity = "Common", count = { 3, 5 }, charm = "clover", charmAmount = 5 },
	{ rarity = "Uncommon", count = { 2, 3 }, charm = "horseshoe", charmAmount = 3 },
	{ rarity = "Rare", count = { 1, 1 }, charm = "glow_stone", charmAmount = 2 },
}

function Bounties.Today(now)
	return math.floor(now / 86400)
end

-- Makes the day's bounties from the player's two newest unlocked zones, so the
-- rewards keep up as they progress
function Bounties.Generate(userId, day, unlockedZones)
	local random = Random.new(userId % 1000003 * 977 + day)
	local open = {}
	for _, zone in ipairs(Zones.List) do
		if unlockedZones[zone.id] then
			table.insert(open, zone)
		end
	end
	local recent = { open[#open], open[#open - 1] }
	local list = {}
	for _, slot in ipairs(SLOTS) do
		local pool = {}
		for _, zone in ipairs(recent) do
			if zone then
				for _, find in ipairs(Finds.ByZone[zone.id] or {}) do
					if find.rarity == slot.rarity then
						table.insert(pool, find)
					end
				end
			end
		end
		if #pool > 0 then
			local find = pool[random:NextInteger(1, #pool)]
			table.insert(list, {
				findId = find.id,
				count = random:NextInteger(slot.count[1], slot.count[2]),
				charm = slot.charm,
				charmAmount = slot.charmAmount,
				done = false,
			})
		end
	end
	return list
end

-- Coins paid for a bounty
function Bounties.Reward(bounty, sellMultiplier)
	local find = Finds.ById[bounty.findId]
	return math.floor(find.value * bounty.count * Bounties.RewardMultiplier * sellMultiplier)
end

return Bounties
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Charms</string><ProtectedString name="Source"><![CDATA[-- A charm is used up each time you dig, whether the find survives or not.
-- Charms are bought with coins or made from finds, never sold for Robux.
--
-- digSpeed: multiplies how long it takes to dig down (lower is faster)
-- luck: multiplies the chance of Rare and better finds
-- legendary: multiplies the chance of Legendary finds
-- shiny: multiplies the chance of a Shiny find
-- price/buyAmount: coins for a pack at the Charm Cart (no price = can't buy)
-- recipe: finds (by rarity) traded in to make craftAmount charms

local Charms = {}

Charms.List = {
	{
		id = "none",
		name = "No charm",
		free = true,
		color = Color3.fromRGB(200, 200, 200),
		description = "Free and endless. No bonus.",
	},
	{
		id = "clover",
		name = "Clover",
		price = 150,
		buyAmount = 10,
		digSpeed = 0.7,
		color = Color3.fromRGB(110, 220, 110),
		description = "Dig down 30% faster.",
	},
	{
		id = "horseshoe",
		name = "Horseshoe",
		price = 400,
		buyAmount = 5,
		luck = 1.35,
		recipe = { { rarity = "Common", count = 3 } },
		craftAmount = 2,
		color = Color3.fromRGB(190, 190, 210),
		description = "Rare and better finds 35% more likely.",
	},
	{
		id = "glow_stone",
		name = "Glow Stone",
		luck = 1.7,
		shiny = 2,
		recipe = { { rarity = "Uncommon", count = 2 }, { rarity = "Rare", count = 1 } },
		craftAmount = 3,
		color = Color3.fromRGB(120, 255, 220),
		description = "Rare+ finds 70% more likely, Shiny finds twice as likely. Craft only.",
	},
	{
		id = "legend_map",
		name = "Legend Map",
		legendary = 2.5,
		digSpeed = 0.85,
		recipe = { { rarity = "Rare", count = 3 }, { rarity = "Epic", count = 1 } },
		craftAmount = 2,
		color = Color3.fromRGB(255, 180, 40),
		description = "Legendary finds 2.5x as likely. Craft only.",
	},
}

Charms.ById = {}
for index, charm in ipairs(Charms.List) do
	charm.order = index
	Charms.ById[charm.id] = charm
end

Charms.Default = "none"

return Charms
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- General game settings. Change numbers here to rebalance the game.

local Config = {}

Config.GameName = "Dig Up a Legendary!"

-- Saving
Config.DataStoreName = "PlayerData_v1"
Config.LeaderboardStoreName = "TotalFound_v1"
Config.AutosaveSeconds = 120

-- Backpack
Config.BagSize = 20
Config.BigBagSize = 60 -- with the Big Backpack pass

-- Digging
Config.DigRange = 9 -- studs from the player to a dig spot
Config.DigDownMin = 1.2 -- seconds of digging before the find shows up (before shovel speed)
Config.DigDownMax = 2.4
Config.DigCooldown = 0.6
Config.SpotCooldown = 20 -- seconds before you can dig the same spot again
Config.ShinyChance = 1 / 100
Config.ShinyValueMultiplier = 3

-- Rebirth: cost = RebirthBaseCost * RebirthCostGrowth ^ rebirths
Config.RebirthBaseCost = 1000000
Config.RebirthCostGrowth = 3
Config.RebirthSellBonus = 0.25 -- +25% coins from selling per rebirth
Config.RebirthRequiresZone = "volcano"

-- Every completed Collection page (all regular finds of a zone) adds this much
-- to the coins you get, forever (rebirths keep the Collection)
Config.PageSellBonus = 0.05

-- Daily login reward: DailyRewardBase * streak day (streak capped at 7)
Config.DailyRewardBase = 100
Config.DailyStreakCap = 7

-- Trading Post
Config.MarketSeconds = 30 * 60 -- how often the "in demand" finds change
Config.StationRange = 25 -- how close you must be to the Trading Post / Charm Cart to use it

-- Set to true to try every game pass for free while testing in Roblox Studio.
-- Has no effect in the live game.
Config.TestPassesInStudio = false

-- How long each weather lasts, in seconds
Config.WeatherSeconds = 15 * 60

-- Treasure Rush: a big shared dig site that pops up in Dig Town now and then.
-- Everyone who helps dig it out gets a guaranteed good find.
Config.RushFirstSeconds = 5 * 60 -- after the server starts
Config.RushEverySeconds = 15 * 60
Config.RushSeconds = 4 * 60 -- how long the site stays before it sinks back
Config.RushDigs = 6 -- digs needed with one player in the server
Config.RushDigsPerPlayer = 2 -- extra digs needed for each other player in the server
Config.RushDigsMax = 24
Config.RushTeamSize = 3 -- with this many helpers everyone gets Epic or better instead of Rare or better
Config.RushReach = 12 -- the site is big, so it can be dug from further away

-- Dig buddies: digging near a Roblox friend gives both of you more coins
Config.BuddyRange = 20
Config.BuddyBonus = 0.1

function Config.RebirthCost(rebirths)
	return math.floor(Config.RebirthBaseCost * Config.RebirthCostGrowth ^ rebirths)
end

-- pages = completed Collection pages (Finds.CompletedPages)
function Config.SellMultiplier(rebirths, pages)
	return 1 + Config.RebirthSellBonus * rebirths + Config.PageSellBonus * (pages or 0)
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">CrownModel</string><ProtectedString name="Source"><![CDATA[-- Builds a real-looking crown out of parts: a gold band with a rim, tall and
-- short points with pearls, gems on the front, a red velvet cap and a little
-- cross on top. Used for the VIP crown and the Sunken King's Crown find.
--
-- CrownModel.AddTo(model, radius, options) adds the crown parts to a model and
-- returns the invisible center part ("Core" unless options.coreName says
-- otherwise). Every other part is welded to that center, so moving or welding
-- the center moves the whole crown. The crown stands upright along the
-- center's +Y, with the band centered on it.

local CrownModel = {}

local SEGMENTS = 8 -- sides of the band (each one gets a point)
local BASE_RADIUS = 0.55 -- the sizes below are for this radius and scale with it

local GEM_COLORS = {
	Color3.fromRGB(220, 30, 60), -- ruby
	Color3.fromRGB(40, 110, 255), -- sapphire
	Color3.fromRGB(30, 200, 110), -- emerald
	Color3.fromRGB(170, 60, 255), -- amethyst
}

local function newPart(className, model, name, size, color, material)
	local p = Instance.new(className)
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function attach(core, p, offset)
	p.CFrame = core.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = core
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- A flat triangle (two wedges) standing on its base. `at` is the middle of the
-- base, the triangle rises along at's +Y and its flat faces look along at's Z.
function CrownModel.Triangle(model, core, name, baseWidth, height, thickness, at, color, material)
	-- A WedgePart turned a quarter turn about Y is a right triangle in X/Y with
	-- its upright side on +X (or -X when turned the other way).
	local halves = {
		{ x = -baseWidth / 4, turn = CFrame.Angles(0, math.rad(90), 0) },
		{ x = baseWidth / 4, turn = CFrame.Angles(0, math.rad(-90), 0) },
	}
	local wedges = {}
	for _, half in ipairs(halves) do
		local wedge = newPart("WedgePart", model, name, Vector3.new(thickness, height, baseWidth / 2), color, material)
		attach(core, wedge, at * CFrame.new(half.x, height / 2, 0) * half.turn)
		table.insert(wedges, wedge)
	end
	return wedges
end

local function defaults(options)
	options = options or {}
	return {
		gold = options.color or Color3.fromRGB(255, 196, 45),
		material = options.material or Enum.Material.Metal,
		coreName = options.coreName or "Core",
		velvet = options.velvet ~= false,
	}
end

function CrownModel.AddTo(model, radius, options)
	local o = defaults(options)
	local k = radius / BASE_RADIUS
	local gold = o.gold
	local darkGold = gold:Lerp(Color3.new(0, 0, 0), 0.25)

	local core = newPart("Part", model, o.coreName, Vector3.one * 0.2 * k, gold, o.material)
	core.Transparency = 1

	local bandHeight = 0.42 * k
	local thickness = 0.1 * k
	local side = 2 * radius * math.tan(math.pi / SEGMENTS) -- width of one side of the band

	for i = 0, SEGMENTS - 1 do
		local around = CFrame.Angles(0, i * 2 * math.pi / SEGMENTS, 0)
		local tall = i % 2 == 0

		-- Band side and the thicker rim along its bottom edge
		attach(core, newPart("Part", model, "Band", Vector3.new(side * 1.04, bandHeight, thickness), gold, o.material), around * CFrame.new(0, 0, -radius))
		attach(
			core,
			newPart("Part", model, "Rim", Vector3.new(side * 1.12, bandHeight * 0.28, thickness * 1.8), darkGold, o.material),
			around * CFrame.new(0, -bandHeight * 0.42, -radius)
		)

		-- A point on top of every side: tall ones with a pearl, short ones with a bead
		local pointHeight = (tall and 0.62 or 0.32) * k
		local top = around * CFrame.new(0, bandHeight / 2, -radius)
		CrownModel.Triangle(model, core, "Point", side * 0.98, pointHeight, thickness * 0.9, top, gold, o.material)
		local pearlSize = (tall and 0.17 or 0.11) * k
		attach(
			core,
			newPart("Part", model, tall and "Pearl" or "Bead", Vector3.one * pearlSize, tall and Color3.fromRGB(250, 245, 235) or gold, tall and Enum.Material.SmoothPlastic or o.material),
			top * CFrame.new(0, pointHeight + pearlSize * 0.25, 0)
		).Shape = Enum.PartType.Ball

		-- A gem on the band below each tall point
		if tall then
			local gem = newPart("Part", model, "Gem", Vector3.new(0.17, 0.17, 0.08) * k, GEM_COLORS[(i / 2) % #GEM_COLORS + 1], Enum.Material.Neon)
			attach(core, gem, around * CFrame.new(0, bandHeight * 0.05, -radius - thickness * 0.55) * CFrame.Angles(0, 0, math.rad(45)))
		end
	end

	if o.velvet then
		-- Red velvet cap filling the band, with a gold orb and cross on top
		local capHeight = bandHeight * 1.9
		local cap = newPart("Part", model, "Velvet", Vector3.new(radius * 1.9, capHeight, radius * 1.9), Color3.fromRGB(150, 20, 45), Enum.Material.Fabric)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = cap
		attach(core, cap, CFrame.new(0, bandHeight * 0.05, 0))
		local orbY = bandHeight * 0.05 + capHeight / 2 + 0.06 * k
		local orb = newPart("Part", model, "Orb", Vector3.one * 0.18 * k, gold, o.material)
		orb.Shape = Enum.PartType.Ball
		attach(core, orb, CFrame.new(0, orbY, 0))
		attach(core, newPart("Part", model, "Cross", Vector3.new(0.06, 0.26, 0.06) * k, gold, o.material), CFrame.new(0, orbY + 0.2 * k, 0))
		attach(core, newPart("Part", model, "Cross", Vector3.new(0.18, 0.06, 0.06) * k, gold, o.material), CFrame.new(0, orbY + 0.24 * k, 0))
	end

	return core
end

return CrownModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Dig</string><ProtectedString name="Source"><![CDATA[-- The dig minigame, shared by server and player so both agree on the rules.
--
-- A marker slides back and forth along a bar. Tap while it is inside the green
-- sweet spot to dig deeper; the gold middle is a "perfect" hit. After every hit
-- the sweet spot moves. Tapping outside it cracks the find, and too many cracks
-- break it. Perfect hits make the find worth more.

local Dig = {}

Dig.MaxCracks = 3
Dig.PerfectShare = 0.35 -- the gold middle, as a share of the sweet spot
Dig.PerfectBonus = 0.3 -- all perfect hits = +30% value
Dig.MinTapGap = 0.2 -- seconds; nobody can dig out a find faster than this per strike
Dig.MaxSeconds = 60

function Dig.Params(rarity, shovel)
	local power = shovel and shovel.power or 0
	local zone = math.min(0.6, rarity.zone * (1 + power))
	return {
		rarity = rarity.id,
		strikes = rarity.strikes,
		zone = zone,
		perfect = zone * Dig.PerfectShare,
		speed = rarity.speed,
		cracks = Dig.MaxCracks,
	}
end

-- The quickest anyone could possibly finish this dig
function Dig.MinSeconds(params)
	return params.strikes * Dig.MinTapGap
end

-- Where the marker is (0 to 1) after t seconds
function Dig.MarkerAt(t, speed)
	local x = (t * speed) % 2
	if x > 1 then
		return 2 - x
	end
	return x
end

-- A new middle for the sweet spot, keeping it inside the bar
function Dig.NextCenter(random, params)
	local half = params.zone / 2
	return random:NextNumber(half, 1 - half)
end

-- "perfect", "hit" or "miss" for a tap with the marker at this spot
function Dig.Judge(marker, center, params)
	local distance = math.abs(marker - center)
	if distance <= params.perfect / 2 then
		return "perfect"
	elseif distance <= params.zone / 2 then
		return "hit"
	end
	return "miss"
end

function Dig.ValueMultiplier(perfects, strikes)
	return 1 + Dig.PerfectBonus * math.clamp(perfects / math.max(1, strikes), 0, 1)
end

return Dig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[-- Weekly legendary finds and rotating weather. Both are worked out from the
-- clock, so every server (and every player's screen) agrees without talking.

local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Config)
local Finds = require(script.Parent.Finds)

local Events = {}

local WEEK = 7 * 24 * 60 * 60
local MONDAY_OFFSET = 4 * 24 * 60 * 60 -- 1 Jan 1970 was a Thursday; weeks start Monday 00:00 UTC

-- Weather is free for everyone and only gives small, temporary boosts.
Events.Weathers = {
	{ id = "Clear", name = "Clear Skies", description = "A calm day for digging." },
	{ id = "Rain", name = "Rain", description = "Soft ground: dig down 20% faster.", digMultiplier = 0.8 },
	{ id = "Fog", name = "Fog", description = "Rare and better finds are 20% more likely.", luckMultiplier = 1.2 },
	{ id = "Storm", name = "Storm", description = "Legendary finds are twice as likely.", legendaryMultiplier = 2 },
	{ id = "GoldenHour", name = "Golden Hour", description = "Shiny finds are twice as likely.", shinyMultiplier = 2 },
}

function Events.Now()
	return Workspace:GetServerTimeNow()
end

function Events.GetWeek(now)
	now = now or Events.Now()
	local week = math.floor((now - MONDAY_OFFSET) / WEEK)
	local secondsLeft = WEEK - ((now - MONDAY_OFFSET) % WEEK)
	return week, secondsLeft
end

-- The legendary find featured this week.
function Events.GetEventFind(now)
	local week, secondsLeft = Events.GetWeek(now)
	local find = Finds.EventFinds[(week % #Finds.EventFinds) + 1]
	return find, secondsLeft
end

function Events.GetWeather(now)
	now = now or Events.Now()
	local slot = math.floor(now / Config.WeatherSeconds)
	local secondsLeft = Config.WeatherSeconds - (now % Config.WeatherSeconds)
	-- Clear weather half the time, a random special weather otherwise
	local roll = Random.new(slot):NextInteger(1, (#Events.Weathers - 1) * 2)
	local weather = Events.Weathers[1]
	if roll < #Events.Weathers then
		weather = Events.Weathers[roll + 1]
	end
	return weather, secondsLeft
end

return Events
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">FindModel</string><ProtectedString name="Source"><![CDATA[-- Builds a simple 3D find out of parts. Used when a player holds up what they
-- dug up.

local Finds = require(script.Parent.Finds)
local CrownModel = require(script.Parent.CrownModel)

local FindModel = {}

-- Each find gets its own color from its id (unless it sets one), tinted by rarity
local function colorFor(find)
	if find.color then
		return find.color
	end
	local hash = 0
	for i = 1, #find.id do
		hash = (hash * 31 + string.byte(find.id, i)) % 360
	end
	local base = Color3.fromHSV(hash / 360, 0.55, 0.95)
	local rarity = Finds.RarityById[find.rarity]
	return base:Lerp(rarity.color, 0.35)
end
FindModel.ColorFor = colorFor

-- Size in studs for a find of this weight (kg)
function FindModel.SizeFor(weight)
	return math.clamp(1 + math.log(weight + 1) * 0.8, 1, 4)
end

local function piece(model, name, size, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

-- Adds a part placed relative to the body and welds it on
local function extra(model, body, name, size, offset, color, material, shape)
	local p = piece(model, name, size, color, material, shape)
	p.CFrame = body.CFrame * offset
	weld(body, p)
	return p
end

local BUILDERS = {}

function BUILDERS.coin(model, s, color, material)
	return piece(model, "Body", Vector3.new(s * 0.15, s * 0.8, s * 0.8), color, material, Enum.PartType.Cylinder)
end

function BUILDERS.ring(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s * 0.12, s * 0.7, s * 0.7), color, material, Enum.PartType.Cylinder)
	extra(model, body, "Gem", Vector3.one * s * 0.25, CFrame.new(0, s * 0.38, 0), Color3.fromRGB(120, 200, 255), Enum.Material.Neon, Enum.PartType.Ball)
	return body
end

function BUILDERS.crown(model, s, color, material)
	return CrownModel.AddTo(model, s * 0.42, { color = color, material = material == Enum.Material.Neon and material or Enum.Material.Metal, coreName = "Body" })
end

function BUILDERS.orb(model, s, color, material)
	return piece(model, "Body", Vector3.one * s * 0.8, color, material, Enum.PartType.Ball)
end

function BUILDERS.egg(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s * 0.7, s, s * 0.7), color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	return body
end

function BUILDERS.shell(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s * 0.9, s * 0.35, s * 0.7), color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	for i = -1, 1 do
		extra(model, body, "Ridge", Vector3.new(s * 0.08, s * 0.3, s * 0.72), CFrame.new(i * s * 0.22, s * 0.04, 0), color:Lerp(Color3.new(0, 0, 0), 0.2), material)
	end
	return body
end

function BUILDERS.gem(model, s, color)
	local body = piece(model, "Body", Vector3.one * s * 0.55, color, Enum.Material.Glass)
	body.Transparency = 0.15
	body.CFrame = CFrame.Angles(math.rad(45), 0, math.rad(45))
	extra(model, body, "Glow", Vector3.one * s * 0.3, CFrame.new(), color:Lerp(Color3.new(1, 1, 1), 0.4), Enum.Material.Neon)
	return body
end

function BUILDERS.bone(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s, s * 0.2, s * 0.2), color, material, Enum.PartType.Cylinder)
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -1, 1 }) do
			extra(model, body, "Knob", Vector3.one * s * 0.24, CFrame.new(side * s * 0.5, 0, z * s * 0.1), color, material, Enum.PartType.Ball)
		end
	end
	return body
end

function BUILDERS.tooth(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s * 0.35, s * 0.5, s * 0.35), color, material)
	local tip = Instance.new("WedgePart")
	tip.Name = "Tip"
	tip.Size = Vector3.new(s * 0.35, s * 0.5, s * 0.35)
	tip.Color = color
	tip.Material = material
	tip.CanCollide = false
	tip.CanQuery = false
	tip.CanTouch = false
	tip.Massless = true
	tip.CastShadow = false
	tip.CFrame = body.CFrame * CFrame.new(0, s * 0.5, 0)
	tip.Parent = model
	weld(body, tip)
	return body
end

function BUILDERS.relic(model, s, color, material)
	local body = piece(model, "Body", Vector3.new(s * 0.9, s * 0.6, s * 0.6), color, material)
	extra(model, body, "Band", Vector3.new(s * 0.94, s * 0.12, s * 0.64), CFrame.new(0, s * 0.1, 0), color:Lerp(Color3.fromRGB(255, 210, 80), 0.6), Enum.Material.Metal)
	return body
end

-- Returns a Model whose PrimaryPart is "Body"
function FindModel.Build(findId, weight, shiny)
	local find = Finds.ById[findId]
	if not find then
		return nil
	end
	local size = FindModel.SizeFor(weight or 1)
	local color = colorFor(find)
	local material = shiny and Enum.Material.Neon or Enum.Material.SmoothPlastic

	local model = Instance.new("Model")
	model.Name = "Find_" .. find.id
	local build = BUILDERS[find.shape] or BUILDERS.relic
	local body = build(model, size, color, material)
	model.PrimaryPart = body

	if shiny then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 240, 150)
		sparkles.Parent = body
	end
	return model
end

return FindModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Finds</string><ProtectedString name="Source"><![CDATA[-- Everything you can dig up. To add a find, copy a line and give it a new unique id.
-- value = coins for an average-weight find. weight = {min, max} in kg.
-- shape = how it looks when held up (see FindModel): coin, gem, bone, egg, relic, orb, ring, tooth, shell
-- color = optional, otherwise one is picked from the id

local Finds = {}

-- strikes: good hits needed to dig it out
-- zone: how wide the green sweet spot is (share of the bar)
-- speed: how fast the marker moves (bar widths per second)
Finds.Rarities = {
	{ id = "Common", weight = 60, color = Color3.fromRGB(200, 200, 200), strikes = 3, zone = 0.28, speed = 0.85 },
